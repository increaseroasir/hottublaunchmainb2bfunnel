---
import { funnel } from '../data/funnel';
import AttributionFields from './AttributionFields.astro';
import { CONSENT_TEXT } from '../data/consent';

interface Props {
  id?: string;
}

const { id = 'ticket' } = Astro.props;
const { ticket } = funnel;
const showError = Astro.url.searchParams.get('error') === '1';
---

<form class="lead-form" id={id} action="/api/lead" method="POST" novalidate>
  {showError && <p class="form-error">{ticket.errors.generic}</p>}

  <!-- Hidden tracking fields — server-rendered from attribution cookies (Lane B2) -->
  <AttributionFields />
  <input type="hidden" name="quizAnswers" value="" />

  <label class="input-shell" for={`${id}-name`}>
    <span class="prefix" aria-hidden="true">{ticket.fields.name.emoji}</span>
    <input
      id={`${id}-name`}
      name="first_name"
      type="text"
      required
      autocomplete={ticket.fields.name.autocomplete}
      placeholder={ticket.fields.name.placeholder}
    />
  </label>
  <span class="field-error" data-error-for="first_name"></span>

  <label class="input-shell" for={`${id}-lastName`}>
    <span class="prefix" aria-hidden="true">{ticket.fields.lastName.emoji}</span>
    <input
      id={`${id}-lastName`}
      name="last_name"
      type="text"
      autocomplete={ticket.fields.lastName.autocomplete}
      placeholder={ticket.fields.lastName.placeholder}
    />
  </label>

  <label class="input-shell" for={`${id}-email`}>
    <span class="prefix" aria-hidden="true">{ticket.fields.email.emoji}</span>
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      required
      autocomplete={ticket.fields.email.autocomplete}
      placeholder={ticket.fields.email.placeholder}
    />
  </label>
  <span class="field-error" data-error-for="email"></span>

  <label class="input-shell" for={`${id}-phone`}>
    <span class="prefix" aria-hidden="true">{ticket.fields.phone.emoji}</span>
    <input
      id={`${id}-phone`}
      name="phone"
      type="tel"
      autocomplete={ticket.fields.phone.autocomplete}
      placeholder={ticket.fields.phone.placeholder}
    />
  </label>

  <!-- Consent — label text IS the stored consent record (B8/C10); edit src/data/consent.ts, not here -->
  <label class="lead-form-consent" style="display:flex;gap:.6rem;align-items:flex-start;cursor:pointer;font-size:.72rem;line-height:1.5;margin:.8rem 0 1rem">
    <input type="checkbox" name="terms" required style="margin-top:.2em;accent-color:#CE1126;flex:none;width:16px;height:16px" />
    <span>{CONSENT_TEXT}</span>
  </label>

  <button class="btn-pill btn-wide btn-stack" type="submit" data-submit>
    <span>{ticket.submit}</span>
    <small>{ticket.submitWhen}</small>
  </button>
</form>

<!-- Capture/submit plumbing lives in src/lib/lead-client.ts (Lane B shared util).
     This block is validation only. Hoisted once, wires every .lead-form on the page. -->
<script>
  import { wireLeadForm } from '../lib/lead-client';

  document.querySelectorAll('form.lead-form').forEach((formNode) => {
    if (!(formNode instanceof HTMLFormElement)) return;
    const form = formNode;

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function value(name: string): string {
      const input = form.elements.namedItem(name) as { value?: string } | null;
      return input && typeof input.value === 'string' ? input.value.trim() : '';
    }

    function setError(name: string, message: string) {
      const input = form.elements.namedItem(name);
      const slot = form.querySelector('[data-error-for="' + name + '"]');
      if (input instanceof HTMLInputElement) {
        input.setAttribute('aria-invalid', message ? 'true' : 'false');
      }
      if (slot) slot.textContent = message;
    }

    function validate(): boolean {
      const name = value('first_name');
      const email = value('email');
      const termsEl = form.elements.namedItem('terms');
      const terms = termsEl instanceof HTMLInputElement ? termsEl.checked : false;
      const next = {
        name: name.length >= 2 ? '' : 'Enter your first name.',
        email: emailRe.test(email) ? '' : 'Enter a valid business email.',
      };
      setError('first_name', next.name);
      setError('email', next.email);
      return !next.name && !next.email && terms;
    }

    wireLeadForm({ form, validate });
  });
</script>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Free Case Study: 49 Hot Tub & Swim Spa Leads in 11 Days — Hot Tub Launch"
  description="The exact website changes that turned a quiet store site into a lead machine — 49 qualified hot tub and swim spa leads in 11 days, with no new ad spend."
>
  <meta name="robots" content="index, follow" />

  <style is:global>
  :root{
    --white:#FFFFFF; --paper:#FAF9F6; --block:#E4DFDB; --ink:#0E0C0B; --ink-2:#161311;
    --gray:#403B36; --muted:#857E76;
    --red:#CE1126; --red-2:#E23A4C; --red-dark:#A80E1F; --line:#E7E1D8; --wrap:820px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--paper);color:var(--gray);font-family:'Manrope',system-ui,sans-serif;font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  h1,h2{font-family:'Montserrat',sans-serif;text-transform:uppercase;line-height:1.06;font-weight:900;letter-spacing:-.01em}
  .red{color:var(--red)}
  .wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:1.2rem}
  .btn{display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;cursor:pointer;
    font-family:'Montserrat';font-weight:900;font-size:1.06rem;letter-spacing:.03em;text-transform:uppercase;
    padding:1.15em 1.4em;border-radius:7px;border:0;background:var(--red);color:#fff;transition:.15s;box-shadow:0 12px 26px rgba(206,17,38,.32)}
  .btn:hover{background:var(--red-dark);transform:translateY(-2px)}

  /* trust bar */
  .trustbar{text-align:center;padding:1.5rem 0 .4rem}
  .stars{color:var(--red);font-size:1.1rem;letter-spacing:2px}
  .avis{display:inline-flex;vertical-align:middle;margin-right:.5rem}
  .avis span{width:26px;height:26px;border-radius:50%;border:2px solid var(--paper);margin-left:-8px;background:linear-gradient(150deg,#c9c1b6,#8a827a);display:inline-block}
  .avis span:first-child{margin-left:0}
  .trusttext{font-family:'Montserrat';font-weight:800;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--gray);margin-top:.5rem}

  /* intro */
  .intro{text-align:center;padding:.4rem 0 1.4rem}
  .intro h1{color:var(--ink);font-size:clamp(1.7rem,4.8vw,2.5rem);margin-bottom:.9rem}
  .intro .sub{font-style:italic;font-weight:600;font-size:1.02rem;color:var(--gray);max-width:54ch;margin:0 auto}

  /* if this sounds like you */
  .sounds{padding:.6rem 0 1.2rem}
  .sounds h3{font-family:'Montserrat';font-weight:800;font-size:1.1rem;color:var(--ink);margin-bottom:1rem}
  .clist{list-style:none;display:flex;flex-direction:column;gap:.7rem;margin-bottom:1.1rem}
  .clist li{display:flex;gap:.7rem;align-items:flex-start;font-size:1.05rem;color:var(--gray)}
  .clist li svg{flex:none;margin-top:.2em}
  .sounds .kick{font-size:1.08rem;color:var(--ink);font-weight:600}

  /* ===== BLOCK: results card + form (one continuous grey block) ===== */
  .mock-sec{padding:2.4rem 0 1.4rem;display:flex;justify-content:center;background:var(--block);border-top:1px solid var(--line)}
  .result-card{width:100%;max-width:460px;background:var(--ink);border-radius:18px;padding:clamp(1.8rem,4vw,2.4rem);color:#fff;box-shadow:0 30px 60px rgba(20,15,10,.28);position:relative;overflow:hidden}
  .result-card::before{content:"";position:absolute;top:-40%;right:-20%;width:70%;height:80%;background:radial-gradient(circle,rgba(206,17,38,.22),transparent 70%)}
  .rc-eye{position:relative;display:flex;align-items:center;gap:.5rem;font-family:'Montserrat';font-weight:800;font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--red-2)}
  .rc-eye i{width:15px;height:2px;background:var(--red-2)}
  .rc-big{position:relative;display:flex;align-items:flex-end;gap:.8rem;margin-top:1.1rem}
  .rc-num{font-family:'Montserrat';font-weight:900;font-size:clamp(4rem,16vw,5.6rem);line-height:.8;color:#fff;letter-spacing:-.03em}
  .rc-lbl{font-family:'Montserrat';font-weight:800;font-size:.92rem;text-transform:uppercase;line-height:1.1;color:#E4DDD3;padding-bottom:.55rem;letter-spacing:.01em}
  .rc-days{position:relative;font-family:'Montserrat';font-weight:800;font-size:1.15rem;text-transform:uppercase;color:#fff;margin-top:.3rem;letter-spacing:.02em}
  .rc-days b{color:var(--red-2)}
  .rc-chart{position:relative;width:100%;height:auto;margin:1.3rem 0 .6rem;display:block}
  .rc-foot{position:relative;display:flex;align-items:center;justify-content:space-between;padding-top:1.1rem;border-top:1px solid rgba(255,255,255,.12);font-family:'Montserrat';font-weight:800;font-size:.72rem;letter-spacing:.05em;text-transform:uppercase}
  .rc-foot .zero{color:#fff}.rc-foot .zero b{color:var(--red-2)}
  .rc-foot .rc-by{color:var(--muted)}.rc-foot .rc-by b{color:#fff}

  .formband{background:var(--block);padding:1.6rem 0 2.2rem;border-bottom:1px solid var(--line)}
  .form-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:clamp(1.4rem,4vw,2rem);max-width:520px;margin:0 auto;box-shadow:0 16px 40px rgba(20,15,10,.06)}
  .form-card .ft{text-align:center;font-family:'Montserrat';font-weight:900;font-size:1.15rem;text-transform:uppercase;color:var(--ink);margin-bottom:1.3rem;letter-spacing:-.01em}

  /* form styles */
  .form-card .field-group{margin-bottom:1rem}
  .form-card label.input-label{display:block;font-family:'Montserrat';font-weight:700;font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink);margin-bottom:.3rem}
  .form-card input[type="text"],
  .form-card input[type="email"],
  .form-card input[type="tel"]{width:100%;padding:.85em 1em;border:1px solid var(--line);border-radius:6px;font-family:'Manrope',system-ui,sans-serif;font-size:1rem;color:var(--ink);background:var(--paper);transition:border-color .15s;-webkit-appearance:none}
  .form-card input:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(206,17,38,.1)}
  .form-card input[aria-invalid="true"]{border-color:var(--red)}
  .field-error{display:block;font-size:.82rem;color:var(--red);margin-top:.3rem;min-height:1.2em}
  .form-card .btn{margin-top:.6rem}
  .form-card .footnote{text-align:center;font-size:.75rem;color:var(--muted);margin-top:1rem}

  /* content sections */
  .sec{padding:clamp(2.2rem,5vw,3.4rem) 0}
  .sec--band{background:var(--block);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .sec h2{text-align:center;font-size:clamp(1.5rem,3.6vw,2.1rem);margin-bottom:.8rem}
  .sec .cen{text-align:center;color:var(--gray);max-width:52ch;margin:0 auto 1.4rem;font-size:1.05rem}
  .blocktitle{font-family:'Montserrat';font-weight:800;font-size:1.08rem;color:var(--ink);margin:1.4rem 0 .9rem}
  .bucket{display:flex;justify-content:center;margin:1.6rem 0}

  /* authenticity */
  .auth p{margin-bottom:1rem;font-size:1.06rem;color:var(--gray)}
  .auth .sig{margin-top:1.4rem}
  .auth .sig b{display:block;font-family:'Montserrat';font-weight:800;color:var(--ink);text-transform:uppercase;letter-spacing:.02em;font-size:.95rem}
  .auth .sig span{font-size:.9rem;color:var(--muted)}
  .final-cta{max-width:520px;margin:1.8rem auto 0}

  /* footer */
  footer{background:var(--ink);color:#fff;padding:2.6rem 0 2.8rem;text-align:center}
  .logo{display:inline-flex;align-items:center;gap:.6rem}
  .logo .mk{width:36px;height:36px}
  .logo .w1{font-family:'Montserrat';font-weight:800;font-size:1.15rem;letter-spacing:.02em;text-transform:uppercase;color:#fff;line-height:.85;display:block}
  .logo .w2{font-family:'Montserrat';font-weight:700;font-size:.72rem;letter-spacing:.42em;color:var(--red);text-transform:uppercase;display:block;margin-top:2px}
  .foot-legal{color:rgba(255,255,255,.42);font-size:.74rem;max-width:64ch;margin:1.4rem auto 0;line-height:1.65}

  @media (max-width:480px){.rc-num{font-size:4.4rem}}
  </style>

  <!-- TRUST BAR -->
  <div class="trustbar">
    <div class="wrap">
      <div class="stars">★★★★★</div>
      <div class="trusttext"><span class="avis"><span></span><span></span><span></span><span></span></span>Trusted by 200+ hot tub store owners</div>
    </div>
  </div>

  <!-- INTRO -->
  <section class="intro">
    <div class="wrap">
      <h1>Free Case Study: How one hot tub store got <span class="red">49 hot tub &amp; swim spa leads in 11 days</span></h1>
      <p class="sub">The exact website changes that turned a quiet store site into a lead machine — 49 qualified hot tub and swim spa leads in 11 days, with no new ad spend.</p>
    </div>
  </section>

  <!-- IF THIS SOUNDS LIKE YOU -->
  <section class="sounds">
    <div class="wrap">
      <h3>If this sounds like you:</h3>
      <ul class="clist">
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>You get traffic to your website, but it's not turning into calls or showroom visits</li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>You've never known how many ready buyers hit your site and left without a trace</li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>You're paying for clicks that leak out of a site that doesn't convert</li>
      </ul>
      <p class="kick">…then this is the exact playbook we used — and you can copy it.</p>
    </div>
  </section>

  <!-- RESULTS CARD -->
  <section class="mock-sec">
    <div class="result-card">
      <div class="rc-eye"><i></i>Hot Tub Website Case Study</div>
      <div class="rc-big"><span class="rc-num">49</span><span class="rc-lbl">Hot tub &amp; swim spa<br>leads captured</span></div>
      <div class="rc-days">in just <b>11 days</b></div>
      <svg class="rc-chart" viewBox="0 0 320 100" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="rcg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#CE1126" stop-opacity=".38"/><stop offset="1" stop-color="#CE1126" stop-opacity="0"/></linearGradient></defs>
        <path d="M0 90 L32 84 L64 79 L96 70 L128 63 L160 54 L192 44 L224 34 L256 25 L288 15 L320 6 L320 100 L0 100 Z" fill="url(#rcg)"/>
        <polyline points="0,90 32,84 64,79 96,70 128,63 160,54 192,44 224,34 256,25 288,15 320,6" fill="none" stroke="#E23A4C" stroke-width="2.6" stroke-linejoin="round"/>
        <circle cx="320" cy="6" r="4.5" fill="#E23A4C"/>
      </svg>
      <div class="rc-foot"><span class="zero"><b>$0</b> extra ad spend</span><span class="rc-by">By <b>Hot Tub Launch</b></span></div>
    </div>
  </section>

  <!-- FORM -->
  <section class="formband">
    <div class="wrap">
      <div class="form-card" id="optin">
        <div class="ft">Send me the case study</div>
        <form id="case-study-form" action="/api/lead" method="POST" novalidate>
          <input type="hidden" name="leadUuid" id="leadUuid" value="" />
          <input type="hidden" name="eventId" id="eventId" value="" />
          <input type="hidden" name="fbp" id="fbp" value="" />
          <input type="hidden" name="fbc" id="fbc" value="" />
          <input type="hidden" name="fbclid" id="fbclid" value="" />
          <input type="hidden" name="utmSource" id="utmSource" value="" />
          <input type="hidden" name="utmMedium" id="utmMedium" value="" />
          <input type="hidden" name="utmCampaign" id="utmCampaign" value="" />
          <input type="hidden" name="utmContent" id="utmContent" value="" />
          <input type="hidden" name="utmTerm" id="utmTerm" value="" />
          <input type="hidden" name="landingUrl" id="landingUrl" value="" />

          <div class="field-group">
            <label class="input-label" for="cs-name">First name</label>
            <input id="cs-name" name="name" type="text" required autocomplete="given-name" placeholder="Your first name" />
            <span class="field-error" data-error-for="name"></span>
          </div>

          <div class="field-group">
            <label class="input-label" for="cs-lastName">Last name</label>
            <input id="cs-lastName" name="lastName" type="text" autocomplete="family-name" placeholder="Your last name" />
          </div>

          <div class="field-group">
            <label class="input-label" for="cs-email">Business email</label>
            <input id="cs-email" name="email" type="email" required autocomplete="email" placeholder="your@email.com" />
            <span class="field-error" data-error-for="email"></span>
          </div>

          <div class="field-group">
            <label class="input-label" for="cs-phone">Phone number</label>
            <input id="cs-phone" name="phone" type="tel" autocomplete="tel" placeholder="(979) 459-9221" />
          </div>

          <button class="btn" type="submit" data-submit>Send Me the Case Study</button>
          <p class="footnote">Free · No spam · Unsubscribe anytime</p>
        </form>
      </div>
    </div>
  </section>

  <!-- REFRAME + WHAT'S INSIDE -->
  <section class="sec">
    <div class="wrap">
      <h2>Most hot tub stores think they need <span class="red">more traffic</span></h2>
      <p class="cen">This case study proves otherwise. The store didn't add a single dollar of ad spend.</p>
      <div class="bucket">
        <svg width="150" height="150" viewBox="0 0 150 150" fill="none">
          <path d="M38 52h74l-8 68a6 6 0 0 1-6 5H52a6 6 0 0 1-6-5L38 52z" stroke="#0E0C0B" stroke-width="3"/>
          <path d="M32 52h86" stroke="#0E0C0B" stroke-width="3" stroke-linecap="round"/>
          <path d="M48 52c0-8 12-14 27-14s27 6 27 14" stroke="#0E0C0B" stroke-width="3"/>
          <circle cx="66" cy="86" r="4" fill="#CE1126"/><circle cx="88" cy="98" r="4" fill="#CE1126"/><circle cx="75" cy="110" r="3.5" fill="#CE1126"/>
          <path d="M66 96v14M88 108v12M75 120v10" stroke="#CE1126" stroke-width="3" stroke-linecap="round"/>
          <path d="M60 30c0 4-4 4-4 8M75 24c0 5-5 5-5 10M90 30c0 4-4 4-4 8" stroke="#CE1126" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="cen" style="margin-bottom:0">Your store is a bucket. Every buyer in your market is water being poured in — but the bucket has holes. This store already had the traffic. We just sealed the leaks — and 49 leads came out in 11 days.</p>

      <div class="blocktitle">Inside the case study, you'll see:</div>
      <ul class="clist">
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>The 3 website changes that drove the biggest jump in leads</li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Exactly where buyers were dropping off before — and how we plugged each leak</li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>The full 11-day timeline, step by step, so you can copy it on your own site</li>
      </ul>

      <div class="blocktitle">Plus the full before-and-after breakdown:</div>
      <ul class="clist">
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>The real numbers — traffic, leads, and conversion rate, before vs after</li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>The page layout that turned browsers into booked appointments</li>
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>How to spot the same leaks that could be costing you buyers right now</li>
      </ul>
    </div>
  </section>

  <!-- AUTHENTICITY -->
  <section class="sec sec--band">
    <div class="wrap auth">
      <h2 style="text-align:left">This isn't a hypothetical or a <span class="red">stock case study</span></h2>
      <p>It's one real hot tub store, real numbers, and a real 11-day window. I'll walk you through exactly what we changed — so you can see whether the same leaks are quietly costing you buyers today.</p>
      <p>You get the full breakdown. And you can unsubscribe from the list at any time.</p>
      <p>If that sounds like a fair trade, drop your info and I'll send it straight to you.</p>
      <div class="sig">
        <b>Hot Tub Launch</b>
        <span>Founder · Hot Tub Launch</span>
      </div>
      <div class="final-cta"><a class="btn" href="#optin">Send Me the Case Study</a></div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="wrap">
      <a class="logo" href="/">
        <svg class="mk" viewBox="0 0 48 48" fill="none"><ellipse cx="24" cy="37" rx="17" ry="3.4" stroke="#FAF7F2" stroke-width="1.6"/><ellipse cx="24" cy="37" rx="10.5" ry="2" stroke="#FAF7F2" stroke-width="1.4" opacity=".5"/><circle cx="24" cy="21" r="13" stroke="#FAF7F2" stroke-width="1.8"/><path d="M20 34 C18 24 22 15 31 8 C27 17 27 26 28 34 Z" fill="#CE1126"/></svg>
        <span><span class="w1">Hot Tub</span><span class="w2">Launch</span></span>
      </a>
      <p class="foot-legal">This website is not endorsed by or affiliated with Facebook, Google, or YouTube in any way. Individual results presented here reflect one store's experience and may not be typical. Your background, effort, and execution affect outcomes, and nothing here is a guarantee of any specific result. © 2026 Hot Tub Launch. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
  (function () {
    var form = document.getElementById('case-study-form');
    if (!(form instanceof HTMLFormElement)) return;

    var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function value(name) {
      var input = form.elements.namedItem(name);
      return input instanceof HTMLInputElement ? input.value.trim() : '';
    }

    function setError(name, message) {
      var input = form.elements.namedItem(name);
      var slot = form.querySelector('[data-error-for="' + name + '"]');
      if (input instanceof HTMLInputElement) {
        input.setAttribute('aria-invalid', message ? 'true' : 'false');
      }
      if (slot) slot.textContent = message;
    }

    function validate() {
      var nameVal = value('name');
      var emailVal = value('email');
      var next = {
        name: nameVal.length >= 2 ? '' : 'Enter your first name.',
        email: emailRe.test(emailVal) ? '' : 'Enter a valid business email.',
      };
      setError('name', next.name);
      setError('email', next.email);
      return !next.name && !next.email;
    }

    // Capture tracking params from URL and cookies
    function captureTracking() {
      var params = new URLSearchParams(window.location.search);

      function getHidden(id) {
        var el = document.getElementById(id);
        return el instanceof HTMLInputElement ? el : null;
      }

      // leadUuid + eventId
      var lu = params.get('leadUuid') || sessionStorage.getItem('lead_uuid') || '';
      var ei = params.get('eventId') || sessionStorage.getItem('event_id') || '';
      if (!lu) {
        lu = crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) { var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8); return v.toString(16); });
        sessionStorage.setItem('lead_uuid', lu);
      }
      if (!ei) {
        ei = crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) { var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8); return v.toString(16); });
        sessionStorage.setItem('event_id', ei);
      }

      var hlu = getHidden('leadUuid'); if (hlu) hlu.value = lu;
      var hei = getHidden('eventId'); if (hei) hei.value = ei;

      // UTMs
      var utmFields = ['utmSource','utmMedium','utmCampaign','utmContent','utmTerm'];
      utmFields.forEach(function (f) {
        var stored = sessionStorage.getItem(f);
        var fromUrl = params.get(f);
        var val = fromUrl || stored || '';
        if (fromUrl) sessionStorage.setItem(f, fromUrl);
        var h = getHidden(f); if (h) h.value = val;
      });

      // fbclid
      var fbclid = params.get('fbclid') || '';
      var hfbclid = getHidden('fbclid'); if (hfbclid) hfbclid.value = fbclid;

      // fbp / fbc from Meta cookies
      var fbp = '';
      var fbc = '';
      document.cookie.split('; ').forEach(function (c) {
        if (c.startsWith('_fbp=')) fbp = c.slice(5);
        if (c.startsWith('_fbc=')) fbc = c.slice(5);
      });
      var hfbp = getHidden('fbp'); if (hfbp) hfbp.value = fbp;
      var hfbc = getHidden('fbc'); if (hfbc) hfbc.value = fbc || (fbclid ? 'fb.1.' + Math.floor(Date.now() / 1000) + '.' + fbclid : '');

      // landing url
      var landing = sessionStorage.getItem('landing_url') || window.location.href.split('?')[0];
      if (!sessionStorage.getItem('landing_url')) sessionStorage.setItem('landing_url', landing);
      var hl = getHidden('landingUrl'); if (hl) hl.value = landing;
    }

    // Run tracking capture on page load
    captureTracking();

    form.addEventListener('submit', function (event) {
      if (!validate()) {
        event.preventDefault();
        return;
      }
      // Fire Pixel Lead event with matching event_id
      var eid = (document.getElementById('eventId') instanceof HTMLInputElement)
        ? document.getElementById('eventId').value : '';
      if (typeof fbq === 'function' && eid) {
        fbq('track', 'Lead', {}, {eventID: eid});
      }
      try {
        sessionStorage.setItem('lead_name', value('name'));
        sessionStorage.setItem('lead_email', value('email'));
      } catch (err) {}
      var button = form.querySelector('[data-submit]');
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
      }
    });
  })();
  </script>
</Layout>

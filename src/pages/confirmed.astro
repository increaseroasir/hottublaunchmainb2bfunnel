---
import Layout from '../layouts/Layout.astro';
const title = 'Application Received — Hot Tub Launch';
---

<Layout title={title}>
  <main class="confirmed-page">
    <div class="container">
      <h1>Application received.</h1>
      <p>We review every application by hand. If your market is open, you'll hear from us within two business days.</p>
      <p class="note">No confirmation email. No tracking. We reply personally.</p>
    </div>
  </main>
</Layout>

<style is:global>
  .confirmed-page { display: flex; align-items: center; justify-content: center; min-height: 60vh; }
  .confirmed-page .container { max-width: 540px; text-align: center; }
  .confirmed-page h1 { font-size: 2rem; margin-bottom: 1rem; }
  .confirmed-page p { color: var(--text-muted, #666); line-height: 1.6; }
  .confirmed-page .note { font-size: 0.9rem; margin-top: 2rem; color: var(--text-subtle, #999); }
</style>

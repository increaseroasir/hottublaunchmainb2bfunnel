/* The chat bubble keeps the behaviour the old .concierge widget had: it stays
   out of the way until the visitor has scrolled past the hero, so it never
   covers the hero CTA on a phone. Deliberately low specificity — the <=820px
   dashboard-avoidance rule above still outranks it whenever it applies. */
.ai-chat{opacity:0;transform:translateY(14px) scale(.96);pointer-events:none;
  transition:opacity .4s var(--e-out),transform .45s var(--e-spring)}
.ai-chat.is-ready{opacity:1;transform:none;pointer-events:auto}

/* The docked feed is fixed, so the last lines of the footer — including the
   privacy link — would sit underneath it. --ai-dash-h is published by the seam
   script at the end of the page and tracks the feed's real occupied height, so
   this reserves exactly the right space at every width, expanded or collapsed.
   The fallback covers the frame before the first measurement. */
.foot-bottom{padding-bottom:calc(var(--ai-dash-h,10rem) + 1.5rem)}

@media (prefers-reduced-motion:reduce){
  /* This page carries a blanket `*{animation:none!important}` under reduced
     motion (see the reduced-motion block near the top of this stylesheet).
     That is more specific than nothing, but `animation:none` is a shorthand:
     it resets animation-name, which strips the very keyframe that positioned
     each data packet. The component's own fallback only pins play-state and
     delay, so without this the packets would all pile up at the SVG origin.
     Park each one at a representative point along its path instead. */
  .ai-pk-in,.ai-pk-good{
    transform:translate(calc(var(--x0) + (var(--x1) - var(--x0)) * .62),
                        calc(var(--y0) + (var(--y1) - var(--y0)) * .62))!important;
    opacity:1!important;
  }
  .ai-pk-good{color:var(--neon)!important}          /* cleared the sieves */
  .ai-pk-bad{                                        /* rejected, mid-tumble */
    transform:translate(var(--xm),var(--ym)) rotate(18deg)!important;
    color:var(--ai-dead)!important;opacity:.7!important;
  }
  .ai-dr-pk{
    transform:translate(calc(var(--x0) + (var(--x1) - var(--x0)) * .58),
                        calc(var(--y0) + (var(--y1) - var(--y0)) * .58))!important;
    opacity:1!important;
  }
  /* Same shorthand problem: the drone's position came from its keyframe. */
  .ai-drone{opacity:1!important;offset-distance:52%!important}
  /* The bubble is revealed by a class, not an animation, so it is unaffected —
     but the transition that carries it is stripped, which is correct. */
}

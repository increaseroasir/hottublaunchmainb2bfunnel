  /* --- grain field: makes flat ink read as a lit surface, not a swatch --- */
  .grain{position:relative;isolation:isolate}
  .grain::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:0;
    background-image:var(--grain);background-size:120px 120px;opacity:.05}
  .grain>*{position:relative;z-index:1}
  /* --- gradient seam at every cream↔ink boundary --- */
  .seam-top{background-image:linear-gradient(90deg,transparent 4%,rgba(206,17,38,.42) 50%,transparent 96%);
    background-repeat:no-repeat;background-size:100% 1px;background-position:center top}

  .btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:.6rem;font-family:'Montserrat';font-weight:800;font-size:.82rem;letter-spacing:.05em;text-transform:uppercase;padding:1.05em 1.9em;border-radius:var(--r-sm);border:0;cursor:pointer;line-height:1;
    transition:background-color .18s var(--e-soft),color .18s var(--e-soft),transform .28s var(--e-spring),box-shadow .28s var(--e-out),border-color .18s var(--e-soft)}

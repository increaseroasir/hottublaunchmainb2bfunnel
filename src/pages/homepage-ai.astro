  /* ---------- NAV ---------- */
  nav.topnav{position:relative;z-index:50;background:rgba(250,247,242,.82);backdrop-filter:blur(14px) saturate(1.35);-webkit-backdrop-filter:blur(14px) saturate(1.35);border-bottom:1px solid var(--line);
    transition:background-color .3s var(--e-soft),box-shadow .3s var(--e-soft),border-color .3s var(--e-soft)}
  .navrow{display:flex;align-items:center;justify-content:space-between;padding:.9rem clamp(1.2rem,4vw,2.5rem);transition:padding .3s var(--e-out)}
  /* scrolled state: tighter, denser, lifted off the page */

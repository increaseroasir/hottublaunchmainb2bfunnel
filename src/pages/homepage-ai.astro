  #heroSentinel{top:60vh}

  /* ---------- ANNOUNCEMENT BAR ---------- */
  .stickyhead{position:sticky;top:0;z-index:51}
  .annbar{position:relative;background:var(--ink);color:var(--cream);text-align:center;padding:.6rem 1rem;font-family:'Montserrat';font-weight:700;font-size:.72rem;letter-spacing:.05em;flex-wrap:wrap;
    background-image:var(--grain),radial-gradient(60% 300% at 50% 50%,rgba(206,17,38,.16),transparent 70%);background-size:120px 120px,auto}
  .annbar a{position:relative;color:var(--cream);border-bottom:1px solid var(--red);padding-bottom:1px;white-space:nowrap;margin-left:.6rem;transition:color .18s var(--e-soft)}

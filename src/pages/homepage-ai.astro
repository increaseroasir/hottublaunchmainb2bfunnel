  color:var(--ai-faint);transition:color .2s var(--ai-e-soft);
}
.ai-chat-skip:hover{color:var(--volt)}
.ai-chat-skip[hidden]{display:none}

/* ==================== 3. AI AGENT SEQUENCES (shared) ===================== */
.ai-agent{
  position:relative;margin:0;width:100%;
  border:1px solid var(--ai-hair);border-radius:14px;
  background:linear-gradient(180deg, color-mix(in srgb, var(--panel) 70%, transparent), color-mix(in srgb, var(--void) 70%, transparent));
  overflow:hidden;
}
.ai-agent::before{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.5;
  background-image:linear-gradient(var(--ai-hair) 1px,transparent 1px),linear-gradient(90deg,var(--ai-hair) 1px,transparent 1px);
  background-size:34px 34px;
  mask-image:radial-gradient(120% 80% at 50% 50%, var(--ai-mask) 20%, transparent 78%);
  -webkit-mask-image:radial-gradient(120% 80% at 50% 50%, var(--ai-mask) 20%, transparent 78%);
}
.ai-agent-svg{position:relative;display:block;width:100%;height:auto;aspect-ratio:16/9}
.ai-agent figcaption{
  position:relative;display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;
  padding:.7rem .95rem;border-top:1px solid var(--ai-hair);
  font-family:var(--ai-mono);font-size:.6rem;letter-spacing:.13em;text-transform:uppercase;color:var(--ai-faint);
}
.ai-agent figcaption b{color:var(--ai-text);font-weight:700}
.ai-agent figcaption .ai-agent-state{margin-left:auto;color:var(--volt)}
.ai-agent.is-live figcaption .ai-agent-state{color:var(--neon)}

/* Gradient stops live in CSS, not presentation attributes, so the tokens
   resolve reliably in every engine. */
.ai-agent .ai-g0{stop-color:var(--volt);stop-opacity:.85}
.ai-agent .ai-g1{stop-color:var(--volt);stop-opacity:.20}
.ai-agent .ai-g2{stop-color:var(--volt);stop-opacity:0}

/* Offscreen = frozen. Nothing in a scrolled-past sequence keeps burning frames. */
.ai-agent:not(.is-vis) *,
.ai-dr:not(.is-vis) *{animation-play-state:paused!important}

/* shared SVG primitives */
.ai-agent .ai-frame{fill:none;stroke:var(--ai-hair-2);stroke-width:1.2}
.ai-agent .ai-block{fill:var(--ai-surface-2)}
.ai-agent .ai-lab{font-family:var(--ai-mono);font-size:8px;letter-spacing:.14em;fill:var(--ai-faint);text-transform:uppercase}
.ai-agent .ai-node{fill:var(--volt);filter:drop-shadow(0 0 5px var(--ai-volt-55))}
.ai-agent .ai-link{fill:none;stroke:var(--ai-volt-45);stroke-width:1;stroke-dasharray:3 5}
.ai-agent.is-live .ai-link{animation:aiLinkFlow 1.4s linear infinite}
@keyframes aiLinkFlow{to{stroke-dashoffset:-16}}

/* The "agent" itself — a drone-like light, never a figure. It only appears
   where offset-path is supported; elsewhere the sequence simply omits it
   rather than parking a stray dot at the SVG origin. */
.ai-drone{opacity:0}
.ai-drone .ai-drone-core{fill:var(--volt);filter:drop-shadow(0 0 8px var(--volt))}
.ai-drone .ai-drone-ring{fill:none;stroke:var(--ai-volt-55);stroke-width:1;
  animation:aiDroneSpin 2.2s linear infinite;transform-origin:center;transform-box:fill-box}
.ai-drone .ai-drone-pip{fill:var(--ai-volt-55)}
@keyframes aiDroneSpin{to{transform:rotate(360deg)}}
@supports (offset-path: path("M0 0")){
  .ai-agent.is-live .ai-drone{animation:aiDroneScan 6.2s var(--ai-e-soft) infinite;offset-rotate:0deg}
  @keyframes aiDroneScan{
    0%{offset-distance:0%;opacity:0}
    8%{opacity:1}
    50%{opacity:.85}
    92%{opacity:1}
    100%{offset-distance:100%;opacity:0}
  }
}

/* data packets — one keyframe family, positions come from per-element vars */
/* Glyph geometry lives on the <symbol>s as `currentColor` presentation
   attributes, so it resolves inside the <use> shadow tree in every engine.
   Only the packet's own colour and motion are controlled from here. */
.ai-pk{opacity:0;animation-play-state:paused}
.ai-agent.is-live .ai-pk{animation-play-state:running}

@keyframes aiPkIn{
  0%{transform:translate(var(--x0),var(--y0)) scale(.55);opacity:0}
  14%{opacity:1}
  86%{opacity:1;transform:translate(calc(var(--x0) + (var(--x1) - var(--x0)) * .93), calc(var(--y0) + (var(--y1) - var(--y0)) * .93)) scale(.85)}
  100%{transform:translate(var(--x1),var(--y1)) scale(.2);opacity:0}
}
.ai-pk-in{animation:aiPkIn var(--d,3s) linear infinite;animation-delay:var(--t,0s);color:var(--volt)}

/* ---------------- 3a. COLLECT ---------------- */
#aiAgentCollect .ai-core-shell{fill:none;stroke:var(--ai-volt-55);stroke-width:1.2}
#aiAgentCollect .ai-core-glow{fill:url(#aiColCoreGrad)}
#aiAgentCollect .ai-core-ring{fill:none;stroke:var(--ai-volt-28);stroke-width:1;stroke-dasharray:5 7;
  transform-box:view-box;transform-origin:470px 180px}
#aiAgentCollect.is-live .ai-core-ring{animation:aiCoreSpin 9s linear infinite}
#aiAgentCollect.is-live .ai-core-ring.rev{animation-duration:6s;animation-direction:reverse}
@keyframes aiCoreSpin{to{transform:rotate(360deg)}}
#aiAgentCollect .ai-core-pulse{fill:var(--ai-volt-28);transform-box:view-box;transform-origin:470px 180px;opacity:0}
#aiAgentCollect.is-live .ai-core-pulse{animation:aiCorePulse 2.6s var(--ai-e-out) infinite}
@keyframes aiCorePulse{0%{opacity:.5;transform:scale(.55)}70%,100%{opacity:0;transform:scale(1.5)}}
/* Core readouts use --neon so they stay legible against the --volt glow
   in any theme, rather than sitting volt-on-volt. */
#aiAgentCollect .ai-core-bar{fill:var(--neon);opacity:.25}
#aiAgentCollect.is-live .ai-core-bar{animation:aiCoreBar 1.6s var(--ai-e-soft) infinite;animation-delay:var(--t,0s)}
@keyframes aiCoreBar{0%,100%{opacity:.18}45%{opacity:1}}
#aiAgentCollect .ai-scanline{fill:var(--ai-volt-14);opacity:0}
#aiAgentCollect.is-live .ai-scanline{animation:aiScan 6.2s var(--ai-e-soft) infinite}
@keyframes aiScan{0%{opacity:0;transform:translateY(0)}6%{opacity:1}94%{opacity:1}100%{opacity:0;transform:translateY(252px)}}

/* ---------------- 3b. ORGANIZE ---------------- */
#aiAgentOrganize .ai-sieve{fill:var(--ai-volt-06);stroke:var(--ai-volt-28);stroke-width:1}
#aiAgentOrganize .ai-sieve-mesh{stroke:var(--ai-volt-28);stroke-width:.8}
#aiAgentOrganize.is-live .ai-sieve-lit{animation:aiSieveLit 2.4s var(--ai-e-soft) infinite;animation-delay:var(--t,0s)}
@keyframes aiSieveLit{0%,100%{opacity:.25}40%{opacity:1}}
#aiAgentOrganize .ai-sieve-lit{fill:var(--volt);opacity:.25}
#aiAgentOrganize .ai-bin{fill:var(--ai-red-18);stroke:var(--ai-red-50);stroke-width:1.1;stroke-dasharray:4 4}
#aiAgentOrganize .ai-bin-lab{fill:var(--red)}
#aiAgentOrganize .ai-db-row{fill:var(--ai-neon-18);stroke:var(--neon);stroke-width:1;opacity:.3;
  filter:drop-shadow(0 0 5px var(--ai-neon-18))}
#aiAgentOrganize.is-live .ai-db-row{animation:aiDbFill 4.4s var(--ai-e-out) infinite;animation-delay:var(--t,0s)}
@keyframes aiDbFill{0%{opacity:.18;transform:translateX(-6px)}22%{opacity:1;transform:none}100%{opacity:.75;transform:none}}
#aiAgentOrganize .ai-db-tick{fill:var(--neon);opacity:.5}
#aiAgentOrganize .ai-raw{stroke:var(--ai-faint);stroke-width:1;fill:none;stroke-dasharray:2 4}
#aiAgentOrganize.is-live .ai-raw{animation:aiLinkFlow 1s linear infinite}

/* good packet: straight through the sieves, resolves to --neon */
@keyframes aiOrgGood{
  0%{transform:translate(var(--x0),var(--y0)) scale(.6) rotate(-8deg);opacity:0;color:var(--ai-faint)}
  10%{opacity:1}
  52%{color:var(--ai-faint)}
  66%{color:var(--neon);transform:translate(calc(var(--x0) + (var(--x1) - var(--x0)) * .66), calc(var(--y0) + (var(--y1) - var(--y0)) * .66)) scale(1.05) rotate(0deg)}
  92%{opacity:1;color:var(--neon)}
  100%{transform:translate(var(--x1),var(--y1)) scale(.5) rotate(0deg);opacity:0;color:var(--neon)}
}
.ai-pk-good{animation:aiOrgGood var(--d,4s) linear infinite;animation-delay:var(--t,0s);color:var(--ai-faint)}
/* bad packet: rejected at the sieve, rerouted down into the discard bin */
/* rejected: never brightens — dims to grey and tumbles into the discard bin */
@keyframes aiOrgBad{
  0%{transform:translate(var(--x0),var(--y0)) scale(.6) rotate(0deg);opacity:0;color:var(--ai-faint)}
  10%{opacity:.8}
  40%{transform:translate(var(--xm),var(--ym)) scale(.95) rotate(14deg);color:var(--ai-faint)}
  52%{transform:translate(calc(var(--xm) + 6px),calc(var(--ym) + 8px)) scale(.9) rotate(-22deg);color:var(--ai-dead)}
  88%{opacity:.5;color:var(--ai-dead)}
  100%{transform:translate(var(--x1),var(--y1)) scale(.45) rotate(46deg);opacity:0;color:var(--ai-dead)}
}
.ai-pk-bad{animation:aiOrgBad var(--d,4s) linear infinite;animation-delay:var(--t,0s);color:var(--ai-faint)}

/* ===================== 4. DATA RIGHTS MAP OVERLAY ======================== */
/* Fills the map container, never intercepts pointer events, so the existing
   .marker hover tooltips underneath keep working. */
.ai-dr{
  position:absolute;inset:0;z-index:3;pointer-events:none;
  display:flex;align-items:center;justify-content:center;
  padding:var(--ai-dr-pad,0);
}
.ai-dr-field{position:relative;width:100%;max-width:840px;aspect-ratio:700/380}
.ai-dr-svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}

/* unclaimed: sparse, broken, unfocused — no packets, no convergence */
.ai-dr-open-net{stroke:var(--ai-faint);stroke-width:.9;fill:none;stroke-dasharray:2.5 6;opacity:.55}
.ai-dr.is-live .ai-dr-open-net{animation:aiDrDrift 5.5s var(--ai-e-soft) infinite;animation-delay:var(--t,0s)}
@keyframes aiDrDrift{0%,100%{opacity:.32;stroke-dashoffset:0}50%{opacity:.9;stroke-dashoffset:11}}
.ai-dr-open-dot{fill:var(--ai-faint);opacity:.6}

/* the wider global mesh feeding the two partner territories */
.ai-dr-feed{fill:none;stroke:var(--ai-volt-14);stroke-width:.9;stroke-dasharray:4 6}
.ai-dr.is-live .ai-dr-feed{animation:aiDrFeed 2.2s linear infinite}
@keyframes aiDrFeed{to{stroke-dashoffset:-20}}

/* partner territory: dense, bright, exclusive */
.ai-dr-ray{stroke:var(--volt);stroke-width:.9;opacity:.55;stroke-linecap:round}
.ai-dr.is-live .ai-dr-ray{animation:aiDrRay 2.8s var(--ai-e-soft) infinite;animation-delay:var(--t,0s)}
@keyframes aiDrRay{0%,100%{opacity:.22}42%{opacity:.95}}
.ai-dr-halo{fill:none;stroke:var(--ai-volt-55);stroke-width:1;transform-box:fill-box;transform-origin:center;opacity:0}
.ai-dr.is-live .ai-dr-halo{animation:aiDrHalo 3.1s var(--ai-e-out) infinite;animation-delay:var(--t,0s)}
@keyframes aiDrHalo{0%{opacity:.7;transform:scale(.35)}75%,100%{opacity:0;transform:scale(1.35)}}
.ai-dr-hub{fill:var(--volt);filter:drop-shadow(0 0 7px var(--volt))}
.ai-dr-zone{fill:var(--ai-volt-06);stroke:var(--ai-volt-28);stroke-width:.8;stroke-dasharray:3 4}

/* partner control-panel glyph */
.ai-dr-panel-box{fill:color-mix(in srgb, var(--panel) 90%, transparent);stroke:var(--ai-volt-55);stroke-width:1}
.ai-dr-panel-bar{fill:var(--neon);opacity:.8}
.ai-dr.is-live .ai-dr-panel-bar{animation:aiDrBar 2s var(--ai-e-soft) infinite;animation-delay:var(--t,0s)}
@keyframes aiDrBar{0%,100%{opacity:.35}50%{opacity:1}}
.ai-dr-panel-lab{font-family:var(--ai-mono);font-size:6.5px;letter-spacing:.12em;fill:var(--volt)}

/* packets flowing global -> territory (--neon intelligence), then
   territory -> partner control panel (--volt, the partner own feed) */
.ai-dr-pk{fill:var(--neon);opacity:0;animation-play-state:paused;
  filter:drop-shadow(0 0 4px var(--ai-neon-45))}
.ai-dr.is-live .ai-dr-pk{animation-play-state:running}
.ai-dr-pk.out{fill:var(--volt);filter:drop-shadow(0 0 5px var(--volt))}
@keyframes aiDrFlow{
  0%{transform:translate(var(--x0),var(--y0)) scale(.5);opacity:0}
  16%{opacity:1}
  84%{opacity:1}
  100%{transform:translate(var(--x1),var(--y1)) scale(.9);opacity:0}
}
.ai-dr-pk{animation:aiDrFlow var(--d,2.8s) linear infinite;animation-delay:var(--t,0s)}

.ai-dr-note{
  position:absolute;left:0;bottom:0;max-width:min(46ch,58%);margin:0;
  font-family:var(--ai-mono);font-size:clamp(.56rem,1.05vw,.7rem);
  letter-spacing:.09em;line-height:1.55;text-transform:uppercase;
  color:var(--ai-text);
  padding:.5rem .7rem .5rem .75rem;
  border-left:2px solid var(--volt);
  background:linear-gradient(90deg, color-mix(in srgb, var(--panel) 80%, transparent), transparent);
}
.ai-dr-note b{color:var(--volt);font-weight:700}
@media (max-width:640px){
  .ai-dr-note{max-width:82%;font-size:.52rem;letter-spacing:.05em;padding:.4rem .5rem}
}

/* ======================= REDUCED MOTION — STATIC END STATE =============== */
@media (prefers-reduced-motion:reduce){
  /* Freeze every packet at a distributed point in its own cycle, which renders
     the completed diagram as a still frame instead of an empty stage. */
  .ai-pk,.ai-dr-pk{
    animation-play-state:paused!important;
    animation-delay:calc(-1 * var(--t,0s))!important;
    opacity:1!important;
  }
  /* Everything ambient simply stops. */
  .ai-dash-live,.ai-radar-sweep,.ai-blip,.ai-chat-pulse::after,.ai-typing i,
  .ai-agent .ai-link,.ai-drone,.ai-core-ring,.ai-core-pulse,.ai-core-bar,.ai-scanline,
  .ai-sieve-lit,.ai-db-row,.ai-raw,
  .ai-dr-open-net,.ai-dr-feed,.ai-dr-ray,.ai-dr-halo,.ai-dr-panel-bar,
  .ai-chat-panel.is-open,.ai-turn{
    animation:none!important;
  }
  .ai-blip{opacity:.8}
  .ai-blip.hot,.ai-blip.warm{opacity:1}
  .ai-radar-sweep{opacity:.35}
  .ai-drone{opacity:1;offset-distance:52%}
  .ai-core-bar{opacity:.85}
  .ai-db-row{opacity:1;transform:none}
  .ai-dr-ray{opacity:.7}
  .ai-dr-halo{opacity:.28;transform:none}
  .ai-dr-open-net{opacity:.3}
  .ai-turn{opacity:1;transform:none}
  .ai-dash-body{transition:none}
  .ai-chat-bubble:hover,.ai-chat-cta:hover{transform:none}
}

/* ==========================================================================
   PAGE <-> COMPONENT SEAM
   Everything above this line arrived verbatim from ai-components-draft.html.
   These rules exist only because of differences between that harness and this
   page, and are the only place the two builds are stitched together.

  @media (max-width:760px){
    .navburger{display:block}
    .navlinks{position:absolute;top:100%;left:0;right:0;background:rgba(250,247,242,.94);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);
      flex-direction:column;align-items:stretch;gap:0;padding:.5rem 1.2rem 2rem;
      max-height:calc(100vh - 90px);overflow-y:auto;
      transform:translateY(-10px) scale(.99);opacity:0;pointer-events:none;transition:opacity .28s var(--e-out),transform .38s var(--e-spring);
      transform-origin:top center;
      border-top:1px solid var(--line);box-shadow:0 28px 50px -18px rgba(25,25,25,.3)}
    .navlinks.open{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
    .navlinks a{width:100%;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.85rem}
    .navlinks a[href^="#"]::after{display:none}
    .navlinks a.newpill{display:flex!important;border:1px solid rgba(206,17,38,.22);border-radius:8px;margin:1rem 0 0;padding:.9rem 1rem!important}
    .navlinks a.navcta{margin-top:1rem;justify-content:center;border:0}
  }

  /* ---------- REVEAL ---------- */
  /* spring-eased, index-staggered; --i is set in JS so new items stagger automatically */
  .reveal{opacity:0;transform:translateY(24px) scale(.985);will-change:opacity,transform;
    transition:opacity .75s var(--e-out),transform .75s var(--e-out);
    transition-delay:calc(var(--i,0) * 65ms)}
  .reveal.in{opacity:1;transform:none;will-change:auto}
  .reveal.d1{transition-delay:.08s}.reveal.d2{transition-delay:.16s}.reveal.d3{transition-delay:.24s}.reveal.d4{transition-delay:.32s}

  /* ---------- HERO ---------- */
  .hero{position:relative;overflow:hidden;background:var(--ink);padding:clamp(3.4rem,8vw,6.5rem) clamp(1.2rem,4vw,2.5rem) clamp(4rem,8vw,6.5rem);display:flex;flex-direction:column;align-items:center;text-align:center}
  .hero::before{content:"";position:absolute;inset:0;z-index:0;background:
      radial-gradient(55% 40% at 50% 4%, rgba(206,17,38,.19), transparent 60%),
      radial-gradient(45% 32% at 88% 62%, rgba(206,17,38,.09), transparent 65%),
      radial-gradient(40% 30% at 8% 70%, rgba(224,169,98,.07), transparent 65%);
    pointer-events:none}
  /* grain sits above the glow fields, below every piece of content */
  .hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background-image:var(--grain);background-size:120px 120px;opacity:.055}
  .hero-grid{position:absolute;right:-40px;bottom:-40px;z-index:0;width:340px;height:340px;pointer-events:none;
    background-image:radial-gradient(rgba(250,247,242,.14) 1px, transparent 1px);background-size:22px 22px;
    -webkit-mask-image:radial-gradient(circle at 70% 70%, #000 0%, transparent 72%);
    mask-image:radial-gradient(circle at 70% 70%, #000 0%, transparent 72%);
    will-change:transform}
  .hero-spot{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:0;transition:opacity .45s var(--e-out);
    background:radial-gradient(340px circle at var(--mx,50%) var(--my,20%), rgba(250,247,242,.07), rgba(206,17,38,.045) 42%, transparent 72%)}
  .hero:hover .hero-spot{opacity:1}
  .hero .kicker2{position:relative;z-index:2;display:block;font-family:'Montserrat';font-weight:800;font-size:.78rem;letter-spacing:.26em;text-transform:uppercase;color:var(--red);margin-bottom:1.1rem;opacity:0;animation:rise .8s .05s var(--e-out) forwards}
  .hero h1{position:relative;z-index:2;font-size:clamp(2.15rem,6.2vw,4.6rem);max-width:19ch;color:var(--cream);letter-spacing:-.035em;opacity:0;animation:riseBig .95s .16s var(--e-out) forwards}
  .hero h1 .red{position:relative;display:inline-block}
  .hero .sub{position:relative;z-index:2;color:#B9B1A7;font-size:clamp(1.02rem,1.7vw,1.22rem);max-width:47ch;margin:1.5rem 0 2.2rem;font-weight:500;line-height:1.6;opacity:0;animation:rise .9s .32s var(--e-out) forwards}
  .hero>.btn{position:relative;z-index:2;opacity:0;animation:rise .9s .46s var(--e-out) forwards}
  @keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
  @keyframes riseBig{from{opacity:0;transform:translateY(26px) scale(.975)}to{opacity:1;transform:none}}

  .stage{position:relative;z-index:2;width:100%;max-width:840px;margin-top:clamp(2.6rem,7vw,4.4rem);opacity:0;animation:rise 1.1s .6s var(--e-out) forwards;
    display:grid;grid-template-columns:minmax(108px,1fr) minmax(126px,196px) minmax(108px,1fr);
    grid-template-rows:auto auto;align-items:center;column-gap:clamp(10px,3.4vw,30px);row-gap:clamp(16px,4.4vw,34px)}

  .bucket-wrap{grid-column:2;grid-row:1/3;justify-self:center;width:100%;max-width:196px;aspect-ratio:190/230;filter:drop-shadow(0 26px 38px rgba(0,0,0,.5)) drop-shadow(0 0 44px rgba(206,17,38,.14))}
  svg.bucket{width:100%;height:100%;overflow:visible}
  .bucket-glow{animation:glowPulse 3.4s ease-in-out infinite}
  @keyframes glowPulse{0%,100%{opacity:.55}50%{opacity:1}}
  .pin{transform-box:fill-box;transform-origin:bottom center;animation:pinPulse 3.4s ease-in-out infinite}
  .pin2{animation-delay:.5s}.pin3{animation-delay:1s}
  @keyframes pinPulse{0%,100%{opacity:.55;transform:scale(.97)}50%{opacity:1;transform:scale(1)}}
  /* slow water swell — transform only, clipped by the bucket path */
  .water{transform-box:fill-box;transform-origin:center bottom;animation:swell 6.5s ease-in-out infinite}
  @keyframes swell{0%,100%{transform:translateY(2px)}50%{transform:translateY(-3px)}}

  .fcard{position:relative;background:linear-gradient(165deg, rgba(255,255,255,.07), rgba(255,255,255,.022));
    border:1px solid rgba(250,247,242,.1);border-radius:var(--r-lg);padding:clamp(.75rem,2.4vw,1.05rem) clamp(.75rem,2.6vw,1.2rem);
    box-shadow:var(--el-ink);text-align:left;backdrop-filter:blur(12px) saturate(1.2);-webkit-backdrop-filter:blur(12px) saturate(1.2);
    animation:float 5.5s ease-in-out infinite;
    transition:border-color .3s var(--e-soft),box-shadow .35s var(--e-out)}
  /* lit top edge — gradient hairline via mask-composite */
  .fcard::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
    background:linear-gradient(180deg,rgba(250,247,242,.42),rgba(250,247,242,0) 55%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}
  .fcard:hover{border-color:rgba(206,17,38,.34);box-shadow:var(--el-ink),0 0 40px -12px rgba(206,17,38,.4)}
  .fcard .icon{position:relative;width:clamp(28px,7vw,38px);height:clamp(28px,7vw,38px);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:.6rem;
    background:radial-gradient(circle at 32% 28%, rgba(206,17,38,.38), rgba(206,17,38,.05));border:1px solid rgba(206,17,38,.3);
    box-shadow:0 0 18px -4px rgba(206,17,38,.45),inset 0 1px 0 rgba(255,255,255,.14)}
  .fcard .icon svg{width:60%;height:60%}
  .fcard .lab{font-family:'Montserrat';font-weight:800;font-size:clamp(.52rem,1.6vw,.6rem);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:.3rem}
  .fcard .val{font-family:'Montserrat';font-weight:900;font-size:clamp(.82rem,2.6vw,1.05rem);color:var(--cream)}
  .fcard .val .arrow{color:var(--muted-dark);font-weight:700;margin:0 .25em;font-size:.85em}
  .fcard .val .win{color:#F0475C}
  .fcard .cap{font-size:clamp(.66rem,2vw,.78rem);color:var(--muted-dark);margin-top:.25rem}

  /* per-card connector: a short line + dot pointing toward the bucket column, scales with the grid instead of fixed SVG coordinates */
  .fcard .connect{position:absolute;top:50%;width:clamp(12px,3vw,32px);height:2px;background:linear-gradient(90deg,rgba(250,247,242,.04),rgba(206,17,38,.5));transform:translateY(-50%);border-radius:2px}
  .fcard .connect::after{content:"";position:absolute;top:50%;width:5px;height:5px;border-radius:50%;background:var(--red);transform:translateY(-50%);box-shadow:0 0 10px 2px rgba(206,17,38,.6)}
  .c1 .connect,.c3 .connect{right:-1px;transform:translate(100%,-50%)}
  .c1 .connect::after,.c3 .connect::after{right:-2.5px}
  .c2 .connect,.c4 .connect{left:-1px;transform:translate(-100%,-50%);background:linear-gradient(270deg,rgba(250,247,242,.04),rgba(206,17,38,.5))}
  .c2 .connect::after,.c4 .connect::after{left:-2.5px}

  .c1{grid-column:1;grid-row:1;animation-delay:.2s}
  .c3{grid-column:1;grid-row:2;animation-delay:.6s}
  .c2{grid-column:3;grid-row:1;animation-delay:1.1s}
  .c4{grid-column:3;grid-row:2;animation-delay:1.6s}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}

  /* Below ~560px the three-column stage starves both the bucket and the cards,
     so the bucket takes its own full-width row and the four leak cards drop into
     a 2x2 grid underneath. Same markup, same copy — just a composition that has
     room to breathe. The sideways connectors are meaningless once stacked. */
  @media (max-width:560px){
    .stage{grid-template-columns:1fr 1fr;grid-template-rows:auto auto auto;
      column-gap:clamp(8px,2.6vw,14px);row-gap:clamp(12px,3.4vw,18px)}
    .bucket-wrap{grid-column:1/-1;grid-row:1;max-width:210px;margin-bottom:.4rem}
    .c1{grid-column:1;grid-row:2}
    .c2{grid-column:2;grid-row:2}
    .c3{grid-column:1;grid-row:3}
    .c4{grid-column:2;grid-row:3}
    .fcard{padding:.85rem .9rem}
    .fcard .connect{display:none}
    .fcard .lab{font-size:.55rem;letter-spacing:.08em}
    .fcard .val{font-size:.95rem}
    .fcard .cap{font-size:.7rem}
  }
  .trust{position:relative;z-index:2;margin-top:clamp(3rem,7vw,4.2rem);padding-top:clamp(1.4rem,3vw,2rem);opacity:0;animation:rise .9s .82s var(--e-out) forwards;width:100%;max-width:860px}
  .trust::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:min(320px,60%);height:1px;
    background:linear-gradient(90deg,transparent,rgba(250,247,242,.28),transparent)}
  .trust .tlab{font-family:'Montserrat';font-weight:700;font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:1.1rem}
  .tlogos-wrap{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent);mask-image:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent)}
  .tlogos{--mq-gap:3.4rem;display:flex;gap:var(--mq-gap);padding-right:var(--mq-gap);width:max-content;animation:marquee 28s linear infinite}
  .tlogos-wrap:hover .tlogos{animation-play-state:paused}
  .tlogos span{font-family:'Montserrat';font-weight:800;font-size:.9rem;letter-spacing:.04em;color:rgba(250,247,242,.55);text-transform:uppercase;white-space:nowrap}
  @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ---------- WHY WE EXIST ---------- */
  .why{padding:var(--s-5) 0}
  .why .grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:start}
  .why p{font-size:1.06rem;color:var(--ink-soft);margin-bottom:1.15rem;max-width:52ch}
  .why p:last-child{margin-bottom:0}
  .why .kicker{font-family:'Montserrat';font-weight:800;font-size:1.08rem;color:var(--ink);text-transform:none;letter-spacing:-.01em}
  @media (max-width:820px){.why .grid{grid-template-columns:1fr}}

  /* ---------- MECHANISM ---------- */
  .mech{background-color:var(--ink);padding:var(--s-5) 0;color:var(--cream)}
  .mech h2{color:var(--cream)}
  .mech .lede{color:#C9C1B6;font-size:clamp(1.02rem,1.7vw,1.2rem);max-width:54ch;margin:1.2rem 0 var(--s-3);font-weight:500;line-height:1.6}
  .acts{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
  .act{position:relative;background:linear-gradient(180deg,rgba(250,247,242,.075),rgba(250,247,242,.028));border:1px solid var(--line-dark);border-radius:var(--r-lg);padding:1.8rem 1.7rem;
    box-shadow:var(--el-ink);overflow:hidden;
    transition:transform .4s var(--e-out),border-color .3s var(--e-soft),box-shadow .4s var(--e-out)}
  .act::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
    background:linear-gradient(180deg,rgba(250,247,242,.34),rgba(250,247,242,0) 50%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}
  .act:hover{transform:translateY(-5px);border-color:rgba(206,17,38,.32);box-shadow:var(--el-ink),0 0 48px -16px rgba(206,17,38,.42)}
  .act .n{font-family:'Montserrat';font-weight:900;font-size:1.9rem;color:var(--red);line-height:1;margin-bottom:.7rem;letter-spacing:-.03em;
    text-shadow:0 0 26px rgba(206,17,38,.45)}
  .act h3{color:var(--cream);margin-bottom:.55rem}
  .act p{color:#B9B1A7;font-size:.98rem;max-width:none}
  .mech .callout{position:relative;border-left:3px solid var(--red);padding:.6rem 0 .6rem 1.4rem;margin-top:var(--s-3);color:#D8D0C6;font-size:1.05rem;max-width:60ch}
  .mech .callout::before{content:"";position:absolute;left:-3px;top:0;bottom:0;width:3px;background:var(--red);filter:blur(6px);opacity:.7}
  .mech .callout b{color:var(--cream)}
  @media (max-width:820px){.acts{grid-template-columns:1fr}}

  /* ---------- AUDIT SNAPSHOT (repeated data-viz moment) ---------- */
  /* treated as real product UI: window chrome, tabular numerals, lit bars */
  .snapshot{padding:var(--s-4) 0}
  .snap-card{position:relative;background:var(--paper);border:1px solid var(--line);border-radius:var(--r-lg);padding:clamp(1.1rem,3vw,1.6rem) clamp(1.6rem,4vw,2.4rem) clamp(1.8rem,4vw,2.4rem);box-shadow:var(--el-3);overflow:hidden}
  .snap-chrome{display:flex;gap:6px;padding-bottom:1.1rem;margin-bottom:.2rem}
  .snap-chrome span{width:9px;height:9px;border-radius:50%;background:var(--line)}
  .snap-chrome span:first-child{background:rgba(206,17,38,.45)}
  .snap-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.8rem;margin-bottom:1.5rem;padding-bottom:1.2rem;border-bottom:1px solid var(--line)}
  .snap-head .t{font-family:'Montserrat';font-weight:800;font-size:.95rem;text-transform:uppercase;color:var(--ink);letter-spacing:-.005em}
  .snap-head .badge{font-family:'Montserrat';font-weight:700;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--red);background:rgba(206,17,38,.07);border:1px solid rgba(206,17,38,.25);border-radius:999px;padding:.38rem .75rem;box-shadow:inset 0 1px 0 rgba(255,255,255,.6)}
  .snap-rows{display:flex;flex-direction:column;gap:1.05rem}
  .snap-row{display:grid;grid-template-columns:1fr auto auto;gap:1rem;align-items:center}
  .snap-row .nm{font-family:'Montserrat';font-weight:700;font-size:.88rem;color:var(--ink-soft);letter-spacing:.02em}
  .snap-row .bar{grid-column:1/-1;height:7px;border-radius:99px;background:var(--line);overflow:hidden;position:relative;box-shadow:inset 0 1px 2px rgba(25,25,25,.07)}
  /* sits at its final width and grows via scaleX, so the fill never touches layout */
  .snap-row .bar i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,var(--red-dark),var(--red));border-radius:99px;width:var(--w,20%);
    transform:scaleX(0);transform-origin:left center}
  /* leading-edge highlight so the fill reads as live, not printed */
  .snap-row .bar i::after{content:"";position:absolute;right:0;top:0;bottom:0;width:14px;border-radius:99px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.55))}
  .snap-row .sc{font-family:'Montserrat';font-weight:900;font-size:1.02rem;color:var(--ink);text-align:right;
    font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1;letter-spacing:-.01em;min-width:5.5ch}
  @media (max-width:560px){.snap-row{grid-template-columns:1fr auto}}

  /* ---------- SEVEN LEAKS ---------- */
  .leaks{padding:var(--s-5) 0}
  .leaks .lede{font-size:clamp(1.02rem,1.7vw,1.2rem);color:var(--ink-soft);max-width:54ch;margin:1.2rem 0 var(--s-3);font-weight:500;line-height:1.6}
  .leaklist{display:flex;flex-direction:column}
  .leak{position:relative;display:grid;grid-template-columns:auto 1fr;gap:1.3rem;padding:1.25rem 0;border-bottom:1px solid var(--line);align-items:flex-start}
  .leak:first-child{border-top:1px solid var(--line)}
  .leak .icon-badge{width:46px;height:46px;border-radius:12px;background:linear-gradient(160deg,rgba(206,17,38,.11),rgba(206,17,38,.045));border:1px solid rgba(206,17,38,.2);display:flex;align-items:center;justify-content:center;flex:none;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.7),0 6px 16px -8px rgba(206,17,38,.4);
    transition:transform .35s var(--e-spring),border-color .3s var(--e-soft)}
  .leak:hover .icon-badge{transform:scale(1.07) rotate(-3deg);border-color:rgba(206,17,38,.42)}
  /* --muted-dark is a for-ink token; on cream it reads 2.4:1, so use --muted */
  .leak .leaknum{font-family:'Montserrat';font-weight:800;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:.32rem;display:block}
  .leak h3{margin-bottom:.32rem}
  .leak p{color:var(--muted);font-size:.98rem;max-width:56ch}

  /* ---------- ONE STORE PER MARKET ---------- */
  .market{background-color:var(--ink);padding:var(--s-5) 0;color:var(--cream)}
  .market h2{color:var(--cream)}
  .market .lede{color:#C9C1B6;font-size:clamp(1.02rem,1.7vw,1.2rem);max-width:54ch;margin:1.2rem 0 var(--s-3);font-weight:500;line-height:1.6}
  .mapband{position:relative;border:1px solid var(--line-dark);border-radius:var(--r-xl);background:rgba(250,247,242,.045);padding:clamp(1.6rem,4vw,2.8rem);display:flex;align-items:center;justify-content:center;overflow:hidden;
    box-shadow:var(--el-ink)}
  .mapband::before{content:"";position:absolute;inset:0;background:
      radial-gradient(52% 62% at 50% 42%,rgba(206,17,38,.13),transparent 72%),
      radial-gradient(40% 50% at 40% 12%,rgba(250,247,242,.045),transparent 70%)}
  .mapband::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;padding:1px;
    background:linear-gradient(180deg,rgba(250,247,242,.3),rgba(250,247,242,0) 45%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}
  .usdots{position:relative;z-index:1;width:100%;max-width:840px;aspect-ratio:700/380}
  .usmap{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(0 0 26px rgba(206,17,38,.16))}
  /* landmass has to separate from the band fill (.045) or the silhouette vanishes */
  .usmap path{fill:rgba(250,247,242,.085);stroke:rgba(250,247,242,.46);stroke-width:1.4;stroke-linejoin:round;stroke-linecap:round}
  .marker{position:absolute;display:flex;flex-direction:column;align-items:center;gap:.42rem;transform:translate(-50%,-50%)}
  .marker .dot{position:relative;width:11px;height:11px;border-radius:50%;background:var(--red);box-shadow:0 0 0 6px rgba(206,17,38,.18),0 0 16px 2px rgba(206,17,38,.65)}
  /* ping ring on LIVE markers only — the two real stores */
  .marker:not(.open) .dot::after{content:"";position:absolute;inset:-5px;border-radius:50%;border:1.5px solid var(--red);
    animation:pingRing 2.8s var(--e-out) infinite}
  .marker:nth-of-type(2) .dot::after{animation-delay:1.3s}
  @keyframes pingRing{0%{opacity:.75;transform:scale(.55)}100%{opacity:0;transform:scale(2.3)}}
  .marker.open .dot{width:8px;height:8px;background:transparent;border:2px solid rgba(250,247,242,.5);box-shadow:none;
    transition:border-color .3s var(--e-soft),transform .35s var(--e-spring)}
  .marker.open:hover .dot{border-color:rgba(250,247,242,.9);transform:scale(1.25)}
  .marker .lab{font-family:'Montserrat';font-weight:800;font-size:.62rem;letter-spacing:.04em;text-transform:uppercase;color:var(--cream);white-space:nowrap;
    background:rgba(25,25,25,.86);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    padding:.26rem .55rem;border-radius:999px;border:1px solid rgba(206,17,38,.35);box-shadow:0 6px 18px -8px rgba(0,0,0,.8)}
  .marker.open .lab{color:var(--muted-dark);background:transparent;padding:0;font-size:.58rem;border:0;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none}
  .market .keyrow{display:flex;gap:2.2rem;justify-content:center;margin-top:var(--s-2);flex-wrap:wrap}
  .market .keyrow div{display:flex;align-items:center;gap:.5rem;font-family:'Montserrat';font-weight:700;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-dark)}
  .market .keyrow .sw{width:10px;height:10px;border-radius:50%;background:var(--red);box-shadow:0 0 12px 1px rgba(206,17,38,.6)}
  .market .keyrow .sw.open{background:transparent;border:2px solid rgba(250,247,242,.35);box-shadow:none}
  /* the map does the scarcity work — it can't be a sliver on desktop */
  @media (min-width:900px){.mapband{min-height:clamp(520px,50vw,600px)}}
  /* narrow screens: hide the unlabeled open pins' text and let live pills wrap
     instead of running off the band (band clips overflow) */
  @media (max-width:520px){
    .marker.open .lab{display:none}
    .marker .lab{font-size:.5rem;letter-spacing:.02em;line-height:1.35;white-space:normal;text-align:center;
      max-width:36vw;padding:.24rem .45rem}
  }

  /* ---------- CASE STUDIES ---------- */
  .cases{background-color:var(--ink);padding:var(--s-5) 0;color:var(--cream)}
  .cases h2{color:var(--cream)}
  .cases .lede{color:#C9C1B6;font-size:clamp(1.02rem,1.7vw,1.2rem);max-width:54ch;margin:1.2rem 0 var(--s-3);font-weight:500;line-height:1.6}
  .case-row{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem}
  .case-card{position:relative;background:linear-gradient(180deg,rgba(250,247,242,.075),rgba(250,247,242,.028));border:1px solid var(--line-dark);border-radius:var(--r-lg);padding:1.9rem 1.8rem;box-shadow:var(--el-ink);overflow:hidden}
  .case-card::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
    background:linear-gradient(180deg,rgba(250,247,242,.34),rgba(250,247,242,0) 50%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}
  .case-card .tag{display:inline-block;font-family:'Montserrat';font-weight:700;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-dark);border:1px solid var(--line-dark);border-radius:999px;padding:.32rem .7rem;margin-bottom:1.1rem}
  .case-card .stat{font-family:'Montserrat';font-weight:900;font-size:2.2rem;color:var(--red);line-height:1;letter-spacing:-.02em}
  .case-card .stat.case-label{font-size:1.22rem;letter-spacing:.08em;text-transform:uppercase;text-shadow:0 0 24px rgba(206,17,38,.4)}
  .case-card .statlab{font-size:.94rem;color:#C9C1B6;margin:.6rem 0 1.2rem;max-width:38ch}
  .case-card .name{font-family:'Montserrat';font-weight:800;font-size:.95rem;color:var(--cream);text-transform:uppercase;margin-bottom:.3rem;letter-spacing:.01em}
  .case-card .loc{font-size:.85rem;color:var(--muted-dark)}
  .case-card a.readmore{position:relative;display:inline-block;margin-top:1.2rem;font-family:'Montserrat';font-weight:700;font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--cream);border-bottom:2px solid var(--red);padding-bottom:3px;
    transition:color .2s var(--e-soft)}
  .case-card a.readmore:hover{color:#F0475C}
  @media (max-width:720px){.case-row{grid-template-columns:1fr}}

  /* ---------- GUIDE TEASER ---------- */
  .guide{padding:var(--s-4) 0}
  .guide-card{display:grid;grid-template-columns:auto 1fr;gap:clamp(1.8rem,4.5vw,3rem);align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:var(--r-lg);padding:clamp(1.7rem,4vw,2.4rem);box-shadow:var(--el-3);
    perspective:900px}
  /* the lead magnet reads as a physical book on hover */
  .guide-thumb{width:100px;height:134px;border-radius:3px 5px 5px 3px;background:linear-gradient(160deg,#211d19,#141210);position:relative;overflow:hidden;flex:none;
    box-shadow:0 18px 34px -10px rgba(20,15,10,.5),0 2px 6px rgba(20,15,10,.3);
    transform:rotateY(-15deg) rotateX(3deg);transform-style:preserve-3d;
    transition:transform .55s var(--e-out),box-shadow .55s var(--e-out)}
  .guide-card:hover .guide-thumb{transform:rotateY(-6deg) rotateX(1deg) translateY(-5px) scale(1.03);
    box-shadow:0 30px 50px -12px rgba(20,15,10,.55),0 0 40px -14px rgba(206,17,38,.5)}
  .guide-thumb::before{content:"";position:absolute;inset:0;background:radial-gradient(90% 120% at 50% 0%, rgba(206,17,38,.28), transparent 55%)}
  /* spine + page edge shading */
  .guide-thumb::after{content:"";position:absolute;left:0;top:0;bottom:0;width:9px;
    background:linear-gradient(90deg,rgba(0,0,0,.55),rgba(0,0,0,.12) 60%,transparent);
    border-right:1px solid rgba(250,247,242,.08)}
  .guide-thumb .gt{position:absolute;inset:0;padding:15% 12% 14% 18%;color:#fff;font-family:'Montserrat';z-index:1}
  .guide-thumb .gt .s{display:block;font-size:.42rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;opacity:.8}
  .guide-thumb .gt .b{display:block;font-size:.72rem;font-weight:900;color:var(--red);text-transform:uppercase;margin-top:6px;line-height:1.05}
  .guide-body .eyebrow{margin-bottom:.6rem}
  .guide-body h3{font-size:clamp(1.4rem,2vw,1.6rem);margin-bottom:.55rem}
  .guide-body p{color:var(--muted);font-size:.98rem;margin-bottom:1.2rem;max-width:54ch}
  /* desktop: CTA moves to the right edge so the card reads as a banner, not a
     left-weighted block with dead space */
  @media (min-width:900px){
    .guide-body{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:clamp(2rem,4vw,3.5rem);align-items:center}
    .guide-body .eyebrow{grid-column:1;grid-row:1}
    .guide-body h3{grid-column:1;grid-row:2}
    .guide-body p{grid-column:1;grid-row:3;margin-bottom:0}
    .guide-body .btn{grid-column:2;grid-row:1/4;align-self:center;white-space:nowrap}
  }
  @media (max-width:560px){.guide-card{grid-template-columns:1fr;text-align:center}.guide-thumb{margin:0 auto;transform:rotateY(-8deg)}}

  /* ---------- HOVER LIFT (micro-interaction, applied to key cards) ---------- */
  .lift{transition:transform .38s var(--e-out),box-shadow .38s var(--e-out),border-color .3s var(--e-soft)}
  .lift:hover{transform:translateY(-6px)}
  .snap-card.lift:hover{box-shadow:var(--el-4)}
  .case-card.lift:hover{box-shadow:var(--el-ink),0 0 52px -16px rgba(206,17,38,.48);border-color:rgba(206,17,38,.38)}
  .guide-card.lift:hover{box-shadow:var(--el-4)}
  /* transform-only leak hover: no padding animation, no layout thrash */
  .leak{transition:transform .32s var(--e-out),border-color .28s var(--e-soft)}
  .leak::before{content:"";position:absolute;left:-14px;top:14%;bottom:14%;width:2px;border-radius:2px;background:var(--red);
    transform:scaleY(0);transform-origin:center top;transition:transform .38s var(--e-out);
    box-shadow:0 0 10px rgba(206,17,38,.6)}
  .leak:hover{transform:translateX(7px);border-color:var(--muted-dark)}
  .leak:hover::before{transform:scaleY(1)}

  /* ---------- ANIMATED SNAPSHOT BARS ---------- */
  .snap-row .bar i{transition:transform 1.25s var(--e-out);will-change:transform}
  .snap-card.animate .bar i{transform:none;will-change:auto}
  .snap-head .live{display:inline-flex;align-items:center;gap:.4rem;font-family:'Montserrat';font-weight:700;font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .snap-head .live .pulse{width:6px;height:6px;border-radius:50%;background:#2E8B57;position:relative}
  .snap-head .live .pulse::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1.5px solid #2E8B57;animation:pulseRing 1.8s ease-out infinite}
  @keyframes pulseRing{0%{opacity:.7;transform:scale(.6)}100%{opacity:0;transform:scale(1.8)}}

  /* ---------- AUTOMATION DEMO (the follow-up, shown, not just claimed) ---------- */
  .automation{padding:var(--s-5) 0}
  .auto-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center}
  .auto-copy h2{margin-bottom:1.2rem}
  .auto-copy p{font-size:1.05rem;color:var(--ink-soft);margin-bottom:1.15rem;max-width:52ch}
  .auto-copy ul{list-style:none;display:flex;flex-direction:column;gap:.7rem;margin-top:1.3rem}
  .auto-copy li{display:flex;gap:.65rem;align-items:flex-start;font-size:.98rem;color:var(--ink-soft);max-width:50ch}
  .auto-copy li svg{flex:none;margin-top:.15em;filter:drop-shadow(0 3px 8px rgba(206,17,38,.35))}
  /* real device framing: bezel, side buttons, dynamic island, ambient glow */
  .phone{position:relative;width:100%;max-width:306px;margin-inline:auto;border-radius:34px;padding:.5rem;
    background-color:var(--ink);background-image:linear-gradient(160deg,rgba(250,247,242,.1),rgba(250,247,242,0) 46%);
    box-shadow:var(--el-4),0 40px 70px -24px rgba(25,25,25,.4),inset 0 0 0 1px rgba(250,247,242,.08)}
  .phone::before{content:"";position:absolute;left:-3px;top:22%;width:3px;height:38px;border-radius:3px 0 0 3px;background:var(--ink);opacity:.9}
  .phone::after{content:"";position:absolute;right:-3px;top:28%;width:3px;height:56px;border-radius:0 3px 3px 0;background:var(--ink);opacity:.9}
  .phone-screen{position:relative;background:var(--paper);border-radius:28px;padding:2.35rem .9rem 1.1rem;min-height:392px;display:flex;flex-direction:column;gap:.6rem;overflow:hidden}
  .phone-screen::before{content:"";position:absolute;top:.6rem;left:50%;transform:translateX(-50%);width:76px;height:19px;border-radius:999px;background:var(--ink);z-index:2}
  .phone-head{text-align:center;font-family:'Montserrat';font-weight:800;font-size:.72rem;letter-spacing:.06em;color:var(--muted);text-transform:uppercase;padding-bottom:.65rem;border-bottom:1px solid var(--line);margin-bottom:.4rem}
  .bub{position:relative;max-width:78%;padding:.62rem .88rem;border-radius:16px;font-size:.85rem;line-height:1.45;opacity:0}
  .bub-in{align-self:flex-start;background:#F1EEE9;color:var(--ink-soft);border-bottom-left-radius:5px;box-shadow:0 2px 6px rgba(25,25,25,.06)}
  /* speech tails */
  .bub-in::after{content:"";position:absolute;left:-5px;bottom:0;width:10px;height:10px;background:#F1EEE9;clip-path:polygon(100% 0,100% 100%,0 100%)}
  .bub-out{align-self:flex-end;background:linear-gradient(160deg,var(--red),var(--red-dark));color:#fff;border-bottom-right-radius:5px;box-shadow:0 6px 16px -6px rgba(206,17,38,.6)}
  .bub-out::after{content:"";position:absolute;right:-5px;bottom:0;width:10px;height:10px;background:var(--red-dark);clip-path:polygon(0 0,0 100%,100% 100%)}
  .bub-time{font-size:.62rem;color:var(--muted);align-self:flex-end;margin-top:-.3rem}
  .bub-time.left{align-self:flex-start}
  .typing{align-self:flex-end;display:flex;gap:4px;padding:.55rem .8rem;background:var(--red);border-radius:14px;border-bottom-right-radius:4px;opacity:0}
  .typing span{width:5px;height:5px;border-radius:50%;background:#fff;animation:typingDot 1s ease-in-out infinite}
  .typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
  @keyframes typingDot{0%,60%,100%{opacity:.35;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
  .phone.animate .bub, .phone.animate .bub-time, .phone.animate .typing{animation:bubIn .5s ease forwards}
  .b1{animation-delay:.1s!important}.tm1{animation-delay:.5s!important}.t2{animation-delay:.9s!important}
  .b2{animation-delay:1.7s!important}.tm2{animation-delay:2.1s!important}.b3{animation-delay:2.1s!important}
  @keyframes bubIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  @media (max-width:820px){.auto-grid{grid-template-columns:1fr}.phone{margin-top:1rem}}

  /* ---------- PROCESS ---------- */
  .process{background-color:var(--ink);padding:var(--s-5) 0;color:var(--cream)}
  .process h2{color:var(--cream)}
  .process .lede{color:#C9C1B6;font-size:clamp(1.02rem,1.7vw,1.2rem);max-width:54ch;margin:1.2rem 0 var(--s-3);font-weight:500;line-height:1.6}
  .psteps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}
  .pstep{position:relative;padding-top:1.5rem}
  .pstep .pn{font-family:'Montserrat';font-weight:900;font-size:.72rem;letter-spacing:.1em;color:var(--red);margin-bottom:.65rem}
  .pstep h3{color:var(--cream);font-size:1rem;margin-bottom:.42rem}
  .pstep p{color:#B9B1A7;font-size:.9rem;max-width:none}
  .pstep::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;border-radius:2px;
    background:linear-gradient(90deg,var(--red),rgba(206,17,38,.25));transform-origin:left center;
    box-shadow:0 0 14px -2px rgba(206,17,38,.6)}
  @media (max-width:820px){.psteps{grid-template-columns:1fr 1fr}}
  @media (max-width:480px){.psteps{grid-template-columns:1fr}}

  /* ---------- FAQ ---------- */
  .faq{padding:var(--s-5) 0}
  .faqlist{display:flex;flex-direction:column}
  .faqitem{border-bottom:1px solid var(--line);transition:background-color .3s var(--e-soft)}
  .faqitem:first-child{border-top:1px solid var(--line)}
  .faqh{margin:0;font-family:inherit;font-size:inherit;font-weight:inherit;line-height:inherit;color:inherit;text-transform:none;letter-spacing:normal}
  .faqq{width:100%;text-align:left;background:none;border:0;padding:1.3rem 0;display:flex;align-items:center;justify-content:space-between;gap:1rem;cursor:pointer;font-family:'Montserrat';font-weight:800;font-size:1rem;color:var(--ink);letter-spacing:-.005em;
    transition:color .2s var(--e-soft)}
  .faqq:hover{color:var(--red)}
  .faqq .plus{flex:none;width:22px;height:22px;position:relative;border-radius:50%;background:rgba(206,17,38,.07);transition:background-color .25s var(--e-soft),transform .38s var(--e-spring)}
  .faqq:hover .plus{background:rgba(206,17,38,.14)}
  .faqitem.open .plus{transform:rotate(180deg)}
  .faqq .plus::before,.faqq .plus::after{content:"";position:absolute;background:var(--red);top:50%;left:50%;transform:translate(-50%,-50%);border-radius:2px}
  .faqq .plus::before{width:11px;height:2px}
  .faqq .plus::after{width:2px;height:11px;transition:transform .3s var(--e-out)}
  .faqitem.open .plus::after{transform:translate(-50%,-50%) rotate(90deg) scaleY(0)}
  /* grid-template-rows removes the old max-height clip entirely */
  .faqa{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s var(--e-out)}
  .faqa-in{overflow:hidden;min-height:0}
  .faqa p{color:var(--muted);font-size:.98rem;padding-bottom:1.3rem;max-width:64ch}
  .faqitem.open .faqa{grid-template-rows:1fr}

  /* ---------- FINAL CTA (cinematic ink panel inside the cream field) ---------- */
  .finalcta{padding:var(--s-4) 0 var(--s-5);text-align:center}
  .cta-panel{position:relative;overflow:hidden;background-color:var(--ink);border:1px solid var(--line-dark);border-radius:var(--r-xl);
    padding:clamp(2.8rem,7vw,5rem) clamp(1.4rem,5vw,3rem);box-shadow:var(--el-4),0 50px 90px -34px rgba(25,25,25,.5);text-align:center}
  /* bloom centred on the headline (38% down), so it scales with the panel */
  .cta-panel::after{content:"";position:absolute;left:50%;top:38%;width:min(900px,145%);aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none;
    background:radial-gradient(circle,rgba(206,17,38,.28),rgba(206,17,38,.07) 40%,transparent 66%)}
  /* In a centered block the vertical tick reads as detached from the wrapped
     label, so here it becomes a short horizontal rule sitting above it. */
  .cta-panel .eyebrow{color:var(--cream);flex-direction:column;gap:.75rem}
  .cta-panel .eyebrow::before{width:26px;height:3px}
  .cta-panel h2{color:var(--cream);max-width:22ch;margin:0 auto 1.1rem}
  .cta-panel p{color:#C9C1B6;max-width:46ch;margin:0 auto var(--s-2);font-size:1.06rem}
  .cta-panel .btn--primary{box-shadow:var(--glow-red-lg),inset 0 1px 0 rgba(255,255,255,.26)}

  /* ---------- FOOTER ---------- */
  footer{background-color:var(--ink);color:#fff;padding:var(--s-4) 0 2.4rem}
  .foot-top{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:2.4rem;padding-bottom:var(--s-3);border-bottom:1px solid var(--line-dark)}
  /* h3, not h4 — the CTA above is an h2, so h4 would skip a level */
  .foot-top .fcol h3{font-family:'Montserrat';font-weight:800;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:1.1rem}
  .foot-top .fcol a{display:block;font-size:.88rem;color:#D8D0C6;margin-bottom:.7rem;transition:color .2s var(--e-soft)}
  /* contrast fix: the wordmark inherits --ink, which was invisible on the ink footer */
  footer .logo .w1{color:var(--cream);font-size:.9rem}
  .foot-top .fcol a:not(.logo){position:relative;width:fit-content}
  .foot-top .fcol a:not(.logo)::after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:1px;background:var(--red);transform:scaleX(0);transform-origin:left center;transition:transform .3s var(--e-out)}
  .foot-top .fcol a:hover{color:#fff}
  .foot-top .fcol a:not(.logo):hover::after{transform:scaleX(1)}
  .foot-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;padding-top:1.7rem}
  /* .42 measured 4.07:1 on ink; .5 clears AA for body text */
  .foot-legal{color:rgba(255,255,255,.5);font-size:.74rem;max-width:64ch;line-height:1.7}
  @media (max-width:820px){.foot-top{grid-template-columns:1fr 1fr}}
  @media (max-width:520px){.foot-top{grid-template-columns:1fr}}

  /* ---------- PERSISTENT WIDGET ---------- */
  .concierge{position:fixed;right:clamp(1rem,3vw,1.6rem);bottom:clamp(1rem,3vw,1.6rem);z-index:60;opacity:0;transform:translateY(14px) scale(.96);transition:opacity .55s var(--e-out),transform .6s var(--e-spring);pointer-events:none}
  .concierge.show{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
  .cbubble{display:flex;align-items:center;gap:.6rem;background:var(--ink);color:var(--cream);border:1px solid var(--line-dark);border-radius:999px;padding:.8em 1.1em .8em .9em;font-family:'Montserrat';font-weight:700;font-size:.76rem;letter-spacing:.01em;
    box-shadow:var(--el-ink);cursor:pointer;
    transition:transform .32s var(--e-spring),box-shadow .32s var(--e-out),border-color .25s var(--e-soft)}
  .cbubble:hover{transform:translateY(-3px);border-color:rgba(206,17,38,.4);box-shadow:var(--el-ink),0 0 40px -12px rgba(206,17,38,.55)}
  .cdot{width:8px;height:8px;border-radius:50%;background:var(--red);flex:none;box-shadow:0 0 0 4px rgba(206,17,38,.2),0 0 14px 2px rgba(206,17,38,.5)}
  .cpanel{display:none;position:absolute;right:0;bottom:calc(100% + .7rem);width:268px;
    background:rgba(255,255,255,.9);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);
    border:1px solid var(--line);border-radius:var(--r-lg);padding:1.15rem 1.2rem;box-shadow:var(--el-4)}
  .cpanel.open{display:block;animation:panelIn .38s var(--e-spring) both}
  @keyframes panelIn{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}
  .cpanel-head{display:flex;align-items:center;justify-content:space-between;font-family:'Montserrat';font-weight:800;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.75rem}
  .cpanel-head button{background:none;border:0;font-size:1.1rem;line-height:1;color:var(--muted);cursor:pointer;transition:color .2s var(--e-soft)}
  .cpanel-head button:hover{color:var(--red)}
  .cpanel p{font-size:.88rem;color:var(--ink-soft);margin-bottom:.95rem;max-width:none}
  @media (max-width:480px){.cpanel{width:min(78vw,268px)}}

  /* ---------- FOCUS: two-tone ring, readable on cream AND on ink ---------- */
  :focus-visible{outline:2px solid var(--red);outline-offset:3px;border-radius:3px;
    box-shadow:0 0 0 5px rgba(206,17,38,.22)}
  .hero :focus-visible,.mech :focus-visible,.market :focus-visible,.cases :focus-visible,
  .process :focus-visible,.cta-panel :focus-visible,footer :focus-visible,.cbubble:focus-visible,.annbar :focus-visible{
    box-shadow:0 0 0 5px rgba(250,247,242,.34)}

  /* ---------- SCROLL-DRIVEN ANIMATIONS (progressive enhancement) ----------
     IntersectionObserver reveals stay the baseline; these only add per-element
     polish where a browser supports view() timelines. Applied to CHILD elements
     so they never fight the .reveal transform on their parents. */
  @supports (animation-timeline: view()){
    @media (prefers-reduced-motion:no-preference){
      .leak .icon-badge{animation:sdBadge linear both;animation-timeline:view();animation-range:entry 6% entry 46%}
      .pstep::before{animation:sdRail linear both;animation-timeline:view();animation-range:entry 4% entry 42%}
      .marker .dot{animation:sdMarker linear both;animation-timeline:view();animation-range:entry 10% entry 58%}
      .snap-chrome span{animation:sdChrome linear both;animation-timeline:view();animation-range:entry 8% entry 40%}
    }
  }
  @keyframes sdBadge{from{opacity:0;transform:scale(.72)}to{opacity:1;transform:scale(1)}}
  @keyframes sdRail{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes sdMarker{from{opacity:0;transform:scale(.35)}to{opacity:1;transform:scale(1)}}
  @keyframes sdChrome{from{opacity:0}to{opacity:1}}

  @media (prefers-reduced-motion:reduce){
    /* `*` does not match pseudo-elements, so they need their own reset — several
       of the ambient loops (ping rings, sheens, drips) live on ::before/::after. */

  .navlinks{display:flex;align-items:center;gap:2rem}
  .navlinks a{position:relative;font-family:'Montserrat';font-weight:700;font-size:.76rem;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);transition:color .2s var(--e-soft)}
  .navlinks a:hover{color:var(--ink)}
  /* `.navlinks a` outranks `.btn--primary`, which left the nav CTA with ink text
     on red (2.1:1). Keep the button's white label. */
  .navlinks a.btn--primary,.navlinks a.btn--primary:hover{color:#fff}
  /* active-section indicator + hover rail */
  .navlinks a[href^="#"]::after{content:"";position:absolute;left:0;right:0;bottom:-7px;height:2px;border-radius:2px;background:var(--red);
    transform:scaleX(0);transform-origin:left center;transition:transform .34s var(--e-out)}
  .navlinks a[href^="#"]:hover::after,.navlinks a[href^="#"].active::after{transform:scaleX(1)}
  .navlinks a[href^="#"].active{color:var(--ink)}
  .newpill{display:inline-flex!important;align-items:center;gap:.4rem;background:rgba(206,17,38,.07);border:1px solid rgba(206,17,38,.22);border-radius:999px;padding:.4rem .8rem!important;color:var(--red)!important;
    transition:background-color .2s var(--e-soft),border-color .2s var(--e-soft),transform .28s var(--e-spring)}
  .newpill:hover{background:rgba(206,17,38,.12);border-color:rgba(206,17,38,.4);transform:translateY(-1px)}
  .newdot{width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 3px rgba(206,17,38,.16)}
  @media (max-width:900px){.newpill{display:none!important}}

  /* mobile: real functional drawer, not just hidden links */
  .navburger{display:none;flex:none;width:40px;height:40px;border:0;background:none;cursor:pointer;position:relative}
  .navburger span{position:absolute;left:8px;right:8px;height:2px;background:var(--ink);border-radius:2px;transition:transform .25s ease,opacity .2s ease}

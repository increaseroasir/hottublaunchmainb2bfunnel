    .hero h1,.hero .sub,.hero .btn,.hero .kicker2,.stage,.trust{opacity:1!important;transform:none!important}
    .pin,.bucket-glow,.water{opacity:1!important;transform:none!important}
    .reveal{opacity:1!important;transform:none!important;will-change:auto!important}
    .tlogos{animation:none!important}
    .leak .icon-badge,.marker .dot,.snap-chrome span{opacity:1!important;transform:none!important}
    .snap-row .bar i{transform:none!important}
    .pstep::before{transform:none!important}
    .guide-thumb{transform:none!important}
    .btn--primary::after{display:none}
    .cpanel.open{animation:none!important}
  }
</style>

<script is:inline>
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Mobile nav drawer — real toggle, not just hidden links.
  var burger = document.getElementById('navBurger');
  var navLinksEl = document.getElementById('navLinks');
  if (burger && navLinksEl){
    burger.addEventListener('click', function(){
      var isOpen = navLinksEl.classList.toggle('open');
      burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      burger.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });
    // Close the drawer after tapping any link inside it.
    navLinksEl.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        navLinksEl.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        burger.setAttribute('aria-label', 'Open menu');
      });
    });
  }

  // Stagger index: every .reveal gets --i from its position among reveal siblings,
  // so groups cascade automatically. The explicit .d1–.d4 classes still win.
  document.querySelectorAll('.reveal').forEach(function(el){
    var parent = el.parentNode;
    if (!parent || !parent.children) return;
    var n = 0;
    for (var k = 0; k < parent.children.length; k++){
      var sib = parent.children[k];
      if (sib.classList && sib.classList.contains('reveal')){
        if (sib === el){ el.style.setProperty('--i', String(n)); return; }
        n++;
      }
    }
  });

  // Scroll-triggered reveals — one behavior, applied everywhere, respects reduced motion.
  if (!reduceMotion && 'IntersectionObserver' in window){
    var els = document.querySelectorAll('.reveal');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:.15, rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
  }

  // Nav: scrolled state (denser + stronger blur) and active-section indicator.
  var stickyHead = document.getElementById('stickyHead');
  var navAnchors = {};
  document.querySelectorAll('.navlinks a[href^="#"]').forEach(function(a){
    var id = a.getAttribute('href').slice(1);
    if (id) navAnchors[id] = a;
  });
  var navSections = Object.keys(navAnchors).map(function(id){
    return document.getElementById(id);
  }).filter(Boolean);
  if (navSections.length && 'IntersectionObserver' in window){
    var navIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (!e.isIntersecting) return;
        var active = navAnchors[e.target.id];
        if (!active) return;
        Object.keys(navAnchors).forEach(function(k){ navAnchors[k].classList.remove('active'); });
        active.classList.add('active');
      });
    }, {rootMargin:'-45% 0px -50% 0px'});
    navSections.forEach(function(s){ navIO.observe(s); });
  }

  // Persistent widget: appears after the visitor scrolls past the hero, not on load.
  // One rAF-throttled scroll handler drives the widget, the nav state, and hero parallax.
  var conc = document.getElementById('concierge');
  var hero = document.querySelector('.hero');
  var shown = false;
  var scrollTicking = false;
  var hasIO = 'IntersectionObserver' in window;

  // Sentinels replace the per-frame scrollY read for the two threshold states.
  // A sentinel that stops intersecting with a negative top has passed above the
  // viewport, which is exactly the "scrolled past this point" signal we want.
  function watchSentinel(id, onPassed, once){
    var el = document.getElementById(id);
    if (!el || !hasIO) return false;
    var obs = new IntersectionObserver(function(entries){
      var e = entries[entries.length - 1];
      var passed = !e.isIntersecting && e.boundingClientRect.top < 0;
      onPassed(passed);
      if (passed && once) obs.disconnect();
    });
    obs.observe(el);
    return true;
  }
  var sentinelsLive = watchSentinel('topSentinel', function(passed){
    if (stickyHead) stickyHead.classList.toggle('scrolled', passed);
  }, false);
  sentinelsLive = watchSentinel('heroSentinel', function(passed){
    if (passed && !shown){ conc.classList.add('show'); shown = true; }
  }, true) && sentinelsLive;

  // Hero dot-grid depth is the only effect that needs a live scroll offset, so it
  // is gated on the hero actually being on screen. Past the hero, the scroll
  // handler does no layout reads at all.
  var heroOnScreen = true;
  if (hero && hasIO){
    new IntersectionObserver(function(entries){
      var wasOn = heroOnScreen;
      heroOnScreen = entries[entries.length - 1].isIntersecting;
      // The observer can land after the scroll frame that skipped the offset
      // update, which would leave the grid holding a stale parallax value.
      // Re-run one frame on re-entry so it always resyncs to the real offset.
      if (heroOnScreen && !wasOn) checkScroll();
    }, {rootMargin:'20% 0px 20% 0px'}).observe(hero);
  }

  function onScrollFrame(){
    scrollTicking = false;
    var needsOffset = heroGrid && !reduceMotion && heroOnScreen;
    if (!needsOffset && sentinelsLive) return;
    var y = window.scrollY;
    if (!sentinelsLive){
      // No IntersectionObserver: fall back to threshold checks off the offset.
      var vh = window.innerHeight;
      if (!shown && y > vh * 0.6){ conc.classList.add('show'); shown = true; }
      if (stickyHead) stickyHead.classList.toggle('scrolled', y > 12);
    }
    if (needsOffset){
      scrollShiftY = y * 0.08;
      applyGridTransform();
    }
  }
  function checkScroll(){
    if (!scrollTicking){
      scrollTicking = true;
      requestAnimationFrame(onScrollFrame);
    }
  }
  window.addEventListener('scroll', checkScroll, {passive:true});

  var cbtn = document.getElementById('cbubbleBtn');
  var cpanel = document.getElementById('cpanel');
  var cclose = document.getElementById('cpanelClose');
  function syncConcierge(){ cbtn.setAttribute('aria-expanded', cpanel.classList.contains('open') ? 'true' : 'false'); }
  cbtn.addEventListener('click', function(){ cpanel.classList.toggle('open'); syncConcierge(); });
  cclose.addEventListener('click', function(){ cpanel.classList.remove('open'); syncConcierge(); cbtn.focus(); });

  // Snapshot bars: animate from 0 once scrolled into view (feels like a live scan, not a static image).
  // Numeric scores count up alongside their bar; the final frame always restores
  // the exact original string, so the copy can never drift.
  var snapCard = document.getElementById('snapCard');
  function countUpScores(card){
    card.querySelectorAll('.sc').forEach(function(el, idx){
      var original = el.getAttribute('data-final') || el.textContent;
      el.setAttribute('data-final', original);
      var match = original.match(/^([0-9]+(?:\.[0-9]+)?)([\s\S]*)$/);
      if (!match) return;
      var target = parseFloat(match[1]);
      var decimals = (match[1].split('.')[1] || '').length;
      var suffix = match[2];
      var duration = 1250;
      var startedAt = null;
      function step(now){
        if (startedAt === null) startedAt = now;
        var p = Math.min(1, (now - startedAt) / duration);
        var eased = 1 - Math.pow(1 - p, 3);
        if (p < 1){
          el.textContent = (target * eased).toFixed(decimals) + suffix;
          requestAnimationFrame(step);
        } else {
          el.textContent = original;
        }
      }
      setTimeout(function(){ requestAnimationFrame(step); }, idx * 90);
    });
  }
  if (snapCard){
    if (reduceMotion || !('IntersectionObserver' in window)){
      snapCard.classList.add('animate');
    } else {
      var snapIO = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){
            snapCard.classList.add('animate');
            countUpScores(snapCard);
            snapIO.unobserve(e.target);
          }
        });
      }, {threshold:.4});
      snapIO.observe(snapCard);
    }
  }

  // Live scan timestamp — genuinely reflects "now" on each page load, not a fabricated stat.
  var scanEl = document.getElementById('scanTime');
  if (scanEl){
    var now = new Date();
    scanEl.textContent = 'Scanned ' + now.toLocaleTimeString([], {hour:'numeric', minute:'2-digit'}) + ' today';
  }

  // Phone demo: loop the conversation once visible, respecting reduced motion.
  var phone = document.getElementById('phoneDemo');
  if (phone){
    function playPhone(){
      phone.classList.remove('animate');
      void phone.offsetWidth; // restart CSS animations
      phone.classList.add('animate');
    }
    if (reduceMotion){
      phone.querySelectorAll('.bub,.bub-time').forEach(function(el){ el.style.opacity = 1; });
      var typ = phone.querySelector('.typing'); if (typ) typ.remove();
    } else if ('IntersectionObserver' in window){
      var phoneIO = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ playPhone(); setInterval(playPhone, 6500); phoneIO.unobserve(e.target); }
        });
      }, {threshold:.5});
      phoneIO.observe(phone);
    }
  }

  // FAQ accordion — same open/close behavior, now with aria state kept in sync.
  document.querySelectorAll('.faqitem').forEach(function(item){
    var q = item.querySelector('.faqq');
    q.addEventListener('click', function(){
      var wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faqitem.open').forEach(function(o){
        o.classList.remove('open');
        var ob = o.querySelector('.faqq');
        if (ob) ob.setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen){
        item.classList.add('open');
        q.setAttribute('aria-expanded', 'true');
      } else {
        q.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Hero cursor spotlight + parallax — desktop pointer only, skipped on touch and
  // reduced motion. Pointer moves are coalesced into a single rAF write per frame.
  var heroEl = document.querySelector('.hero');
  var spot = document.getElementById('heroSpot');
  var heroGrid = document.querySelector('.hero-grid');
  var clientX = 0, clientY = 0, pointerTicking = false;
  var gridShiftX = 0, gridShiftY = 0, scrollShiftY = 0;

  function applyGridTransform(){
    if (!heroGrid) return;
    heroGrid.style.transform = 'translate3d(' + gridShiftX.toFixed(2) + 'px,' +
      (gridShiftY + scrollShiftY).toFixed(2) + 'px,0)';
  }
  // The one geometry read lives here, not in the event handler, so a burst of
  // pointer events can never force more than one layout per frame.
  function applyPointerFrame(){
    pointerTicking = false;
    var r = heroEl.getBoundingClientRect();
    var x = clientX - r.left, y = clientY - r.top;
    if (spot){
      spot.style.setProperty('--mx', x + 'px');
      spot.style.setProperty('--my', y + 'px');
    }
    if (heroGrid && r.width && r.height){
      gridShiftX = (x / r.width - 0.5) * -20;
      gridShiftY = (y / r.height - 0.5) * -16;
      applyGridTransform();
    }
  }
  if (heroEl && spot && window.matchMedia('(pointer: fine)').matches && !reduceMotion){
    heroEl.addEventListener('mousemove', function(e){
      clientX = e.clientX;
      clientY = e.clientY;
      if (!pointerTicking){
        pointerTicking = true;
        requestAnimationFrame(applyPointerFrame);
      }
    }, {passive:true});
  }

  // Initial pass now that every element reference exists.
  checkScroll();
</script>
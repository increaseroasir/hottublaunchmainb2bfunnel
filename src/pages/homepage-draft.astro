        </svg>

        <!-- LIVE markers — real stores, positioned from their actual coordinates -->
        <div class="marker" style="left:40.2%;top:5.1%"><span class="dot"></span><span class="lab">Minot, ND — Live</span></div>
        <div class="marker" style="left:71%;top:27.3%"><span class="dot"></span><span class="lab">Rochester/Macomb, MI — Live</span></div>

        <!-- Exactly TEN open markers, on real metros (Seattle, Sacramento, Phoenix,
             Denver, Minneapolis, Dallas, Nashville, Atlanta, Charlotte, Philadelphia).
             Do not change this count: the page deliberately makes no numeric claim
             about how many territories are open. -->
        <div class="marker open" style="left:4.5%;top:7.6%"><span class="dot"></span><span class="lab">Open</span></div>
        <div class="marker open" style="left:5.9%;top:43.7%"><span class="dot"></span><span class="lab">Open</span></div>
        <div class="marker open" style="left:21.9%;top:64.2%"><span class="dot"></span><span class="lab">Open</span></div>
        <div class="marker open" style="left:33.9%;top:39%"><span class="dot"></span><span class="lab">Open</span></div>

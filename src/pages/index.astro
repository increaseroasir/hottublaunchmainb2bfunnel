  <script is:inline>
  // Mobile nav drawer — real toggle, not just hidden links.
  var burger = document.getElementById('navBurger');
  var navLinksEl = document.getElementById('navLinks');
  if (burger && navLinksEl){
    burger.addEventListener('click', function(){
      var isOpen = navLinksEl.classList.toggle('open');
      burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      burger.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });
    // Close the drawer after tapping any link inside it.
    navLinksEl.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        navLinksEl.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        burger.setAttribute('aria-label', 'Open menu');
      });
    });
  }

  // Scroll-triggered reveals — one behavior, applied everywhere, respects reduced motion.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window){
    var els = document.querySelectorAll('.reveal');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:.15, rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
  }

  // Persistent widget: appears after the visitor scrolls past the hero, not on load.
  var conc = document.getElementById('concierge');
  var shown = false;
  function checkScroll(){
    if (!shown && window.scrollY > window.innerHeight * 0.6){
      conc.classList.add('show');
      shown = true;
    }
  }
  window.addEventListener('scroll', checkScroll, {passive:true});
  checkScroll();

  var cbtn = document.getElementById('cbubbleBtn');
  var cpanel = document.getElementById('cpanel');
  var cclose = document.getElementById('cpanelClose');
  cbtn.addEventListener('click', function(){ cpanel.classList.toggle('open'); });
  cclose.addEventListener('click', function(){ cpanel.classList.remove('open'); });

  // Snapshot bars: animate from 0 once scrolled into view (feels like a live scan, not a static image).
  var snapCard = document.getElementById('snapCard');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (snapCard){
    if (reduceMotion || !('IntersectionObserver' in window)){
      snapCard.classList.add('animate');
    } else {
      var snapIO = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ snapCard.classList.add('animate'); snapIO.unobserve(e.target); }
        });
      }, {threshold:.4});
      snapIO.observe(snapCard);
    }
  }

  // Live scan timestamp — genuinely reflects "now" on each page load, not a fabricated stat.
  var scanEl = document.getElementById('scanTime');
  if (scanEl){
    var now = new Date();
    scanEl.textContent = 'Scanned ' + now.toLocaleTimeString([], {hour:'numeric', minute:'2-digit'}) + ' today';
  }

  // Phone demo: loop the conversation once visible, respecting reduced motion.
  var phone = document.getElementById('phoneDemo');
  if (phone){
    function playPhone(){
      phone.classList.remove('animate');
      void phone.offsetWidth; // restart CSS animations
      phone.classList.add('animate');
    }
    if (reduceMotion){
      phone.querySelectorAll('.bub,.bub-time').forEach(function(el){ el.style.opacity = 1; });
      var typ = phone.querySelector('.typing'); if (typ) typ.remove();
    } else if ('IntersectionObserver' in window){
      var phoneIO = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ playPhone(); setInterval(playPhone, 6500); phoneIO.unobserve(e.target); }
        });
      }, {threshold:.5});
      phoneIO.observe(phone);
    }
  }

  // FAQ accordion
  document.querySelectorAll('.faqitem').forEach(function(item){
    var q = item.querySelector('.faqq');
    q.addEventListener('click', function(){
      var wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faqitem.open').forEach(function(o){ o.classList.remove('open'); });
      if (!wasOpen) item.classList.add('open');
    });
  });

  // Hero cursor spotlight — desktop pointer only, skipped on touch and reduced motion.
  var heroEl = document.querySelector('.hero');
  var spot = document.getElementById('heroSpot');
  if (heroEl && spot && window.matchMedia('(pointer: fine)').matches){
    heroEl.addEventListener('mousemove', function(e){
      var r = heroEl.getBoundingClientRect();
      spot.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      spot.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  }
  </script>

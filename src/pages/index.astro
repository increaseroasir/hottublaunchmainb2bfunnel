---
import Layout from '../layouts/Layout.astro';
// B3: every CTA toward a form carries the current query string
const search = Astro.url.search;
---
<!--
  HOT TUB LAUNCH — FULL HOMEPAGE BUILD
  Sections: ANNOUNCEMENT BAR → NAV → HERO (animated bucket, marquee trust row)
            → WHY WE EXIST → MECHANISM (3 acts) → AUDIT SNAPSHOT (animated on scroll)
            → SEVEN LEAKS → AUTOMATION DEMO (live follow-up phone mockup)
            → ONE STORE PER MARKET → CASE STUDIES → GUIDE TEASER
            → PROCESS (what happens after you apply) → FAQ → FINAL CTA → FOOTER
  Motion: one orchestrated load sequence in the hero, scroll-triggered reveals
  throughout, animated data bars + looping phone demo once scrolled into view.
  Reduced-motion respected everywhere. No localStorage.

  TO WIRE LIVE:
   • Apply, playbook, case-study, and audit links are wired to their live routes.
   • Case-study numeric stats are still pending verified numbers.
   • The announcement uses generic scarcity (no city) until a specific market is promoted.
   • The map band uses two REAL markers (Paradise Spas, The Hot Tub Store)
     and unlabeled "open" markers — do not add a market count unless you
     can defend the exact number on a discovery call.
-->
<Layout
  title="Hot Tub Launch — One Store Per Market"
  description="One hot tub store per market, by application. We find every leak in your online presence, seal it, then pour fuel — so the buyers you've already earned stop slipping away."
>
  <meta name="theme-color" content="#191919" />

  <style is:global>
  :root{
    --cream:#FAF7F2; --paper:#FFFFFF; --ink:#191919; --ink-2:#211E1C;
    --ink-soft:#3A3532; --muted:#6E655F; --muted-dark:#A79F97;
    --red:#CE1126; --red-dark:#A80E1F; --line:#E7E0D6; --line-dark:rgba(250,247,242,.14);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  section[id]{scroll-margin-top:104px}
  ::selection{background:rgba(206,17,38,.22);color:var(--ink)}
  ::-webkit-scrollbar{width:11px}
  ::-webkit-scrollbar-track{background:var(--cream)}
  ::-webkit-scrollbar-thumb{background:var(--muted-dark);border-radius:6px;border:2px solid var(--cream)}
  ::-webkit-scrollbar-thumb:hover{background:var(--red)}
  html{scrollbar-color:var(--muted-dark) var(--cream)}
  body{background:var(--cream);color:var(--ink-soft);font-family:'Manrope',system-ui,sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  h1,h2,h3{font-family:'Montserrat',sans-serif;color:var(--ink);text-transform:uppercase;line-height:1.05;font-weight:900}
  h2{font-size:clamp(1.6rem,3.4vw,2.5rem);letter-spacing:-.015em}
  h3{font-size:1.15rem;font-weight:800}
  p{max-width:64ch}
  .red{color:var(--red)}
  .wrap{max-width:1080px;margin-inline:auto;padding-inline:clamp(1.2rem,4vw,2.5rem)}
  .eyebrow{display:inline-flex;align-items:center;gap:.6rem;font-family:'Montserrat';font-weight:700;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);margin-bottom:1.1rem}
  .eyebrow::before{content:"";width:3px;height:1.05em;background:var(--red);flex:none}
  .eyebrow.on-ink{color:var(--cream)}

  .btn{display:inline-flex;align-items:center;gap:.6rem;font-family:'Montserrat';font-weight:800;font-size:.82rem;letter-spacing:.05em;text-transform:uppercase;padding:1.05em 1.9em;border-radius:4px;border:0;cursor:pointer;transition:.15s;line-height:1}
  .btn--primary{background:var(--red);color:#fff;box-shadow:0 14px 30px rgba(206,17,38,.28)}
  .btn--primary:hover{background:var(--red-dark);transform:translateY(-2px)}
  .btn--outline{background:transparent;border:2px solid var(--ink);color:var(--ink)}
  .btn--outline.on-ink{border-color:rgba(250,247,242,.5);color:var(--cream)}
  .btn .arrow{display:inline-flex;transition:transform .2s ease}
  .btn:hover .arrow{transform:translateX(4px)}

  /* ---------- ANNOUNCEMENT BAR ---------- */
  .stickyhead{position:sticky;top:0;z-index:51}
  .annbar{background:var(--ink);color:var(--cream);text-align:center;padding:.55rem 1rem;font-family:'Montserrat';font-weight:700;font-size:.72rem;letter-spacing:.04em;flex-wrap:wrap}
  .annbar a{color:var(--cream);border-bottom:1px solid var(--red);padding-bottom:1px;white-space:nowrap;margin-left:.6rem}
  .annbar .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);margin-right:.5rem;vertical-align:middle}

  /* ---------- NAV ---------- */
  nav.topnav{position:relative;z-index:50;background:rgba(250,247,242,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .navrow{display:flex;align-items:center;justify-content:space-between;padding:.9rem clamp(1.2rem,4vw,2.5rem)}
  .logo{display:flex;align-items:center;gap:.55rem}
  .logo .mk{width:30px;height:30px}
  .logo .w1{display:block;font-family:'Montserrat';font-weight:800;font-size:.82rem;letter-spacing:.02em;color:var(--ink);text-transform:uppercase;line-height:.85}
  .logo .w2{display:block;font-family:'Montserrat';font-weight:700;font-size:.56rem;letter-spacing:.38em;color:var(--red);text-transform:uppercase;margin-top:2px}
  .navlinks{display:flex;align-items:center;gap:2rem}
  .navlinks a{font-family:'Montserrat';font-weight:700;font-size:.76rem;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft)}
  .navlinks a:hover{color:var(--ink)}
  .newpill{display:inline-flex!important;align-items:center;gap:.4rem;background:rgba(206,17,38,.07);border:1px solid rgba(206,17,38,.22);border-radius:999px;padding:.4rem .8rem!important;color:var(--red)!important}
  .newdot{width:6px;height:6px;border-radius:50%;background:var(--red)}
  @media (max-width:900px){.newpill{display:none!important}}

  /* mobile: real functional drawer, not just hidden links */
  .navburger{display:none;flex:none;width:40px;height:40px;border:0;background:none;cursor:pointer;position:relative}
  .navburger span{position:absolute;left:8px;right:8px;height:2px;background:var(--ink);border-radius:2px;transition:transform .25s ease,opacity .2s ease}
  .navburger span:nth-child(1){top:14px}
  .navburger span:nth-child(2){top:20px}
  .navburger span:nth-child(3){top:26px}
  .navburger[aria-expanded="true"] span:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .navburger[aria-expanded="true"] span:nth-child(2){opacity:0}
  .navburger[aria-expanded="true"] span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

  @media (max-width:760px){
    .navburger{display:block}
    .navlinks{position:absolute;top:100%;left:0;right:0;background:var(--cream);
      flex-direction:column;align-items:stretch;gap:0;padding:.5rem 1.2rem 2rem;
      max-height:calc(100vh - 90px);overflow-y:auto;
      transform:translateY(-8px);opacity:0;pointer-events:none;transition:opacity .2s ease,transform .2s ease;
      border-top:1px solid var(--line);box-shadow:0 20px 30px rgba(25,25,25,.12)}
    .navlinks.open{opacity:1;transform:translateY(0);pointer-events:auto}
    .navlinks a{width:100%;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.85rem}
    .navlinks a.newpill{display:flex!important;border:1px solid rgba(206,17,38,.22);border-radius:8px;margin:1rem 0 0;padding:.9rem 1rem!important}
    .navlinks a.navcta{margin-top:1rem;justify-content:center;border:0}
  }

  /* ---------- REVEAL ---------- */
  .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:translateY(0)}
  .reveal.d1{transition-delay:.08s}.reveal.d2{transition-delay:.16s}.reveal.d3{transition-delay:.24s}.reveal.d4{transition-delay:.32s}

  /* ---------- HERO ---------- */
  .hero{position:relative;overflow:hidden;background:var(--ink);padding:clamp(3rem,7vw,5.5rem) clamp(1.2rem,4vw,2.5rem) clamp(3.5rem,7vw,5.5rem);display:flex;flex-direction:column;align-items:center;text-align:center}
  .hero::before{content:"";position:absolute;inset:0;background:
      radial-gradient(55% 40% at 50% 4%, rgba(206,17,38,.19), transparent 60%),
      radial-gradient(45% 32% at 88% 62%, rgba(206,17,38,.09), transparent 65%),
      radial-gradient(40% 30% at 8% 70%, rgba(224,169,98,.07), transparent 65%);
    pointer-events:none}
  .hero-grid{position:absolute;right:-40px;bottom:-40px;width:340px;height:340px;pointer-events:none;
    background-image:radial-gradient(rgba(250,247,242,.14) 1px, transparent 1px);background-size:22px 22px;
    -webkit-mask-image:radial-gradient(circle at 70% 70%, #000 0%, transparent 72%);
    mask-image:radial-gradient(circle at 70% 70%, #000 0%, transparent 72%)}
  .hero-spot{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .3s ease;
    background:radial-gradient(280px circle at var(--mx,50%) var(--my,20%), rgba(250,247,242,.05), transparent 70%)}
  .hero:hover .hero-spot{opacity:1}
  .hero .kicker2{position:relative;display:block;font-family:'Montserrat';font-weight:800;font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;color:var(--red);margin-bottom:1rem;opacity:0;animation:rise .7s .04s ease forwards}
  .hero h1{position:relative;font-size:clamp(2rem,5vw,3.5rem);max-width:20ch;color:var(--cream);opacity:0;animation:rise .8s .16s ease forwards}
  .hero .sub{position:relative;color:#B9B1A7;font-size:clamp(1rem,1.6vw,1.15rem);max-width:46ch;margin:1.25rem 0 1.9rem;font-weight:500;opacity:0;animation:rise .8s .28s ease forwards}
  .hero .btn{position:relative;opacity:0;animation:rise .8s .4s ease forwards}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}

  .stage{position:relative;width:100%;max-width:780px;margin-top:clamp(2rem,6vw,3.4rem);opacity:0;animation:rise 1s .52s ease forwards;
    display:grid;grid-template-columns:minmax(108px,1fr) minmax(120px,180px) minmax(108px,1fr);
    grid-template-rows:auto auto;align-items:center;column-gap:clamp(8px,3vw,20px);row-gap:clamp(14px,4vw,28px)}

  .bucket-wrap{grid-column:2;grid-row:1/3;justify-self:center;width:100%;max-width:180px;aspect-ratio:190/230;filter:drop-shadow(0 22px 30px rgba(0,0,0,.45))}
  svg.bucket{width:100%;height:100%;overflow:visible}
  .bucket-glow{animation:glowPulse 3.4s ease-in-out infinite}
  @keyframes glowPulse{0%,100%{opacity:.55}50%{opacity:1}}
  .pin{transform-box:fill-box;transform-origin:bottom center;animation:pinPulse 3.4s ease-in-out infinite}
  .pin2{animation-delay:.5s}.pin3{animation-delay:1s}
  @keyframes pinPulse{0%,100%{opacity:.6}50%{opacity:1}}

  .fcard{position:relative;background:linear-gradient(165deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
    border:1px solid rgba(250,247,242,.1);border-radius:14px;padding:clamp(.7rem,2.4vw,1rem) clamp(.7rem,2.6vw,1.15rem);
    box-shadow:0 24px 48px rgba(0,0,0,.45);text-align:left;backdrop-filter:blur(10px);
    animation:float 5.5s ease-in-out infinite}
  .fcard .icon{width:clamp(28px,7vw,38px);height:clamp(28px,7vw,38px);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:.6rem;
    background:radial-gradient(circle at 32% 28%, rgba(206,17,38,.32), rgba(206,17,38,.05));border:1px solid rgba(206,17,38,.3)}
  .fcard .icon svg{width:60%;height:60%}
  .fcard .lab{font-family:'Montserrat';font-weight:800;font-size:clamp(.52rem,1.6vw,.6rem);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:.3rem}
  .fcard .val{font-family:'Montserrat';font-weight:900;font-size:clamp(.82rem,2.6vw,1.05rem);color:var(--cream)}
  .fcard .val .arrow{color:var(--muted-dark);font-weight:700;margin:0 .25em;font-size:.85em}
  .fcard .val .win{color:#F0475C}
  .fcard .cap{font-size:clamp(.66rem,2vw,.78rem);color:var(--muted-dark);margin-top:.25rem}

  /* per-card connector: a short line + dot pointing toward the bucket column, scales with the grid instead of fixed SVG coordinates */
  .fcard .connect{position:absolute;top:50%;width:clamp(10px,2.6vw,26px);height:2px;background:linear-gradient(90deg,rgba(250,247,242,.05),rgba(250,247,242,.32));transform:translateY(-50%)}
  .fcard .connect::after{content:"";position:absolute;top:50%;width:5px;height:5px;border-radius:50%;background:var(--red);transform:translateY(-50%)}
  .c1 .connect,.c3 .connect{right:-1px;transform:translate(100%,-50%)}
  .c1 .connect::after,.c3 .connect::after{right:-2.5px}
  .c2 .connect,.c4 .connect{left:-1px;transform:translate(-100%,-50%)}
  .c2 .connect::after,.c4 .connect::after{left:-2.5px}

  .c1{grid-column:1;grid-row:1;animation-delay:.2s}
  .c3{grid-column:1;grid-row:2;animation-delay:.6s}
  .c2{grid-column:3;grid-row:1;animation-delay:1.1s}
  .c4{grid-column:3;grid-row:2;animation-delay:1.6s}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}

  @media (max-width:400px){
    .stage{grid-template-columns:minmax(96px,1fr) minmax(96px,140px) minmax(96px,1fr);column-gap:6px}
  }
  .trust{position:relative;margin-top:clamp(2.2rem,6vw,3rem);opacity:0;animation:rise .8s .78s ease forwards}
  .trust .tlab{font-family:'Montserrat';font-weight:700;font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:.9rem}
  .tlogos-wrap{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .tlogos{display:flex;gap:2.6rem;width:max-content;animation:marquee 18s linear infinite}
  .tlogos span{font-family:'Montserrat';font-weight:800;font-size:.9rem;color:rgba(250,247,242,.55);text-transform:uppercase;white-space:nowrap}
  @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ---------- WHY WE EXIST ---------- */
  .why{padding:clamp(3.5rem,7vw,6rem) 0}
  .why .grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,3.5rem);align-items:start}
  .why p{font-size:1.06rem;color:var(--ink-soft);margin-bottom:1.1rem}
  .why p:last-child{margin-bottom:0}
  .why .kicker{font-family:'Montserrat';font-weight:800;font-size:1.05rem;color:var(--ink);text-transform:none}
  @media (max-width:820px){.why .grid{grid-template-columns:1fr}}

  /* ---------- MECHANISM ---------- */
  .mech{background:var(--ink);padding:clamp(3.5rem,7vw,6rem) 0;color:var(--cream)}
  .mech h2{color:var(--cream)}
  .mech .lede{color:#C9C1B6;font-size:clamp(1rem,1.6vw,1.15rem);max-width:56ch;margin:1rem 0 2.2rem;font-weight:500}
  .acts{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
  .act{background:rgba(250,247,242,.05);border:1px solid var(--line-dark);border-radius:8px;padding:1.7rem 1.6rem}
  .act .n{font-family:'Montserrat';font-weight:900;font-size:1.7rem;color:var(--red);line-height:1;margin-bottom:.6rem}
  .act h3{color:var(--cream);margin-bottom:.5rem}
  .act p{color:#B9B1A7;font-size:.98rem;max-width:none}
  .mech .callout{border-left:3px solid var(--red);padding:.4rem 0 .4rem 1.2rem;margin-top:2rem;color:#D8D0C6;font-size:1.03rem}
  .mech .callout b{color:var(--cream)}
  @media (max-width:820px){.acts{grid-template-columns:1fr}}

  /* ---------- AUDIT SNAPSHOT (repeated data-viz moment) ---------- */
  .snapshot{padding:clamp(3rem,6vw,4.5rem) 0}
  .snap-card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:clamp(1.6rem,4vw,2.4rem);box-shadow:0 24px 50px rgba(25,25,25,.06)}
  .snap-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.8rem;margin-bottom:1.4rem;padding-bottom:1.2rem;border-bottom:1px solid var(--line)}
  .snap-head .t{font-family:'Montserrat';font-weight:800;font-size:.95rem;text-transform:uppercase;color:var(--ink)}
  .snap-head .badge{font-family:'Montserrat';font-weight:700;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--red);background:rgba(206,17,38,.07);border:1px solid rgba(206,17,38,.25);border-radius:4px;padding:.35rem .7rem}
  .snap-rows{display:flex;flex-direction:column;gap:1rem}
  .snap-row{display:grid;grid-template-columns:1fr auto auto;gap:1rem;align-items:center}
  .snap-row .nm{font-family:'Montserrat';font-weight:700;font-size:.88rem;color:var(--ink-soft)}
  .snap-row .bar{grid-column:1/-1;height:6px;border-radius:4px;background:var(--line);overflow:hidden;position:relative}
  .snap-row .bar i{position:absolute;left:0;top:0;bottom:0;background:var(--red);border-radius:4px;width:var(--w,20%)}
  .snap-row .sc{font-family:'Montserrat';font-weight:900;font-size:1rem;color:var(--ink);text-align:right}
  @media (max-width:560px){.snap-row{grid-template-columns:1fr auto}}

  /* ---------- SEVEN LEAKS ---------- */
  .leaks{padding:clamp(3.5rem,7vw,6rem) 0}
  .leaks .lede{font-size:clamp(1rem,1.6vw,1.15rem);color:var(--ink-soft);max-width:56ch;margin:1rem 0 2.2rem;font-weight:500}
  .leaklist{display:flex;flex-direction:column}
  .leak{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;padding:1.15rem 0;border-bottom:1px solid var(--line);align-items:flex-start}
  .leak:first-child{border-top:1px solid var(--line)}
  .leak .icon-badge{width:44px;height:44px;border-radius:9px;background:rgba(206,17,38,.07);border:1px solid rgba(206,17,38,.18);display:flex;align-items:center;justify-content:center;flex:none}
  .leak .leaknum{font-family:'Montserrat';font-weight:800;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:.3rem;display:block}
  .leak h3{margin-bottom:.3rem}
  .leak p{color:var(--muted);font-size:.98rem}

  /* ---------- ONE STORE PER MARKET ---------- */
  .market{background:var(--ink);padding:clamp(3.5rem,7vw,6rem) 0;color:var(--cream)}
  .market h2{color:var(--cream)}
  .market .lede{color:#C9C1B6;font-size:clamp(1rem,1.6vw,1.15rem);max-width:56ch;margin:1rem 0 2.4rem;font-weight:500}
  .mapband{position:relative;border:1px solid var(--line-dark);border-radius:10px;background:rgba(250,247,242,.03);padding:clamp(1.6rem,4vw,2.6rem);display:flex;align-items:center;justify-content:center;overflow:hidden}
  .mapband::before{content:"";position:absolute;inset:0;background:radial-gradient(50% 60% at 50% 40%,rgba(206,17,38,.08),transparent 70%)}
  .usdots{position:relative;width:100%;max-width:680px;aspect-ratio:700/380}
  .usmap{position:absolute;inset:0;width:100%;height:100%}
  .usmap path{fill:rgba(250,247,242,.035);stroke:rgba(250,247,242,.32);stroke-width:1.6;stroke-linejoin:round}
  .marker{position:absolute;display:flex;flex-direction:column;align-items:center;gap:.4rem;transform:translate(-50%,-50%)}
  .marker .dot{width:11px;height:11px;border-radius:50%;background:var(--red);box-shadow:0 0 0 6px rgba(206,17,38,.18)}
  .marker.open .dot{width:8px;height:8px;background:transparent;border:2px solid rgba(250,247,242,.4);box-shadow:none}
  .marker .lab{font-family:'Montserrat';font-weight:800;font-size:.62rem;letter-spacing:.03em;text-transform:uppercase;color:var(--cream);white-space:nowrap;background:rgba(25,25,25,.82);padding:.22rem .5rem;border-radius:4px}
  .marker.open .lab{color:var(--muted-dark);background:transparent;padding:0;font-size:.58rem}
  .market .keyrow{display:flex;gap:2rem;justify-content:center;margin-top:1.4rem;flex-wrap:wrap}
  .market .keyrow div{display:flex;align-items:center;gap:.5rem;font-family:'Montserrat';font-weight:700;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-dark)}
  .market .keyrow .sw{width:10px;height:10px;border-radius:50%;background:var(--red)}
  .market .keyrow .sw.open{background:transparent;border:2px solid rgba(250,247,242,.35)}
  @media (max-width:520px){.marker.open .lab{display:none}}

  /* ---------- CASE STUDIES ---------- */
  .cases{background:var(--ink);padding:clamp(3.5rem,7vw,6rem) 0;color:var(--cream)}
  .cases h2{color:var(--cream)}
  .cases .lede{color:#C9C1B6;font-size:clamp(1rem,1.6vw,1.15rem);max-width:56ch;margin:1rem 0 2.2rem;font-weight:500}
  .case-row{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  .case-card{background:rgba(250,247,242,.05);border:1px solid var(--line-dark);border-radius:10px;padding:1.7rem 1.6rem}
  .case-card .tag{display:inline-block;font-family:'Montserrat';font-weight:700;font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-dark);border:1px solid var(--line-dark);border-radius:3px;padding:.3rem .6rem;margin-bottom:1rem}
  .case-card .stat{font-family:'Montserrat';font-weight:900;font-size:2.2rem;color:var(--red);line-height:1}
  .case-card .stat.case-label{font-size:1.2rem;letter-spacing:.06em;text-transform:uppercase}
  .case-card .statlab{font-size:.92rem;color:#C9C1B6;margin:.5rem 0 1.1rem}

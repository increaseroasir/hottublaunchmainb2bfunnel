  <script>
    // Daily chart data — verbatim from the source dashboard.
    const daily = [
      {d:'1',imp:6685,users:149},{d:'2',imp:6220,users:159},{d:'3',imp:8961,users:150},
      {d:'4',imp:9173,users:106},{d:'5',imp:12304,users:171},{d:'6',imp:10612,users:163},
      {d:'7',imp:11336,users:142},{d:'8',imp:14458,users:203},{d:'9',imp:23764,users:259},
      {d:'10',imp:22940,users:230},{d:'11',imp:34591,users:270},{d:'12',imp:37363,users:262},
      {d:'13',imp:4038,users:61},{d:'14',imp:4254,users:49},{d:'15',imp:10734,users:164},
      {d:'16',imp:63030,users:772},{d:'17',imp:76144,users:966},{d:'18',imp:61872,users:677},
      {d:'19',imp:68088,users:630},{d:'20',imp:67508,users:587},{d:'21',imp:65649,users:800},
      {d:'22',imp:81359,users:772},{d:'23',imp:67558,users:625},{d:'24',imp:55488,users:586},
      {d:'25',imp:1598,users:313},
    ];
    const maxI = Math.max(...daily.map((x) => x.imp));
    const maxU = Math.max(...daily.map((x) => x.users));
    const bars = document.getElementById('pdBars');
    if (bars instanceof HTMLElement) {
      for (const x of daily) {
        const col = document.createElement('div');
        col.className = 'pd-barcol';
        const stack = document.createElement('div');
        stack.className = 'pd-barstack';
        const bi = document.createElement('div');
        bi.className = 'pd-bar';
        bi.style.height = Math.max(3, (x.imp / maxI) * 110) + 'px';
        bi.title = `Jul ${x.d} — ${x.imp.toLocaleString()} impressions`;
        const bu = document.createElement('div');
        bu.className = 'pd-bar users';
        bu.style.height = Math.max(2, (x.users / maxU) * 110) + 'px';
        bu.title = `Jul ${x.d} — ${x.users} website users`;
        const lbl = document.createElement('div');
        lbl.className = 'pd-barlbl';
        lbl.textContent = x.d;
        // @ts-expect-error Cloudflare's append overload rejects DOM nodes; browsers accept them.
        stack.append(bi, bu);
        // @ts-expect-error Cloudflare's append overload rejects DOM nodes; browsers accept them.
        col.append(stack, lbl);
        bars.appendChild(col);
      }
    }

    // Reveal on scroll: cards fade up, feed lines type in sequence, bars grow.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        if (e.target.id === 'pdFeed') {
          const lines = e.target.querySelectorAll('li');
          lines.forEach((li, i) => {
            window.setTimeout(() => li.classList.add('in'), i * 260);
          });
        } else {
          e.target.classList.add('in');
        }
      }
    }, { threshold: 0.2 });
    document.querySelectorAll('.pd-reveal, .pd-bars, #pdFeed').forEach((el) => io.observe(el));
  </script>

---
// Paradise Spas — Fair Season 2026, reframed as an HTL agent-ops deployment
// report. Astro port of paradise-FULL-tracking-dashboard.html; every number is
// carried over verbatim (sources kept in the footer). Dark command-center
// theme built from global.css tokens only (ink/cream/red + rgba derivatives).
// Client-data page: noindex + robots.txt disallow. No lead form.
import Layout from '../layouts/Layout.astro';

const AGENTS = [
  { id: 'SCOUT-01', role: 'Creative testing', task: 'Iterated 5 video variants through fair season', metric: '23 leads @ $6 CPL on the lead winner' },
  { id: 'PILOT-02', role: 'Media deployment', task: 'Deployed $13,108 across Meta · scaled 6× on fair open', metric: '825.7K impressions served' },
  { id: 'BEACON-03', role: 'Organic amplification', task: 'Rode the fair-floor content wave', metric: '109K views on top post · organic up 1,800%' },
  { id: 'VAULT-04', role: 'Attribution & leads', task: 'Tracked every click to the lead vault', metric: '338 leads · 268 Meta-attributed' },
];

const GROWTH = [
  { label: 'Views', was: '229K', now: '947K', desc: 'Total content views — up 313.5%', agent: 'BEACON-03' },
  { label: 'Audience', was: '93K', now: '201K', desc: 'Unique viewers — up 115%', agent: 'PILOT-02' },
  { label: 'Engagement', was: '76', now: '756', desc: 'Content interactions — up 895%', agent: 'SCOUT-01' },
  { label: 'Organic', was: '1.1K', now: '21.4K', desc: 'Organic views — up 1,800%', agent: 'BEACON-03' },
];

const ADS = [
  { label: 'Reach · Impressions', value: '825.7K', desc: 'Ad impressions served' },
  { label: 'Reach · Ad views', value: '845.3K', desc: 'Views on paid creative' },
  { label: 'Action · Link clicks', value: '7.0K', desc: 'Clicks through to the website' },
  { label: 'Action · Landing views', value: '6.8K', desc: 'Landing page views from ads' },
  { label: 'Video · Plays', value: '272.8K', desc: 'Total video plays from ads' },
  { label: 'Video · 3-second', value: '44.6K', was: '27.8K', desc: 'Insights 3-sec views — up 60%' },
  { label: 'Social · Page likes', value: '+27', desc: 'New Facebook page likes from ads' },
  { label: 'Social · Engagements', value: '112.9K', desc: 'Page engagements driven by ads' },
];

const SITE = [
  { label: 'Site · Visitors', value: '8,639', desc: 'Total website visitors' },
  { label: 'Site · Sessions', value: '9,862', desc: 'Sessions on the website' },
  { label: 'Site · Page views', value: '12,349', desc: 'Pages viewed this fair season' },
  { label: 'Site · Key events', value: '995', desc: 'GA4 key conversion events' },
];

const LEADS = [
  { label: 'Leads · Website', value: '338', desc: 'Website form leads captured' },
  { label: 'Leads · Meta', value: '268', desc: 'Meta-attributed website leads' },
  { label: 'Efficiency · CPL', value: '~$39', desc: 'Blended cost per website lead' },
];

const CHANNELS = [
  ['Facebook / Instagram paid', '4,669', '4,975'],
  ['Direct', '3,169', '3,362'],
  ['Facebook / Instagram organic', '847', '893'],
  ['Google search', '237', '383'],
];

const PAGES = [
  ['State Fair inventory', '3,619', '3,337'],
  ['State Fair blowout sale', '1,922', '1,671'],
  ['Main inventory', '1,530', '1,211'],
  ['State Fair available inventory', '1,116', '1,047'],
  ['Homepage', '945', '576'],
];

const CREATIVES = [
  ['inside_c1_V1 (video)', '23', '$6'],
  ['test_winner_2_V1 (video)', '10', '$11'],
  ['test_winner_1_V1 (video)', '13', '$12'],
  ['test_winner_3_V2 (video)', '9', '$17'],
  ['rt_ad_7_V1 (warm)', '21', '$25'],
];

const POSTS = [
  ['ND State Fair Hot Tub Sale', '109K'],
  ['We’re out here at the State Fair…', '9.1K'],
  ['Sunday at the North Dakota State Fair…', '1.0K'],
  ['Don’t be the person who comes back…', '828'],
  ['DOORS ARE OPEN! Today is the DAY…', '812'],
];

const FEED = [
  ['07-01 08:00', 'VAULT-04', 'tracking online · GA4 + lead vault linked'],
  ['07-05 14:22', 'SCOUT-01', 'creative test running · inside_c1_V1 pulling ahead'],
  ['07-09 09:41', 'PILOT-02', 'budget shifted to inside_c1_V1 · CPL holding at $6'],
  ['07-13 06:00', 'PILOT-02', 'fair gap detected · spend floored, standing by'],
  ['07-16 07:30', 'PILOT-02', 'STATE FAIR LIVE · scaled 6× → 63.0K impressions today'],
  ['07-17 21:15', 'BEACON-03', '"ND State Fair Hot Tub Sale" post crosses 109K views'],
  ['07-22 11:03', 'VAULT-04', '300th website lead captured this period'],
  ['07-25 23:59', 'VAULT-04', 'final tally · 338 leads · ~$39 blended CPL'],
];
---

<Layout
  title="Paradise Spas × HTL Agent Ops — Fair Season 2026"
  description="Deployment report: HTL agents ran Paradise Spas fair season. 947K views, 338 leads, ~$39 CPL."
  pageClass="paradise"
  robots="noindex"
>
  <style is:global>
    body.paradise{
      margin:0;background:var(--ink);color:var(--cream);
      font-family:'Manrope',system-ui,sans-serif;line-height:1.55;
      background-image:
        radial-gradient(1100px 500px at 50% -10%,rgba(206,17,38,.14),transparent 65%),
        linear-gradient(rgba(250,247,242,.028) 1px,transparent 1px),
        linear-gradient(90deg,rgba(250,247,242,.028) 1px,transparent 1px);
      background-size:auto,52px 52px,52px 52px;
    }
    .paradise .mono{font-family:ui-monospace,'SF Mono',Menlo,monospace}
    .paradise h1,.paradise h2{color:var(--cream)}
    .paradise .wrap{max-width:1100px;margin-inline:auto;padding-inline:clamp(1.2rem,4vw,2.5rem)}
    .paradise .accent{color:var(--red)}

    /* ---------- command bar ---------- */
    .pd-cmd{
      position:sticky;top:0;z-index:10;
      background:rgba(25,25,25,.85);backdrop-filter:blur(10px);
      border-bottom:1px solid var(--line-dark);
    }
    .pd-cmd .wrap{
      display:flex;align-items:center;gap:1rem;padding-block:.6rem;
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.68rem;
      letter-spacing:.06em;color:var(--muted-dark);
    }
    .pd-cmd .sys{color:var(--cream);font-weight:700}
    .pd-cmd .sys b{color:var(--red)}
    .pd-cmd .right{margin-left:auto;display:flex;align-items:center;gap:1rem}
    .pd-led{
      display:inline-flex;align-items:center;gap:.4rem;color:var(--cream);
    }
    .pd-led::before{
      content:"";width:7px;height:7px;border-radius:50%;background:var(--red);
      box-shadow:0 0 8px rgba(206,17,38,.9);
    }
    @media (prefers-reduced-motion:no-preference){
      .pd-led::before{animation:pdBlink 1.6s var(--e-soft) infinite}
      @keyframes pdBlink{0%,100%{opacity:1}50%{opacity:.35}}
    }

    /* ---------- hero ---------- */
    .pd-hero{text-align:center;padding:clamp(3rem,7vw,5rem) 0 1.5rem}
    .pd-eyebrow{
      display:inline-flex;align-items:center;gap:.6rem;color:var(--red);
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.78rem;
      letter-spacing:.16em;text-transform:uppercase;margin-bottom:1.1rem;
    }
    .pd-eyebrow::before,.pd-eyebrow::after{content:"";width:26px;height:1px;background:rgba(206,17,38,.55)}
    .pd-hero h1{
      font-family:'Montserrat',sans-serif;font-weight:900;text-transform:uppercase;
      font-size:clamp(2.3rem,6.5vw,4.2rem);line-height:1.04;letter-spacing:-.03em;margin:0;
    }
    .pd-hero .sub{
      max-width:560px;margin:1.3rem auto 1.8rem;color:var(--muted-dark);font-size:1rem;
    }
    .pd-hero .sub b{color:var(--cream);font-weight:700}
    .pd-cta{
      display:inline-flex;align-items:center;gap:.6rem;background:var(--red);color:#fff;
      text-decoration:none;font-family:'Montserrat',sans-serif;font-weight:800;
      font-size:.85rem;letter-spacing:.05em;text-transform:uppercase;
      padding:1em 1.9em;border-radius:999px;
      box-shadow:0 0 0 1px rgba(206,17,38,.35),var(--glow-red);
      transition:transform .2s var(--e-out),box-shadow .2s var(--e-out);
    }
    .pd-cta:hover{transform:translateY(-2px);box-shadow:0 0 0 1px rgba(206,17,38,.5),var(--glow-red-lg)}

    /* ---------- neural hub diagram ---------- */
    .pd-diagram{position:relative;max-width:1100px;margin:2.5rem auto 0;padding:0 20px 40px}
    .pd-grid{
      display:grid;grid-template-columns:1fr minmax(200px,250px) 1fr;grid-template-rows:1fr 1fr;
      gap:28px 40px;align-items:center;position:relative;z-index:2;
    }
    .pd-grid .tl{grid-column:1;grid-row:1}
    .pd-grid .tr{grid-column:3;grid-row:1}
    .pd-grid .bl{grid-column:1;grid-row:2}
    .pd-grid .br{grid-column:3;grid-row:2}
    .pd-hubwrap{grid-column:2;grid-row:1/span 2;display:flex;align-items:center;justify-content:center;z-index:3}
    .pd-connectors{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}
    .pd-connectors path{stroke:var(--red);stroke-width:1.5;fill:none;opacity:.6;stroke-dasharray:7 7}
    .pd-connectors circle{fill:var(--red)}
    @media (prefers-reduced-motion:no-preference){
      .pd-connectors path{animation:pdDash 1.4s linear infinite}
      @keyframes pdDash{to{stroke-dashoffset:-14}}
    }
    .pd-hub{width:min(230px,30vw);aspect-ratio:1;position:relative;display:flex;align-items:center;justify-content:center}
    .pd-ring{
      position:absolute;inset:0;border-radius:50%;
      border:2px solid rgba(206,17,38,.35);
      box-shadow:0 0 60px rgba(206,17,38,.22),inset 0 0 40px rgba(206,17,38,.08);
    }
    .pd-ring-dash{
      position:absolute;inset:13%;border-radius:50%;
      border:1px dashed rgba(206,17,38,.45);
    }
    .pd-ring-dash::before{ /* orbiting node */
      content:"";position:absolute;top:-4px;left:50%;width:8px;height:8px;border-radius:50%;
      background:var(--red);box-shadow:0 0 10px rgba(206,17,38,.9);
    }
    @media (prefers-reduced-motion:no-preference){
      .pd-ring-dash{animation:pdSpin 22s linear infinite}
      @keyframes pdSpin{to{transform:rotate(360deg)}}
    }
    .pd-core{
      width:58%;aspect-ratio:1;border-radius:50%;z-index:2;
      background:radial-gradient(circle at 35% 30%,rgba(206,17,38,.35) 0%,rgba(25,25,25,.9) 60%,var(--ink) 100%);
      border:3px solid var(--red);
      box-shadow:0 0 40px rgba(206,17,38,.45),inset 0 -20px 40px rgba(206,17,38,.25);
      display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:10px;
    }
    .pd-core strong{
      font-family:'Montserrat',sans-serif;font-size:1.4rem;font-weight:900;color:var(--red);
      letter-spacing:-.02em;line-height:1;
    }
    .pd-core span{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.55rem;font-weight:700;
      letter-spacing:.1em;text-transform:uppercase;color:var(--muted-dark);margin-top:5px;
    }

    /* ---------- cards ---------- */
    .pd-card{
      background:var(--ink-2);border:1px solid var(--line-dark);border-radius:var(--r-lg);
      padding:20px 20px 16px;box-shadow:var(--el-ink);position:relative;overflow:hidden;
    }
    .pd-card::before{ /* top data-line */
      content:"";position:absolute;top:0;left:0;right:0;height:2px;
      background:linear-gradient(90deg,var(--red),transparent 70%);opacity:.7;
    }
    .pd-card .label{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.62rem;font-weight:700;
      letter-spacing:.12em;text-transform:uppercase;color:var(--muted-dark);margin-bottom:.6rem;
    }
    .pd-card .value{
      font-family:'Montserrat',sans-serif;font-size:clamp(1.3rem,2.4vw,1.7rem);font-weight:800;
      letter-spacing:-.02em;line-height:1.2;margin-bottom:.4rem;color:var(--cream);
    }
    .pd-card .value .now{color:var(--red)}
    .pd-card .value .arrow{color:var(--red)}
    .pd-card .desc{font-size:.8rem;color:var(--muted-dark);line-height:1.4}
    .pd-card .who{
      display:inline-block;margin-top:.7rem;font-family:ui-monospace,'SF Mono',Menlo,monospace;
      font-size:.58rem;letter-spacing:.08em;color:var(--red);
      border:1px solid rgba(206,17,38,.4);border-radius:99px;padding:.2rem .55rem;
    }

    /* ---------- agents roster ---------- */
    .pd-agents{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .pd-agent{
      background:var(--ink-2);border:1px solid var(--line-dark);border-radius:var(--r-lg);
      padding:18px;position:relative;
    }
    .pd-agent .id{
      display:flex;align-items:center;gap:.5rem;
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.72rem;font-weight:700;
      letter-spacing:.1em;color:var(--cream);margin-bottom:.35rem;
    }
    .pd-agent .id::before{
      content:"";width:7px;height:7px;border-radius:50%;background:var(--red);
      box-shadow:0 0 8px rgba(206,17,38,.9);
    }
    .pd-agent .role{
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.72rem;
      letter-spacing:.08em;text-transform:uppercase;color:var(--red);margin-bottom:.6rem;
    }
    .pd-agent .task{font-size:.78rem;color:var(--muted-dark);margin-bottom:.6rem}
    .pd-agent .metric{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.66rem;color:var(--cream);
      border-top:1px solid var(--line-dark);padding-top:.6rem;letter-spacing:.02em;
    }

    /* ---------- terminal feed ---------- */
    .pd-term{
      background:rgba(25,25,25,.92);border:1px solid var(--line-dark);border-radius:var(--r-lg);
      margin-top:16px;overflow:hidden;box-shadow:var(--el-ink);
    }
    .pd-term .bar{
      display:flex;align-items:center;gap:.5rem;padding:.55rem .9rem;
      border-bottom:1px solid var(--line-dark);
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.62rem;
      letter-spacing:.1em;text-transform:uppercase;color:var(--muted-dark);
    }
    .pd-term .bar i{width:8px;height:8px;border-radius:50%;background:rgba(250,247,242,.2);display:block}
    .pd-term .bar i:first-child{background:var(--red)}
    .pd-term ol{
      list-style:none;margin:0;padding:.9rem 1rem 1rem;
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.72rem;line-height:1.9;
    }
    .pd-term li{color:var(--muted-dark);white-space:normal}
    .pd-term .t{color:rgba(250,247,242,.4)}
    .pd-term .a{color:var(--red);font-weight:700}
    .pd-term .cursor{display:inline-block;width:7px;height:12px;background:var(--red);vertical-align:-2px}
    @media (prefers-reduced-motion:no-preference){
      .pd-term .cursor{animation:pdBlink 1s steps(1) infinite}
      .pd-term li{opacity:0;transform:translateY(4px);transition:opacity .4s var(--e-out),transform .4s var(--e-out)}
      .pd-term li.in{opacity:1;transform:none}
    }

    /* ---------- sections / grids ---------- */
    .pd-section{padding:1.2rem 0 .6rem}
    .pd-head{text-align:center;margin:2.4rem 0 1.8rem}
    .pd-head h2{
      font-family:'Montserrat',sans-serif;font-weight:900;text-transform:uppercase;
      font-size:clamp(1.5rem,3.5vw,2.3rem);letter-spacing:-.02em;margin:0;
    }
    .pd-head p{color:var(--muted-dark);max-width:540px;margin:.8rem auto 0;font-size:.92rem}
    .pd-head p .mono{font-size:.85em}
    .cards-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .cards-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}
    .cards-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
    .cards-4 + .cards-4{margin-top:16px}

    /* ---------- panels / tables ---------- */
    .pd-panel{
      background:var(--ink-2);border:1px solid var(--line-dark);border-radius:var(--r-lg);
      padding:20px;margin-top:16px;
    }
    .pd-panel h3{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.66rem;font-weight:700;
      letter-spacing:.12em;text-transform:uppercase;color:var(--muted-dark);margin:0 0 1rem;
    }
    .pd-panel table{width:100%;border-collapse:collapse;font-size:.86rem}
    .pd-panel th,.pd-panel td{
      text-align:left;padding:.7rem .5rem;border-bottom:1px solid var(--line-dark);font-weight:600;
    }
    .pd-panel th{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.6rem;letter-spacing:.1em;
      text-transform:uppercase;color:var(--muted-dark);font-weight:700;
    }
    .pd-panel td{color:var(--cream)}
    .pd-panel td.num,.pd-panel th.num{text-align:right;font-variant-numeric:tabular-nums}
    .pd-panel td .up{color:var(--red);font-weight:800}
    .pd-panel tr:last-child td{border-bottom:none}

    /* ---------- chart ---------- */
    .pd-bars{display:flex;align-items:flex-end;gap:4px;height:150px;margin-top:.4rem}
    .pd-barcol{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;min-width:0}
    .pd-barstack{width:100%;max-width:22px;display:flex;flex-direction:column;justify-content:flex-end;flex:1}
    .pd-bar{
      width:100%;border-radius:3px 3px 0 0;min-height:2px;
      background:linear-gradient(180deg,rgba(206,17,38,.95),var(--red-dark));
      box-shadow:0 0 12px rgba(206,17,38,.3);
    }
    .pd-bar.users{background:linear-gradient(180deg,var(--cream),var(--muted-dark));box-shadow:none;opacity:.85;margin-top:2px;border-radius:2px}
    @media (prefers-reduced-motion:no-preference){
      .pd-bar{transform-origin:bottom;transform:scaleY(0);transition:transform .7s var(--e-out)}
      .pd-bars.in .pd-bar{transform:scaleY(1)}
    }
    .pd-barlbl{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.55rem;
      color:var(--muted-dark);margin-top:6px;font-weight:700;
    }
    .pd-legend{
      display:flex;gap:1.2rem;margin-top:.9rem;font-size:.72rem;color:var(--muted-dark);font-weight:600;
    }
    .pd-legend .dot{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px}
    .pd-legend .dot.red{background:var(--red)}
    .pd-legend .dot.white{background:var(--cream)}

    /* ---------- watch time / footer ---------- */
    .pd-watch{text-align:center;padding:2.4rem 0 .5rem}
    .pd-watch .big{
      font-family:'Montserrat',sans-serif;font-size:clamp(2rem,5vw,3.1rem);font-weight:900;
      letter-spacing:-.03em;margin:.5rem 0 .3rem;
    }
    .pd-watch p{color:var(--muted-dark);font-weight:500;margin:0}
    .pd-foot{
      text-align:center;color:var(--muted-dark);font-size:.7rem;padding:2.6rem 1.2rem 3.4rem;
      max-width:700px;margin:0 auto;line-height:1.6;
    }
    .pd-foot .sig{
      font-family:ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:.1em;text-transform:uppercase;
      color:rgba(250,247,242,.45);display:block;margin-top:1rem;
    }

    /* scroll reveal */
    @media (prefers-reduced-motion:no-preference){
      .pd-reveal{opacity:0;transform:translateY(16px);transition:opacity .55s var(--e-out),transform .55s var(--e-out)}
      .pd-reveal.in{opacity:1;transform:none}
    }

    /* ---------- responsive ---------- */
    @media (max-width:900px){
      .pd-grid{grid-template-columns:1fr;grid-template-rows:auto;gap:14px}
      .pd-grid .tl,.pd-grid .tr,.pd-grid .bl,.pd-grid .br,.pd-hubwrap{grid-column:1;grid-row:auto}
      .pd-hubwrap{order:-1;padding:10px 0 20px}
      .pd-connectors{display:none}
      .pd-agents{grid-template-columns:1fr 1fr}
      .cards-4{grid-template-columns:1fr 1fr}
      .cards-3,.cards-2{grid-template-columns:1fr}
      .pd-cmd .right .hide-m{display:none}
    }
    @media (max-width:520px){
      .cards-4,.pd-agents{grid-template-columns:1fr}
      .pd-bars{gap:2px}
      .pd-barlbl{display:none}
    }
  </style>

  <!-- command bar -->
  <header class="pd-cmd">
    <div class="wrap">
      <span class="sys">HTL<b>//</b>AGENT&nbsp;OPS</span>
      <span class="hide-m">client: paradise-spas-nd</span>
      <div class="right">
        <span class="hide-m">window: 2026-07-01 → 07-25</span>
        <span class="pd-led">4/4 agents · LIVE</span>
      </div>
    </div>
  </header>

  <main>

    <!-- hero -->
    <section class="pd-hero wrap">
      <p class="pd-eyebrow">Deployment report · Fair season 2026</p>
      <h1>The agents ran<br />fair season. <span class="accent">It went massive.</span></h1>
      <p class="sub">
        Red River Valley Fair + ND State Fair, July 2026. Four HTL agents on one
        hot tub store: <b>nearly a million content views</b>, <b>201K unique viewers</b>,
        and <b>338 leads</b> in the vault — while the humans sold tubs on the fair floor.
      </p>
      <a class="pd-cta" href="#report">Open the full telemetry ↓</a>
    </section>

    <!-- neural hub -->
    <section class="pd-diagram" aria-label="Key growth metrics">
      <svg class="pd-connectors" viewBox="0 0 1100 520" preserveAspectRatio="none" aria-hidden="true">
        <path d="M340 130 C420 130, 480 220, 550 260" />
        <path d="M760 130 C680 130, 620 220, 550 260" />
        <path d="M340 390 C420 390, 480 300, 550 260" />
        <path d="M760 390 C680 390, 620 300, 550 260" />
        <circle cx="340" cy="130" r="3.5" />
        <circle cx="760" cy="130" r="3.5" />
        <circle cx="340" cy="390" r="3.5" />
        <circle cx="760" cy="390" r="5" />
        <circle cx="550" cy="260" r="5" />
      </svg>
      <div class="pd-grid">

---
// Page 01 — Pre-Call Proof.
// For prospects who already booked a call. No lead form on this page (the one
// action is: show up prepared) — so no AttributionFields / wireLeadForm here.
// Layout still fires the pixel + GA4 and the middleware still sets cookies.
// Asset paths + export specs: public/images/pre-call/ASSETS.md
import Layout from '../layouts/Layout.astro';

const IMG = '/images/pre-call';

const STAGES = [
  'Traffic', 'Lead / Pricing Request', 'Contacted', 'Qualified',
  'Appointment', 'Show', 'Quote', 'Sold',
];

const CAMPAIGN_STATS = [
  { n: '1M+', l: 'Impressions' },
  { n: '338', l: 'Website leads' },
  { n: '268', l: 'Meta-attributed leads' },
  { n: '7,000', l: 'Website clicks' },
  { n: '6,800', l: 'Landing-page views' },
];
---

<Layout
  title="Before Your Call — Hot Tub Launch"
  description="A five-minute briefing before your scheduled call: the online showroom, the buyer path, and the numbers behind Hot Tub Launch."
  pageClass="pre-call"
  robots="noindex"
>
  <style is:global>
    body.pre-call{margin:0}
    .pre-call section{padding-block:var(--s-4)}
    .pre-call .sec-head{max-width:640px;margin-bottom:var(--s-3)}
    .pre-call .sec-head p{margin-top:.8rem}

    /* framed screenshot treatment (shared) */
    .pre-call .shot{
      display:block;max-width:100%;height:auto;background:var(--paper);
      border:1px solid var(--line);border-radius:var(--r-md);box-shadow:var(--el-2);
    }

    /* ---------- 01 HERO ---------- */
    .pc-hero{background:var(--paper);border-bottom:1px solid var(--line)}
    .pc-hero .wrap{
      display:grid;grid-template-columns:47% 1fr;gap:var(--s-3);align-items:center;
    }
    .pc-hero h1{
      font-size:clamp(1.9rem,4vw,2.9rem);letter-spacing:-.02em;margin-bottom:1rem;
    }
    .pc-hero .booked{
      display:inline-flex;align-items:center;gap:.5rem;font-family:'Montserrat';
      font-weight:800;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;
      color:var(--red);margin-bottom:1.1rem;
    }
    .pc-hero .booked::before{content:"●";font-size:.6em}
    .pc-hero .lede{font-size:1.08rem;max-width:46ch}
    .pc-hero .hero-actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:var(--s-2)}
    .pc-hero .hero-visual{position:relative;min-height:0}

    /* Northridge live demo — device chrome */
    .pre-call .nr-laptop{
      position:relative;max-width:560px;margin:0 auto 20px;
      background:linear-gradient(175deg,var(--ink-2) 0%,var(--ink) 55%);
      border-radius:18px 18px 6px 6px;padding:12px 12px 16px;
      box-shadow:inset 0 1px 0 rgba(250,247,242,.10),var(--el-ink),0 46px 80px -34px rgba(0,0,0,.55);
    }
    .pre-call .nr-laptop::before{ /* webcam */
      content:"";position:absolute;top:5px;left:50%;transform:translateX(-50%);
      width:5px;height:5px;border-radius:50%;
      background:rgba(250,247,242,.28);box-shadow:inset 0 0 2px rgba(0,0,0,.8);
    }
    .pre-call .nr-deck{ /* aluminum base */
      position:absolute;left:-5%;right:-5%;bottom:-13px;height:13px;
      background:linear-gradient(180deg,var(--muted-dark) 0%,var(--line) 55%,var(--muted-dark) 100%);
      border-radius:2px 2px 14px 14px;
      box-shadow:0 20px 32px -14px rgba(0,0,0,.45);
    }
    .pre-call .nr-deck::before{ /* thumb notch */
      content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);
      width:76px;height:6px;border-radius:0 0 8px 8px;
      background:linear-gradient(180deg,rgba(25,25,25,.35),rgba(25,25,25,.1));
    }
    .pre-call .nr-chrome{
      display:flex;align-items:center;gap:8px;padding:2px 6px 10px;
    }
    .pre-call .nr-dots{display:flex;gap:5px}
    .pre-call .nr-dots i{width:8px;height:8px;border-radius:50%;background:rgba(250,247,242,.22);display:block}
    .pre-call .nr-dots i:first-child{background:var(--red)}
    .pre-call .nr-url{
      flex:1;display:flex;align-items:center;gap:.4rem;
      background:rgba(250,247,242,.08);color:rgba(250,247,242,.72);
      font-size:.68rem;letter-spacing:.02em;padding:.35rem .7rem;border-radius:99px;
      font-family:'Manrope',system-ui,sans-serif;
    }
    .pre-call .nr-url::before{ /* padlock body + shackle */
      content:"";width:7px;height:6px;flex:none;border-radius:1.5px;
      background:rgba(250,247,242,.55);position:relative;top:1px;
      box-shadow:0 -3px 0 -1px rgba(250,247,242,.45);
    }
    .pre-call .nr-screen{
      position:relative;background:var(--cream);border-radius:8px;overflow:hidden;aspect-ratio:16/10.2;
      box-shadow:inset 0 0 0 1px rgba(0,0,0,.35),inset 0 0 20px rgba(0,0,0,.10);
    }
    .pre-call .nr-screen::after{ /* glass glare */
      content:"";position:absolute;inset:0;pointer-events:none;z-index:3;
      background:linear-gradient(112deg,rgba(255,255,255,.16) 0%,rgba(255,255,255,.05) 26%,transparent 42%);
    }
    .pre-call .nr-desk{height:100%;display:flex;flex-direction:column;font-size:11px;line-height:1.35;color:var(--ink-soft)}
    .pre-call .nr-desk .nr-top{
      display:flex;align-items:center;justify-content:space-between;gap:.6rem;
      padding:.55rem .8rem;background:var(--ink);color:var(--cream);
    }
    .pre-call .nr-mark{
      font-family:'Montserrat',sans-serif;font-weight:900;font-size:.72rem;
      letter-spacing:.08em;text-transform:uppercase;color:var(--cream);
    }
    .pre-call .nr-nav{display:flex;gap:.7rem;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;opacity:.7}
    .pre-call .nr-cta{
      background:var(--red);color:#fff;border:0;border-radius:3px;padding:.35rem .65rem;
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.55rem;letter-spacing:.06em;text-transform:uppercase;
    }
    .pre-call .nr-desk .nr-body{display:grid;grid-template-columns:1.15fr .85fr;gap:.8rem;padding:.8rem;flex:1;min-height:0}
    .pre-call .nr-desk h3{
      font-size:.95rem;margin:0 0 .4rem;text-transform:uppercase;letter-spacing:-.02em;
    }
    .pre-call .nr-desk p{font-size:.62rem;max-width:none;margin:0 0 .55rem;color:var(--muted)}
    .pre-call .nr-zip{
      display:flex;gap:4px;background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:4px;
    }
    .pre-call .nr-zip input{
      flex:1;border:0;background:transparent;font:inherit;font-size:.62rem;padding:.25rem .4rem;min-width:0;color:var(--ink);
    }
    .pre-call .nr-zip input:focus{outline:none}
    .pre-call .nr-tub{
      position:relative;border-radius:6px;background:
        linear-gradient(180deg,rgba(25,25,25,.15),rgba(25,25,25,.45)),
        url('/images/pre-call/13-founders/03-manny-trailer.webp') center/cover no-repeat;
      min-height:0;
    }
    .pre-call .nr-tag{
      position:absolute;left:8px;bottom:8px;background:var(--paper);color:var(--ink);
      font-family:'Montserrat',sans-serif;font-weight:900;font-size:.6rem;letter-spacing:.02em;
      padding:.3rem .5rem;border-radius:4px;box-shadow:var(--el-1);line-height:1.2;
    }
    .pre-call .nr-tag small{
      display:block;font-family:'Manrope',sans-serif;font-weight:600;font-size:.46rem;
      color:var(--muted);letter-spacing:.04em;text-transform:uppercase;
    }
    .pre-call .nr-fin{display:flex;gap:.35rem;margin-top:.5rem;flex-wrap:wrap}
    .pre-call .nr-chip{
      font-family:'Montserrat',sans-serif;font-weight:700;font-size:.48rem;letter-spacing:.06em;
      text-transform:uppercase;color:var(--ink-soft);background:var(--paper);
      border:1px solid var(--line);border-radius:99px;padding:.26rem .5rem;
    }
    .pre-call .nr-stock{
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.5rem;letter-spacing:.12em;
      text-transform:uppercase;color:var(--red);margin-bottom:.25rem;
    }

    .pre-call .nr-phone{
      width:min(300px,100%);margin-inline:auto;position:relative;
      background:linear-gradient(160deg,var(--ink-2) 0%,var(--ink) 70%);
      border-radius:46px;padding:13px 11px;
      box-shadow:
        inset 0 0 0 1px rgba(250,247,242,.12),
        inset 0 0 0 3px rgba(0,0,0,.55),
        var(--el-ink),0 44px 80px -30px rgba(0,0,0,.6);
    }
    .pre-call .nr-phone::before{ /* dynamic island + camera dot */
      content:"";position:absolute;top:23px;left:50%;transform:translateX(-50%);z-index:4;
      width:86px;height:24px;border-radius:99px;
      background:
        radial-gradient(circle at 74% 50%,rgba(250,247,242,.25) 0 3px,transparent 4px),
        rgba(0,0,0,.92);
      box-shadow:0 1px 3px rgba(0,0,0,.5);
    }
    .pre-call .nr-glare{ /* glass glare over the scrolling screen */
      position:absolute;inset:13px 11px;border-radius:34px;pointer-events:none;z-index:3;
      background:linear-gradient(118deg,rgba(255,255,255,.13) 0%,rgba(255,255,255,.03) 24%,transparent 40%);
    }
    .pre-call .nr-phone-screen{
      height:540px;background:var(--cream);border-radius:34px;overflow-y:auto;
      overscroll-behavior:contain;scroll-behavior:smooth;position:relative;
      -webkit-overflow-scrolling:touch;
      box-shadow:inset 0 0 0 1px rgba(0,0,0,.4);
    }
    .pre-call .nr-phone-screen::-webkit-scrollbar{width:6px}
    .pre-call .nr-phone-screen::-webkit-scrollbar-track{background:transparent}
    .pre-call .nr-phone-screen::-webkit-scrollbar-thumb{background:var(--line);border:0}
    .pre-call .nr-hint{
      position:absolute;left:10px;right:10px;bottom:22px;z-index:2;pointer-events:none;
      text-align:center;font-family:'Montserrat',sans-serif;font-weight:800;font-size:.58rem;
      letter-spacing:.12em;text-transform:uppercase;color:var(--cream);
      background:rgba(25,25,25,.72);padding:.55rem;border-radius:99px;
      transition:opacity .35s var(--e-out);
    }
    .pre-call .nr-phone.is-scrolled .nr-hint{opacity:0}
    .pre-call .nr-m{font-size:13px;line-height:1.4;color:var(--ink-soft)}
    .pre-call .nr-appbar{position:sticky;top:0;z-index:2;transition:box-shadow .25s var(--e-soft)}
    .pre-call .nr-phone.is-scrolled .nr-appbar{box-shadow:0 8px 18px -8px rgba(0,0,0,.45)}
    .pre-call .nr-status{
      display:flex;justify-content:space-between;align-items:center;
      padding:.6rem 1rem .1rem;background:var(--ink);color:var(--cream);
      font-family:'Montserrat',sans-serif;font-weight:700;font-size:.6rem;letter-spacing:.03em;
    }
    .pre-call .nr-status .right{display:inline-flex;align-items:center;gap:4px}
    .pre-call .nr-sig{display:inline-flex;align-items:flex-end;gap:1.5px}
    .pre-call .nr-sig i{width:2.5px;background:var(--cream);border-radius:1px;display:block}
    .pre-call .nr-sig i:nth-child(1){height:3px}
    .pre-call .nr-sig i:nth-child(2){height:5px}
    .pre-call .nr-sig i:nth-child(3){height:7px}
    .pre-call .nr-sig i:nth-child(4){height:9px;background:rgba(250,247,242,.45)}
    .pre-call .nr-batt{
      width:17px;height:9px;border:1px solid rgba(250,247,242,.6);border-radius:2.5px;
      position:relative;display:inline-block;
    }
    .pre-call .nr-batt::before{content:"";position:absolute;inset:1px;right:4px;background:var(--cream);border-radius:1px}
    .pre-call .nr-batt::after{
      content:"";position:absolute;right:-3px;top:2px;width:2px;height:4px;
      background:rgba(250,247,242,.6);border-radius:0 1px 1px 0;
    }
    .pre-call .nr-m .nr-top{padding:.5rem .85rem .6rem;background:var(--ink);color:var(--cream)}
    .pre-call .nr-m .nr-mark{font-size:.78rem}
    .pre-call .nr-m .nr-nav{display:none}
    .pre-call .nr-banner{
      background:var(--red);color:#fff;text-align:center;font-size:.62rem;font-weight:700;
      letter-spacing:.08em;text-transform:uppercase;padding:.4rem .6rem;
    }
    .pre-call .nr-m .nr-pad{padding:.9rem .85rem 1.1rem}
    .pre-call .nr-m h3{font-size:1.15rem;margin:0 0 .45rem}
    .pre-call .nr-m p{max-width:none;font-size:.78rem;margin:0 0 .7rem;color:var(--muted)}
    .pre-call .nr-m .nr-zip{padding:5px}
    .pre-call .nr-m .nr-zip input{font-size:.78rem;padding:.4rem}
    .pre-call .nr-m .nr-cta{font-size:.65rem;padding:.55rem .75rem;cursor:pointer}
    .pre-call .nr-hero-pic{
      height:150px;margin:.2rem .85rem .4rem;border-radius:10px;
      background:
        linear-gradient(180deg,transparent 40%,rgba(25,25,25,.55)),
        url('/images/pre-call/13-founders/03-manny-trailer.webp') center/cover no-repeat;
    }
    .pre-call .nr-cards{display:grid;gap:.65rem;padding:0 .85rem 1rem}
    .pre-call .nr-card{
      background:var(--paper);border:1px solid var(--line);border-radius:10px;overflow:hidden;
      box-shadow:var(--el-1);
    }
    .pre-call .nr-card .pic{position:relative;height:96px;background:var(--ink-2) center/cover no-repeat}
    .pre-call .nr-card .pic.a{background-image:url('/images/pre-call/13-founders/03-manny-trailer.webp')}
    .pre-call .nr-card .pic.b{background-image:url('/images/pre-call/13-founders/04-alex-studio.webp')}
    .pre-call .nr-card .pic.c{background-image:url('/images/pre-call/13-founders/05-alex-tradeshow.webp')}
    .pre-call .nr-card .pic .flag{
      position:absolute;top:6px;left:6px;background:var(--red);color:#fff;border-radius:3px;
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.48rem;
      letter-spacing:.08em;text-transform:uppercase;padding:.22rem .4rem;
    }
    .pre-call .nr-card .pic .flag.alt{background:rgba(25,25,25,.82)}
    .pre-call .nr-card .body{padding:.6rem .7rem .7rem}
    .pre-call .nr-card strong{
      display:block;font-family:'Montserrat',sans-serif;font-weight:800;font-size:.72rem;
      letter-spacing:.04em;text-transform:uppercase;color:var(--ink);
    }
    .pre-call .nr-card .spec{font-size:.66rem;color:var(--muted);display:block}
    .pre-call .nr-price{display:flex;align-items:baseline;gap:.35rem;margin:.3rem 0 .45rem}
    .pre-call .nr-price b{font-family:'Montserrat',sans-serif;font-weight:900;font-size:.95rem;color:var(--ink)}
    .pre-call .nr-price small{font-size:.56rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
    .pre-call .nr-row{display:flex;align-items:center;justify-content:space-between;gap:.5rem}
    .pre-call .nr-mini{font-size:.62rem;color:var(--muted)}
    .pre-call .nr-book{
      background:var(--paper);border:1.5px solid var(--ink);color:var(--ink);border-radius:5px;
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.55rem;
      letter-spacing:.06em;text-transform:uppercase;padding:.4rem .6rem;cursor:pointer;
      transition:transform .15s var(--e-spring),background .15s var(--e-soft),color .15s var(--e-soft);
    }
    .pre-call .nr-book:hover{background:var(--ink);color:var(--cream)}
    .pre-call .nr-book:active{transform:scale(.95)}
    .pre-call .nr-sec-label{
      font-family:'Montserrat',sans-serif;font-weight:800;font-size:.58rem;letter-spacing:.14em;
      text-transform:uppercase;color:var(--red);padding:.4rem .85rem 0;
    }
    .pre-call .nr-slots{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;padding:.5rem .85rem 1.2rem}
    .pre-call .nr-slot{
      border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:.55rem .5rem;
      font:inherit;font-size:.7rem;color:inherit;text-align:center;cursor:pointer;
      transition:border-color .15s var(--e-soft),box-shadow .15s var(--e-soft),transform .15s var(--e-spring);
    }
    .pre-call .nr-slot:active{transform:scale(.96)}
    .pre-call .nr-slot b{display:block;font-family:'Montserrat',sans-serif;font-size:.62rem;letter-spacing:.06em}
    .pre-call .nr-slot.sel{border-color:var(--red);box-shadow:0 0 0 2px rgba(206,17,38,.16)}
    .pre-call .nr-slot.sel b{color:var(--red)}
    .pre-call .nr-slot.held{opacity:.5;cursor:default}
    .pre-call .nr-sticky{
      position:sticky;bottom:0;z-index:2;display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:4px;
      background:var(--ink);padding:.45rem;color:var(--cream);font-size:.55rem;
      font-family:'Montserrat',sans-serif;font-weight:800;letter-spacing:.06em;text-transform:uppercase;text-align:center;
      box-shadow:0 -8px 18px -10px rgba(0,0,0,.4);
    }
    .pre-call .nr-sticky span{padding:.45rem .2rem;border:1px solid rgba(250,247,242,.2);border-radius:4px}
    .pre-call .nr-sticky span.go{
      background:var(--red);border-color:var(--red);color:#fff;
      transition:transform .2s var(--e-spring);
    }
    .pre-call .nr-sticky span.go.pulse{animation:nrPulse .45s var(--e-spring)}
    @keyframes nrPulse{0%{transform:scale(1)}40%{transform:scale(1.06)}100%{transform:scale(1)}}
    .pre-call .nr-zip{transition:border-color .15s var(--e-soft),box-shadow .15s var(--e-soft)}
    .pre-call .nr-zip.err{border-color:var(--red);box-shadow:0 0 0 2px rgba(206,17,38,.14)}
    .pre-call .nr-cta.busy{opacity:.7;pointer-events:none}
    .pre-call .nr-flash{
      display:none;margin-top:.55rem;padding:.55rem .65rem;background:var(--paper);
      border:1px solid var(--line);border-left:3px solid var(--red);border-radius:4px;
      font-size:.72rem;color:var(--ink);
    }
    .pre-call .nr-flash.on{display:block}
    /* staggered in-phone reveal (guarded for reduced motion) */
    @media (prefers-reduced-motion:no-preference){
      .pre-call .nr-reveal{opacity:0;transform:translateY(12px);transition:opacity .5s var(--e-out),transform .5s var(--e-out)}
      .pre-call .nr-reveal.in{opacity:1;transform:none}
      .pre-call .nr-cards .nr-reveal:nth-child(2){transition-delay:.08s}
      .pre-call .nr-cards .nr-reveal:nth-child(3){transition-delay:.16s}
      .pre-call .nr-flash.on{animation:nrFlash .4s var(--e-out)}
      @keyframes nrFlash{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    }

    .pc-showroom .nr-stage{
      display:flex;align-items:flex-end;justify-content:center;gap:var(--s-2);flex-wrap:wrap;
    }
    .pc-showroom .nr-caption{
      text-align:center;margin-top:var(--s-2);font-size:.82rem;color:var(--muted);max-width:42ch;margin-inline:auto;
    }

    /* ---------- 02 WELCOME VIDEO ---------- */
    .pc-video .player{
      max-width:940px;margin-inline:auto;aspect-ratio:16/9;width:100%;
      border-radius:var(--r-lg);overflow:hidden;background:var(--ink);box-shadow:var(--el-ink);
    }
    .pc-video video{width:100%;height:100%;display:block;object-fit:cover}
    .pc-video .sec-head{margin-inline:auto;text-align:center}

    /* ---------- 03 BUYER PATH ---------- */
    .pc-path{background:var(--ink);color:var(--cream)}
    .pc-path h2{color:var(--cream)}
    .pc-path .sec-head p{color:rgba(250,247,242,.75)}
    .pc-path ol{
      list-style:none;display:flex;align-items:stretch;gap:0;max-width:1080px;
      margin-inline:auto;counter-reset:stage;
    }
    .pc-path li{
      counter-increment:stage;flex:1;min-width:0;position:relative;
      padding:1.1rem .6rem;text-align:center;
      border:1px solid var(--line-dark);border-left:0;background:rgba(250,247,242,.04);
    }
    .pc-path li:first-child{border-left:1px solid var(--line-dark);border-radius:var(--r-sm) 0 0 var(--r-sm)}
    .pc-path li:last-child{border-radius:0 var(--r-sm) var(--r-sm) 0;background:rgba(206,17,38,.18)}
    .pc-path li::before{
      content:counter(stage,decimal-leading-zero);display:block;font-family:'Montserrat';
      font-weight:700;font-size:.62rem;letter-spacing:.12em;color:var(--muted-dark);margin-bottom:.4rem;
    }
    .pc-path li span{
      font-family:'Montserrat';font-weight:800;font-size:.72rem;letter-spacing:.05em;
      text-transform:uppercase;line-height:1.25;display:block;
    }
    .pc-path .stop{
      text-align:center;margin-top:var(--s-2);font-family:'Montserrat';font-weight:700;
      font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(250,247,242,.6);
    }
    .pc-path .stop b{color:var(--red)}

    /* ---------- 04 SHOWROOM ---------- */
    .pc-showroom .grid{
      display:grid;grid-template-columns:35% 1fr;gap:var(--s-3);align-items:start;
    }
    .pc-showroom .comp{display:grid;gap:var(--s-2)}
    .pc-showroom .comp .mobiles{display:flex;gap:var(--s-2);justify-content:center}
    .pc-showroom .comp .mobiles .shot{width:min(240px,44%)}

    /* ---------- 05 HANDOFF ---------- */
    .pc-handoff{background:var(--paper);border-block:1px solid var(--line)}
    .pc-handoff .steps{
      display:grid;grid-template-columns:repeat(4,1fr);gap:var(--s-2);max-width:1000px;
    }
    .pc-handoff figure{margin:0;text-align:center}
    .pc-handoff .shot{max-width:270px;margin-inline:auto}
    .pc-handoff figcaption{
      margin-top:.7rem;font-family:'Montserrat';font-weight:800;font-size:.7rem;

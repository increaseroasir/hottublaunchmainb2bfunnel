          <h2>One thing left to do: <span class="red">show up prepared</span></h2>
          <ul>
            <li>Know your rough monthly tub volume and average ticket.</li>
            <li>Have your current lead flow handy — where leads come from, who follows up.</li>
            <li>Think about the path above: where do <em>your</em> buyers stop?</li>
          </ul>
          <p class="note">
            Your call is already scheduled — there's nothing to book here. Bring the
            numbers, and we'll spend the whole call on your store.
          </p>
        </div>
      </div>
    </section>

  </main>
  <script>
    // Northridge demo interactivity. Display-only: nothing here posts anywhere.
    const phone = document.getElementById('nrPhone');
    const screen = document.getElementById('nrScreen');
    const zip = document.getElementById('nrZip');
    const btn = document.getElementById('nrPriceBtn');
    const flash = document.getElementById('nrFlash');
    const slots = document.getElementById('nrSlots');
    const go = document.getElementById('nrGo');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (screen instanceof HTMLElement && phone instanceof HTMLElement) {
      screen.addEventListener('scroll', () => {
        phone.classList.toggle('is-scrolled', screen.scrollTop > 16);
      }, { passive: true });

      // stagger inventory cards in as they enter the phone viewport
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      }, { root: screen, threshold: 0.25 });
      screen.querySelectorAll('.nr-reveal').forEach((el) => io.observe(el));
    }

    // ZIP check: validate → brief "checking" beat → result slides in
    function runZipCheck() {
      if (!(btn instanceof HTMLButtonElement) || !(flash instanceof HTMLElement)) return;
      const wrap = zip instanceof HTMLInputElement ? zip.closest('.nr-zip') : null;
      const z = zip instanceof HTMLInputElement ? zip.value.trim() : '';
      if (!/^\d{5}$/.test(z)) {
        wrap?.classList.add('err');
        if (zip instanceof HTMLInputElement) zip.focus();
        return;
      }
      wrap?.classList.remove('err');
      const label = btn.textContent;
      btn.classList.add('busy');
      btn.textContent = 'Checking…';
      flash.classList.remove('on');
      window.setTimeout(() => {
        btn.classList.remove('busy');
        btn.textContent = label;
        flash.textContent = `2 RidgeLine 14s in ZIP ${z}. Out-the-door quote texts in under a minute.`;
        flash.classList.add('on');
      }, reduced ? 0 : 550);
    }
    btn?.addEventListener('click', runZipCheck);
    if (zip instanceof HTMLInputElement) {
      zip.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') runZipCheck();
      });
      zip.addEventListener('input', () => {
        zip.closest('.nr-zip')?.classList.remove('err');
      });
    }

    // Book buttons scroll the phone down to the time slots
    document.querySelectorAll('[data-book]').forEach((b) => {
      b.addEventListener('click', () => {
        document.getElementById('nrSlotsLabel')?.scrollIntoView({
          behavior: reduced ? 'auto' : 'smooth', block: 'nearest',
        });
      });
    });

    // Slot selection updates the sticky CTA
    if (slots instanceof HTMLElement) {
      slots.addEventListener('click', (e) => {
        const slot = e.target instanceof Element ? e.target.closest('.nr-slot') : null;
        if (!(slot instanceof HTMLButtonElement) || slot.disabled) return;
        slots.querySelectorAll('.nr-slot.sel').forEach((s) => s.classList.remove('sel'));
        slot.classList.add('sel');
        if (go instanceof HTMLElement) {
          const time = slot.querySelector('b')?.textContent || '';
          go.textContent = time ? `Confirm ${time}` : 'Shop inventory';
          go.classList.remove('pulse');
          void go.offsetWidth; // restart the pulse animation
          go.classList.add('pulse');
        }
      });
    }
  </script>
</Layout>

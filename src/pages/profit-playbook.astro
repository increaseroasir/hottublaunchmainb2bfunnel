---
import Layout from '../layouts/Layout.astro';
import AttributionFields from '../components/AttributionFields.astro';
import { CONSENT_TEXT } from '../data/consent';
---

<Layout
  title="Free Download: The 2026 Hot Tub Store AI Profit Playbook"
  description="Free playbook for hot tub store owners — why your store is losing buyers and the system to start capturing them again."
  pageClass="profit-playbook-page"
  robots="noindex"
>
  <style is:global>
    /* ============================================================
       PROFIT PLAYBOOK — standalone opt-in page
       Design: trust bar → headline → sounds-like-you → book mockup
               → form → reframe → in-this-book → PLUS → authenticity
               → footer
       ============================================================ */
    :root {
      --pb-white:  #FFFFFF;
      --pb-paper:  #FAF9F6;
      --pb-band:   #F1EEE9;
      --pb-ink:    #0E0C0B;
      --pb-gray:   #403B36;
      --pb-muted:  #857E76;
      --pb-red:    #CE1126;
      --pb-red-dk: #A80E1F;
      --pb-line:   #E7E1D8;
      --pb-wrap:   660px;
    }

    .profit-playbook-page {
      background: var(--pb-paper);
      color: var(--pb-gray);
      font-size: 17px;
      line-height: 1.55;
    }
    .profit-playbook-page a { color: inherit; text-decoration: none; }
    .profit-playbook-page h1,
    .profit-playbook-page h2 {
      font-family: 'Montserrat', system-ui, sans-serif;
      text-transform: uppercase;
      line-height: 1.06;
      font-weight: 900;
      letter-spacing: -.01em;
      color: var(--pb-ink);
    }
    .profit-playbook-page .red { color: var(--pb-red); }

    .profit-playbook-page .wrap {
      max-width: var(--pb-wrap);
      margin-inline: auto;
      padding-inline: 1.2rem;
    }

    /* btn -- same as source */
    .profit-playbook-page .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      width: 100%;
      cursor: pointer;
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 900;
      font-size: 1.15rem;
      letter-spacing: .02em;
      text-transform: uppercase;
      padding: 1.1em 1.3em;
      border-radius: 8px;
      border: 0;
      background: var(--pb-red);
      color: #fff;
      transition: .15s;
      box-shadow: 0 12px 28px rgba(206, 17, 38, .3);
      line-height: 1.15;
    }
    .profit-playbook-page .btn:hover {
      background: var(--pb-red-dk);
      transform: translateY(-2px);
    }
    .profit-playbook-page .btn:disabled {
      opacity: .65;
      cursor: default;
      transform: none;
    }

    /* trust bar */
    .profit-playbook-page .trustbar {
      text-align: center;
      padding: 1.5rem 0 .4rem;
    }
    .profit-playbook-page .stars {
      color: var(--pb-red);
      font-size: 1.1rem;
      letter-spacing: 2px;
    }
    .profit-playbook-page .avis {
      display: inline-flex;
      vertical-align: middle;
      margin-right: .5rem;
    }
    .profit-playbook-page .avis span {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 2px solid var(--pb-paper);
      margin-left: -8px;
      background: linear-gradient(150deg, #c9c1b6, #8a827a);
      display: inline-block;
    }
    .profit-playbook-page .avis span:first-child { margin-left: 0; }
    .profit-playbook-page .trusttext {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: .72rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--pb-gray);
      margin-top: .5rem;
    }

    /* intro */
    .profit-playbook-page .intro {
      text-align: center;
      padding: .4rem 0 1.4rem;
    }
    .profit-playbook-page .intro h1 {
      font-size: clamp(1.6rem, 4.5vw, 2.3rem);
      margin-bottom: .9rem;
    }
    .profit-playbook-page .intro .sub {
      font-style: italic;
      font-weight: 600;
      font-size: 1.02rem;
      color: var(--pb-gray);
      max-width: 52ch;
      margin: 0 auto;
    }

    /* if this sounds like you */
    .profit-playbook-page .sounds {
      padding: .6rem 0 1.2rem;
    }
    .profit-playbook-page .sounds h3 {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--pb-ink);
      margin-bottom: 1rem;
    }
    .profit-playbook-page .clist {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .7rem;
      margin-bottom: 1.1rem;
    }
    .profit-playbook-page .clist li {
      display: flex;
      gap: .7rem;
      align-items: flex-start;
      font-size: 1.05rem;
      color: var(--pb-gray);
    }
    .profit-playbook-page .clist li svg {
      flex: none;
      margin-top: .2em;
    }
    .profit-playbook-page .sounds .kick {
      font-size: 1.08rem;
      color: var(--pb-ink);
      font-weight: 600;
    }

    /* book mockup — CSS-only 3D book */
    .profit-playbook-page .mock-sec {
      padding: 2.4rem 0 1.4rem;
      display: flex;
      justify-content: center;
      background: #E4DFDB;
      border-top: 1px solid var(--pb-line);
    }
    .profit-playbook-page .pb-scene {
      position: relative;
      width: 360px;
      height: 300px;
    }
    .profit-playbook-page .pb-book {
      position: absolute;
      left: 30px;
      top: 50%;
      width: 212px;
      height: 288px;
      transform: translateY(-50%) rotate(-3deg);
      border-radius: 3px 7px 7px 3px;
      box-shadow: 0 30px 55px rgba(20, 15, 10, .34), 0 10px 22px rgba(20, 15, 10, .26);
      z-index: 2;
    }
    .profit-playbook-page .pb-cover {
      position: absolute;
      inset: 0;
      background: #141210;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding: 8% 8% 6.5%;
      color: #fff;
      border-radius: 2px 6px 6px 2px;
    }
    .profit-playbook-page .pb-eyebrow {
      display: flex;
      align-items: center;
      gap: 5px;
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: .5rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      opacity: .85;
    }
    .profit-playbook-page .pb-eyebrow i {
      width: 12px;
      height: 2px;
      background: var(--pb-red);
    }
    .profit-playbook-page .pb-title {
      text-transform: uppercase;
      line-height: .9;
      margin-top: 8%;
      font-family: 'Montserrat', system-ui, sans-serif;
    }
    .profit-playbook-page .pb-title .s {
      display: block;
      font-weight: 800;
      font-size: .72rem;
      letter-spacing: .02em;
    }
    .profit-playbook-page .pb-title .b {
      display: block;
      font-weight: 900;
      font-size: 1.9rem;
      letter-spacing: -.02em;
      color: var(--pb-red);
      margin-top: 2px;
    }
    .profit-playbook-page .pb-title .w {
      display: block;
      font-weight: 900;
      font-size: 1.18rem;
      color: #fff;
      margin-top: -2px;
    }
    .profit-playbook-page .pb-art {
      margin-top: auto;
      border-radius: 3px;
      overflow: hidden;
      position: relative;
      height: 30%;
    }
    .profit-playbook-page .pb-art-img {
      position: absolute;
      inset: 0;
      background: radial-gradient(90% 120% at 50% 0%, rgba(206, 17, 38, .22), transparent 55%),
                  linear-gradient(160deg, #2b2723, #15120f 70%);
    }
    .profit-playbook-page .pb-tubs {
      position: absolute;
      bottom: 14%;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      gap: 8%;
      opacity: .85;
    }
    .profit-playbook-page .pb-tubs span {
      width: 20px;
      height: 9px;
      border-radius: 4px 4px 5px 5px;
      background: linear-gradient(180deg, #3a352f, #211d19);
    }
    .profit-playbook-page .pb-sub {
      font-weight: 600;
      font-size: .42rem;
      line-height: 1.35;
      color: #CFC7BE;
      margin-top: 6%;
    }
    .profit-playbook-page .pb-sub b { color: #fff; }
    .profit-playbook-page .pb-by {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 5%;
    }
    .profit-playbook-page .pb-by .by {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: .44rem;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    .profit-playbook-page .pb-by .by span { color: var(--pb-red); }
    .profit-playbook-page .pb-icons {
      display: flex;
      gap: 5px;
    }
    .profit-playbook-page .pb-icons i {
      width: 9px;
      height: 9px;
      border: 1.2px solid rgba(255, 255, 255, .55);
      border-radius: 2px;
    }
    .profit-playbook-page .pb-book::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 11px;
      z-index: 5;
      background: linear-gradient(90deg, rgba(0,0,0,.55), rgba(255,255,255,.05) 55%, rgba(0,0,0,.28));
      border-radius: 2px 0 0 2px;
    }
    .profit-playbook-page .pb-book::after {
      content: "";
      position: absolute;
      right: -4px;
      top: 6px;
      bottom: 6px;
      width: 4px;
      border-radius: 0 2px 2px 0;
      background: repeating-linear-gradient(180deg, #efe9df, #efe9df 1px, #cfc7bb 2px, #cfc7bb 3px);
    }
    /* interior page peeking */
    .profit-playbook-page .pb-inside {
      position: absolute;
      right: 20px;
      top: 50%;
      width: 190px;
      height: 258px;
      transform: translateY(-46%) rotate(5deg);
      background: #fff;
      border-radius: 6px;
      box-shadow: 0 26px 48px rgba(20, 15, 10, .24);
      z-index: 1;
      padding: 22px;
      overflow: hidden;
    }
    .profit-playbook-page .pi-eye {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 700;
      font-size: .5rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--pb-red);
    }
    .profit-playbook-page .pi-h {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: .85rem;
      text-transform: uppercase;
      color: var(--pb-ink);
      margin: 6px 0 12px;
      line-height: 1.05;
    }
    .profit-playbook-page .pi-step {
      display: flex;
      gap: 6px;
      align-items: center;
      margin-bottom: 8px;
    }
    .profit-playbook-page .pi-step b {
      width: 15px;
      height: 15px;
      border-radius: 4px;
      background: var(--pb-red);
      color: #fff;
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 900;
      font-size: .5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: none;
    }
    .profit-playbook-page .pi-step i {
      height: 5px;
      border-radius: 3px;
      background: #e5ded4;
      flex: 1;
      font-style: normal;
    }
    .profit-playbook-page .pi-lines {
      margin-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .profit-playbook-page .pi-lines i {
      height: 4px;
      border-radius: 2px;
      background: #eee7dc;
    }

    /* form band + card */
    .profit-playbook-page .formband {
      background: #E4DFDB;
      padding: .4rem 0 2.2rem;
      border-bottom: 1px solid var(--pb-line);
    }
    .profit-playbook-page .form-card {
      background: #fff;
      border: 1px solid var(--pb-line);
      border-radius: 12px;
      padding: clamp(1.4rem, 4vw, 2rem);
      max-width: 520px;
      margin: 0 auto;
      box-shadow: 0 16px 40px rgba(20, 15, 10, .06);
    }
    .profit-playbook-page .form-card .ft {
      text-align: center;
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 900;
      font-size: 1.15rem;
      text-transform: uppercase;
      color: var(--pb-ink);
      margin-bottom: 1.3rem;
      letter-spacing: -.01em;
    }

    /* native form fields */
    .profit-playbook-page .pb-field {
      margin-bottom: .9rem;
    }
    .profit-playbook-page .pb-field label {
      display: block;
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 700;
      font-size: .72rem;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--pb-gray);
      margin-bottom: .35rem;
    }
    .profit-playbook-page .pb-field input {
      display: block;
      width: 100%;
      padding: .75rem .9rem;
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 1rem;
      color: var(--pb-ink);
      background: var(--pb-paper);
      border: 1.5px solid var(--pb-line);
      border-radius: 8px;
      transition: border-color .15s, box-shadow .15s;
      outline: none;
    }
    .profit-playbook-page .pb-field input:focus {
      border-color: var(--pb-red);
      box-shadow: 0 0 0 3px rgba(206, 17, 38, .15);
    }
    .profit-playbook-page .pb-field input[aria-invalid="true"] {
      border-color: var(--pb-red);
    }
    .profit-playbook-page .pb-field .field-error {
      display: block;
      font-size: .78rem;
      color: var(--pb-red);
      margin-top: .25rem;
      min-height: 0;
    }

    /* generic content sections */
    .profit-playbook-page .sec {
      padding: clamp(2.2rem, 5vw, 3.4rem) 0;
    }
    .profit-playbook-page .sec--band {
      background: var(--pb-band);
      border-top: 1px solid var(--pb-line);
      border-bottom: 1px solid var(--pb-line);
    }
    .profit-playbook-page .sec h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3.6vw, 2.1rem);
      margin-bottom: .8rem;
    }
    .profit-playbook-page .sec .cen {
      text-align: center;
      color: var(--pb-gray);
      max-width: 50ch;
      margin: 0 auto 1.4rem;
      font-size: 1.05rem;
    }
    .profit-playbook-page .blocktitle {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: 1.08rem;
      color: var(--pb-ink);
      margin: 1.4rem 0 .9rem;
    }

    /* leaking bucket visual */
    .profit-playbook-page .bucket {
      display: flex;
      justify-content: center;
      margin: 1.6rem 0;
    }

    /* authenticity */
    .profit-playbook-page .auth p {
      margin-bottom: 1rem;
      font-size: 1.06rem;
      color: var(--pb-gray);
    }
    .profit-playbook-page .auth .sig {
      margin-top: 1.4rem;
    }
    .profit-playbook-page .auth .sig b {
      display: block;
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      color: var(--pb-ink);
      text-transform: uppercase;
      letter-spacing: .02em;
      font-size: .95rem;
    }
    .profit-playbook-page .auth .sig span {
      font-size: .9rem;
      color: var(--pb-muted);
    }
    .profit-playbook-page .final-cta {
      max-width: 520px;
      margin: 1.8rem auto 0;
    }

    /* footer */
    .profit-playbook-page footer {
      background: var(--pb-ink);
      color: #fff;
      padding: 2.6rem 0 2.8rem;
      text-align: center;
    }
    .profit-playbook-page .logo {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
    }
    .profit-playbook-page .logo .mk {
      width: 36px;
      height: 36px;
    }
    .profit-playbook-page .logo .w1 {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: .02em;
      text-transform: uppercase;
      color: #fff;
      line-height: .85;
      display: block;
    }
    .profit-playbook-page .logo .w2 {
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 700;
      font-size: .72rem;
      letter-spacing: .42em;
      color: var(--pb-red);
      text-transform: uppercase;
      display: block;
      margin-top: 2px;
    }
    .profit-playbook-page .foot-legal {
      color: rgba(255, 255, 255, .42);
      font-size: .74rem;
      max-width: 64ch;
      margin: 1.4rem auto 0;
      line-height: 1.65;
    }

    @media (max-width: 480px) {
      .profit-playbook-page .pb-scene { width: 320px; transform: scale(.92); }
    }
  </style>

  <!-- TRUST BAR -->
  <div class="trustbar">
    <div class="wrap">
      <div class="stars">★★★★★</div>
      <div class="trusttext">
        <span class="avis"><span></span><span></span><span></span><span></span></span>
        Trusted by 200+ hot tub store owners
      </div>
    </div>
  </div>

  <!-- INTRO -->
  <section class="intro">
    <div class="wrap">
      <h1>(Free Download) The 2026 Hot Tub Store AI Profit Playbook — <span class="red">why your store is losing buyers</span>, and the system to start capturing them again</h1>
      <p class="sub">A free playbook for hot tub store owners who are doing "ok" on paper — but haven't seen a real jump in buyers, sales, or profit in a long time.</p>
    </div>
  </section>

  <!-- IF THIS SOUNDS LIKE YOU -->
  <section class="sounds">
    <div class="wrap">
      <h3>If this sounds like you:</h3>
      <ul class="clist">
        <li>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          You've got a good showroom and good tubs on the floor
        </li>
        <li>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          You've run promos, maybe ads, even hired an agency
        </li>
        <li>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#CE1126"/><path d="M7 12.5l3.2 3.2L17 9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          But sales still swing with the season and feel unpredictable
        </li>
      </ul>
      <p class="kick">…then it's time to do something different. Something that works now, in 2026.</p>
    </div>
  </section>

  <!-- BOOK MOCKUP -->
  <section class="mock-sec">
    <div class="pb-scene">
      <div class="pb-book">
        <div class="pb-cover">
          <div class="pb-eyebrow"><i></i>Hot Tub Industry</div>
          <div class="pb-title">
            <span class="s">The 2026</span>
            <span class="b">Profit</span>
            <span class="w">Playbook</span>
          </div>
          <div class="pb-art">
            <div class="pb-art-img"></div>
            <div class="pb-tubs"><span></span><span></span><span></span><span></span></div>
          </div>
          <div class="pb-sub">A practical system to <b>capture more buyers</b>, book more appointments &amp; close more sales</div>
          <div class="pb-by">
            <span class="by">Hot Tub <span>Launch</span></span>
            <span class="pb-icons"><i></i><i></i><i></i></span>
          </div>
        </div>
      </div>
      <div class="pb-inside">
        <div class="pi-eye">Inside</div>
        <div class="pi-h">What's leaking your sales</div>
        <div class="pi-step"><b>1</b><i style="width:70%"></i></div>
        <div class="pi-step"><b>2</b><i style="width:85%"></i></div>
        <div class="pi-step"><b>3</b><i style="width:55%"></i></div>
        <div class="pi-step"><b>4</b><i style="width:90%"></i></div>
        <div class="pi-step"><b>5</b><i style="width:65%"></i></div>
        <div class="pi-lines">
          <i style="width:100%"></i><i style="width:90%"></i><i style="width:75%"></i><i style="width:60%"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM — native, replaces GHL embed -->
  <section class="formband">
    <div class="wrap">
      <div class="form-card" id="optin">
        <div class="ft">Enter your info below to access</div>

        <form action="/api/lead" method="POST" novalidate>

          <!-- Hidden tracking fields — server-rendered from attribution cookies (Lane B2) -->
          <AttributionFields />

          <div class="pb-field">
            <label for="profitName">First Name</label>
            <input id="profitName" name="first_name" type="text" required autocomplete="given-name" placeholder="Your first name" />
            <span class="field-error" data-error-for="first_name"></span>
          </div>

          <div class="pb-field">
            <label for="profitLastName">Last Name</label>
            <input id="profitLastName" name="last_name" type="text" autocomplete="family-name" placeholder="Your last name" />
          </div>

          <div class="pb-field">
            <label for="profitEmail">Email Address</label>
            <input id="profitEmail" name="email" type="email" required autocomplete="email" placeholder="your@email.com" />
            <span class="field-error" data-error-for="email"></span>
          </div>

          <div class="pb-field">
            <label for="profitPhone">Phone Number (optional)</label>
            <input id="profitPhone" name="phone" type="tel" autocomplete="tel" placeholder="(979) 459-9221" />
          </div>

          <!-- Consent — label text IS the stored consent record (B8/C10); edit src/data/consent.ts, not here -->
          <label style="display:flex;gap:.6rem;align-items:flex-start;cursor:pointer;font-size:.72rem;line-height:1.5;margin:.8rem 0 1rem;color:var(--muted,#6E655F)">
            <input type="checkbox" name="terms" required style="margin-top:.2em;accent-color:#CE1126;flex:none;width:16px;height:16px" />
            <span>{CONSENT_TEXT}</span>
          </label>

          <button class="btn" type="submit" data-submit>Access the Playbook</button>
        </form>
      </div>
    </div>
  </section>

  <!-- REFRAME -->
  <section class="sec">

  <!-- Capture/submit plumbing lives in src/lib/lead-client.ts (Lane B shared util).
       This block is page-specific validation only. -->
  <script>
    import { wireLeadForm } from '../lib/lead-client';

    (function () {
      const formNode = document.querySelector('.profit-playbook-page form');
      if (!(formNode instanceof HTMLFormElement)) return;
      const formEl = formNode;

      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function value(name: string): string {
        const input = formEl.elements.namedItem(name) as { value?: string } | null;
        return input && typeof input.value === 'string' ? input.value.trim() : '';
      }

      function setError(name: string, message: string) {
        const input = formEl.elements.namedItem(name);
        const slot = formEl.querySelector('[data-error-for="' + name + '"]');
        if (input instanceof HTMLInputElement) {
          input.setAttribute('aria-invalid', message ? 'true' : 'false');
        }
        if (slot) slot.textContent = message;
      }

      function validate(): boolean {
        const name = value('first_name');
        const email = value('email');
        const termsEl = formEl.elements.namedItem('terms');
        const terms = termsEl instanceof HTMLInputElement ? termsEl.checked : false;
        const next = {
          name: name.length >= 2 ? '' : 'Please enter your first name (at least 2 characters).',
          email: emailRe.test(email) ? '' : 'Please enter a valid email address.',
        };
        setError('first_name', next.name);
        setError('email', next.email);
        return !next.name && !next.email && terms;
      }

      wireLeadForm({ form: formEl, validate });
    })();
  </script>

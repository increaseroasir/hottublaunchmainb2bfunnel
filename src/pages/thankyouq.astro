---
import Layout from '../layouts/Layout.astro';
const title = 'Thank You — Hot Tub Launch';
---

<Layout title={title} robots="noindex">
  <style is:global>
    :root {
      --htl-white: #FFFFFF;
      --htl-ink: #0E0C0B;
      --htl-gray: #3A3532;
      --htl-muted: #6E655F;
      --htl-red: #CE1126;
      --htl-red-dk: #A80E1F;
      --htl-line: #E0DAD0;
      --htl-cream: #FAF7F2;
      --htl-wrap: 680px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--htl-white);
      color: var(--htl-gray);
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 17px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    .wrap { max-width: var(--htl-wrap); margin: 0 auto; padding: 0 1.2rem; }

    /* ---------- LOGO ---------- */
    .ty-logo {
      text-align: center;
      padding: clamp(2.4rem, 5vw, 3.2rem) 0 0;
    }
    .ty-logo-inner {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
    }
    .ty-logo .mk { width: 34px; height: 34px; }
    .ty-logo .w1 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: .02em;
      text-transform: uppercase;
      color: var(--htl-ink);
      line-height: .85;
      display: block;
      text-align: left;
    }
    .ty-logo .w2 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      font-size: .66rem;
      letter-spacing: .42em;
      color: var(--htl-red);
      text-transform: uppercase;
      display: block;
      margin-top: 2px;
      text-align: left;
    }

    /* ---------- HEADLINE ---------- */
    .ty-headline {
      text-align: center;
      padding: 1.6rem 0 2rem;
    }
    .ty-headline h1 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 900;
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      color: var(--htl-ink);
      line-height: 1.25;
      letter-spacing: -.02em;
    }
    .ty-headline h1 .accent {
      color: var(--htl-red);
    }

    /* ---------- CALENDAR ---------- */
    .ty-calendar {
      max-width: 500px;
      margin: 0 auto;
      padding: 0 1.2rem 2.4rem;
    }
    .cal-shell {
      background: #F8F6F2;
      border: 1.5px solid var(--htl-line);
      border-radius: 10px;
      padding: 1.4rem 1.2rem;
    }

    .cal-loading {
      text-align: center;
      color: var(--htl-muted);
      padding: 2rem 0;
      font-size: .95rem;
    }
    .cal-error {
      text-align: center;
      color: var(--htl-red);
      padding: 2rem 0;
      font-size: .95rem;
    }

    .cal-days {
      display: flex;
      gap: .5rem;
      overflow-x: auto;
      padding-bottom: .75rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--htl-line);
      -webkit-overflow-scrolling: touch;
    }
    .cal-day {
      flex: 0 0 auto;
      min-width: 64px;
      padding: .55rem .4rem;
      text-align: center;
      border: 1.5px solid var(--htl-line);
      border-radius: 8px;
      background: var(--htl-white);
      cursor: pointer;
      transition: all .15s ease;
      user-select: none;
    }
    .cal-day:hover { border-color: var(--htl-red); }
    .cal-day.sel {
      background: var(--htl-ink);
      border-color: var(--htl-ink);
      color: var(--htl-cream);
    }
    .cal-day .dow {
      display: block;
      font-size: .66rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--htl-muted);
    }
    .cal-day.sel .dow { color: rgba(250,247,242,.7); }
    .cal-day .daynum {
      display: block;
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: 1.15rem;
      line-height: 1.2;
    }
    .cal-day .mon {
      display: block;
      font-size: .62rem;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--htl-muted);
    }
    .cal-day.sel .mon { color: rgba(250,247,242,.7); }

    .cal-slots-label {
      font-size: .72rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--htl-muted);
      margin-bottom: .6rem;
    }
    .cal-slots {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: .5rem;
    }
    .cal-slot {
      padding: .6rem .4rem;
      text-align: center;
      border: 1.5px solid var(--htl-line);
      border-radius: 8px;
      background: var(--htl-white);
      cursor: pointer;
      font-weight: 600;
      font-size: .92rem;
      transition: all .15s ease;
      user-select: none;
    }
    .cal-slot:hover { border-color: var(--htl-red); }
    .cal-slot.sel {
      background: var(--htl-red);
      border-color: var(--htl-red);
      color: var(--htl-white);
    }

    .cal-confirm {
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--htl-line);
      text-align: center;
    }
    .cal-confirm .confirm-summary {
      font-size: .95rem;
      color: var(--htl-gray);
      margin-bottom: .9rem;
    }
    .cal-confirm .confirm-summary strong {
      color: var(--htl-ink);
    }
    .cal-book-btn {
      display: inline-block;
      width: 100%;
      background: var(--htl-red);
      color: var(--htl-white);
      border: none;
      border-radius: 8px;
      padding: .95rem 1rem;
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: .03em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .15s ease;
    }
    .cal-book-btn:hover { background: var(--htl-red-dk); }
    .cal-book-btn:disabled {
      background: var(--htl-line);
      cursor: not-allowed;
    }
    .cal-book-btn.busy { opacity: .7; }

    .cal-done {
      text-align: center;
      padding: 1.4rem .6rem;
    }
    .cal-done .check {
      font-size: 2.6rem;
      margin-bottom: .6rem;
    }
    .cal-done h3 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--htl-ink);
      margin-bottom: .4rem;
    }
    .cal-done p {
      font-size: .95rem;
      color: var(--htl-muted);
    }

    /* ---------- MIDDLE BAND ---------- */
    .ty-band {
      text-align: center;
      padding: 2.4rem 0 2.8rem;
      background: var(--htl-cream);
    }
    .ty-band h2 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 900;
      font-size: clamp(1.2rem, 2.5vw, 1.6rem);
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--htl-ink);
      margin-bottom: 1.6rem;
    }

    /* ---------- FEATURE CARDS ---------- */
    .ty-cards {
      display: flex;
      gap: 1.2rem;
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.2rem 3rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .ty-card {
      background: var(--htl-white);
      border: 1.5px solid var(--htl-line);
      border-radius: 10px;
      padding: 1.6rem 1.4rem;
      flex: 1 1 200px;
      max-width: 220px;
      text-align: center;
    }
    .ty-card .card-icon { font-size: 1.8rem; margin-bottom: .8rem; }
    .ty-card h3 {
      font-family: 'Montserrat', sans-serif;
      font-weight: 800;
      font-size: .7rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--htl-ink);
      margin-bottom: .6rem;
    }
    .ty-card p {
      font-size: .8rem;
      color: var(--htl-muted);
      line-height: 1.55;
    }

    /* ---------- FOOTER ---------- */
    .ty-footer {
      background: var(--htl-ink);
      padding: 2.4rem 0 2.6rem;
      text-align: center;
    }
    .ty-footer .logo .w1 { color: var(--htl-cream); }
    .ty-footer .foot-legal {
      color: rgba(250, 247, 242, .42);
      font-size: .74rem;
      max-width: 64ch;
      margin: 1.3rem auto 0;
      line-height: 1.65;
    }

    :focus-visible { outline: 3px solid var(--htl-red); outline-offset: 3px; border-radius: 2px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>

  <!-- ============ LOGO ============ -->
  <div class="ty-logo">
    <div class="ty-logo-inner">
      <svg class="mk" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <ellipse cx="24" cy="37" rx="17" ry="3.4" stroke="#0E0C0B" stroke-width="1.6"/>
        <ellipse cx="24" cy="37" rx="10.5" ry="2" stroke="#0E0C0B" stroke-width="1.4" opacity=".5"/>
        <circle cx="24" cy="21" r="13" stroke="#0E0C0B" stroke-width="1.8"/>
        <path d="M20 34 C18 24 22 15 31 8 C27 17 27 26 28 34 Z" fill="#CE1126"/>
      </svg>
      <span>
        <span class="w1">Hot Tub</span>
        <span class="w2">Launch</span>
      </span>
    </div>
  </div>

  <!-- ============ HEADLINE ============ -->
  <div class="ty-headline">
    <h1>Thank You: <span class="accent">Choose a time below</span></h1>
  </div>

  <!-- ============ CALENDAR ============ -->
  <div class="ty-calendar">
    <div class="cal-shell" id="cal-shell">
      <div class="cal-loading" id="cal-loading">Loading available times&hellip;</div>

      <div class="cal-days" id="cal-days" hidden></div>

      <div id="cal-slots-wrap" hidden>
        <div class="cal-slots-label">Available times</div>
        <div class="cal-slots" id="cal-slots"></div>
      </div>

      <div class="cal-confirm" id="cal-confirm" hidden>
        <div class="confirm-summary" id="confirm-summary"></div>
        <button class="cal-book-btn" id="cal-book-btn" type="button">Book My Call</button>
      </div>

      <div class="cal-done" id="cal-done" hidden>
        <div class="check">✅</div>
        <h3>You're booked!</h3>
        <p id="cal-done-text">A calendar invite is on its way to your inbox.</p>
      </div>
    </div>
  </div>

  <!-- ============ MIDDLE BAND ============ -->
  <div class="ty-band">
    <h2>BOOK A MEETING INSTANTLY</h2>
  </div>

  <!-- ============ FEATURE CARDS ============ -->
  <div class="ty-cards">
    <div class="ty-card">
      <div class="card-icon">📈</div>
      <h3>Accelerated Growth</h3>
      <p>Done-For-You Sales System That Turns Your Website Into a 24/7 Lead Machine</p>
    </div>
    <div class="ty-card">
      <div class="card-icon">📞</div>
      <h3>Professional Intake</h3>
      <p>Every Call, Text, and Email Handled by Trained Sales Staff Who Book Showroom Appointments</p>
    </div>
    <div class="ty-card">
      <div class="card-icon">🎯</div>
      <h3>Exclusive Territory</h3>
      <p>We Only Work With One Store Per Market — Your Leads Are Never Shared With Competitors</p>
    </div>
  </div>

  <!-- ============ FOOTER ============ -->
  <div class="ty-footer">
    <div class="wrap">
      <div class="ty-logo">
        <div class="ty-logo-inner">
          <svg class="mk" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <ellipse cx="24" cy="37" rx="17" ry="3.4" stroke="#FAF7F2" stroke-width="1.6"/>
            <ellipse cx="24" cy="37" rx="10.5" ry="2" stroke="#FAF7F2" stroke-width="1.4" opacity=".5"/>
            <circle cx="24" cy="21" r="13" stroke="#FAF7F2" stroke-width="1.8"/>
            <path d="M20 34 C18 24 22 15 31 8 C27 17 27 26 28 34 Z" fill="#CE1126"/>
          </svg>
          <span>
            <span class="w1">Hot Tub</span>
            <span class="w2">Launch</span>
          </span>
        </div>
      </div>
      <p class="foot-legal">
        This website is not endorsed by or affiliated with Facebook, Google, or YouTube in any way.
        Individual results presented here may not be typical. Your background, effort, and execution
        affect outcomes, and nothing here is a guarantee of any specific result.
        Copyright &copy; 2026 Hot Tub Launch &mdash; All Rights Reserved
      </p>
    </div>
  </div>

  <script>
    // Custom GHL calendar — fetches free slots via /api/calendar-slots, books
    // via /api/calendar-book (which creates the GHL appointment and fires the
    // server-deduped Schedule event). No PIT key in the browser.
    (() => {
      const $ = (id: string) => document.getElementById(id) as HTMLElement;
      const shell = $('cal-shell');
      const loadingEl = $('cal-loading');
      const daysEl = $('cal-days');
      const slotsWrap = $('cal-slots-wrap');
      const slotsEl = $('cal-slots');
      const confirmEl = $('cal-confirm');
      const summaryEl = $('confirm-summary');
      const bookBtn = $('cal-book-btn') as HTMLButtonElement;
      const doneEl = $('cal-done');
      const doneText = $('cal-done-text');

      let selectedSlot: string | null = null;
      let slotMap: Record<string, string[]> = {};

      const fmtTime = (iso: string) => {
        const d = new Date(iso);
        return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
      };
      const fmtDateLong = (iso: string) => {
        const d = new Date(iso);
        return d.toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric' });
      };

      async function loadSlots() {
        try {
          const res = await fetch('/api/calendar-slots?timezone=America%2FNew_York&days=7');
          const data = await res.json() as any;
          if (!data.ok || !data.slots) throw new Error(data.error || 'No slots');
          slotMap = data.slots;
          renderDays();
        } catch (e) {
          loadingEl.textContent = 'Could not load available times. Please refresh or call us.';
          loadingEl.classList.add('cal-error');
        }
      }

      function renderDays() {
        loadingEl.hidden = true;
        const dates = Object.keys(slotMap).sort();
        if (!dates.length) {
          loadingEl.hidden = false;
          loadingEl.textContent = 'No availability this week. Check back soon.';
          return;
        }
        daysEl.hidden = false;
        daysEl.innerHTML = '';
        dates.forEach((dateKey, i) => {
          const d = new Date(dateKey + 'T00:00:00');
          const el = document.createElement('div');
          el.className = 'cal-day' + (i === 0 ? ' sel' : '');
          el.innerHTML =
            `<span class="dow">${d.toLocaleDateString([], { weekday: 'short' })}</span>` +
            `<span class="daynum">${d.getDate()}</span>` +
            `<span class="mon">${d.toLocaleDateString([], { month: 'short' })}</span>`;
          el.addEventListener('click', () => {
            daysEl.querySelectorAll('.cal-day').forEach((x) => x.classList.remove('sel'));
            el.classList.add('sel');
            renderSlots(dateKey);
          });
          daysEl.appendChild(el);
        });
        renderSlots(dates[0]);
      }

      function renderSlots(dateKey: string) {
        const slots = slotMap[dateKey] || [];
        slotsWrap.hidden = false;
        slotsEl.innerHTML = '';
        selectedSlot = null;
        confirmEl.hidden = true;
        if (!slots.length) {
          slotsEl.innerHTML = '<div class="cal-loading">No times available this day.</div>';
          return;
        }
        slots.forEach((iso) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cal-slot';
          btn.textContent = fmtTime(iso);
          btn.addEventListener('click', () => {
            slotsEl.querySelectorAll('.cal-slot').forEach((x) => x.classList.remove('sel'));
            btn.classList.add('sel');
            selectedSlot = iso;
            summaryEl.innerHTML = `Your call is set for <strong>${fmtDateLong(iso)}</strong> at <strong>${fmtTime(iso)}</strong>.`;
            confirmEl.hidden = false;
          });
          slotsEl.appendChild(btn);
        });
      }

      async function book() {
        if (!selectedSlot) return;
        bookBtn.disabled = true;
        bookBtn.classList.add('busy');
        bookBtn.textContent = 'Booking…';
        try {
          const res = await fetch('/api/calendar-book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slot: selectedSlot }),
          });
          const data = await res.json() as any;
          if (data.ok) {
            // Fire the browser-side Schedule event for match quality, using
            // the server-minted eventId. Server CAPI already deduped it.
            if (data.schedule && data.schedule.eventId && typeof (window as any).fbq === 'function') {
              (window as any).fbq('track', 'Schedule',
                { value: data.schedule.value, currency: data.schedule.currency },
                { eventID: data.schedule.eventId });
            }
            daysEl.hidden = true;
            slotsWrap.hidden = true;
            confirmEl.hidden = true;
            doneEl.hidden = false;
            if (data.appointment && data.appointment.slot) {
              doneText.textContent = `Your call is confirmed for ${fmtDateLong(data.appointment.slot)} at ${fmtTime(data.appointment.slot)}. A calendar invite is on its way to your inbox.`;
            }
          } else {
            throw new Error(data.error || 'Booking failed');
          }
        } catch (e) {
          bookBtn.disabled = false;
          bookBtn.classList.remove('busy');
          bookBtn.textContent = 'Book My Call';
          alert('Could not book that time. Please pick another or call us.');
        }
      }

      bookBtn.addEventListener('click', book);
      loadSlots();
    })();
  </script>
</Layout>